{
    "version": 3,
    "cmakeMinimumRequired": {
      "major": 3,
      "minor": 22,
      "patch": 0
    },
    "configurePresets": [
      {
        "name": "vs2022x64",
        "hidden": false,
        "generator": "Visual Studio 17 2022",
        "architecture": "x64",
        "binaryDir": "${sourceDir}/Workspace/${presetName}",
        "cacheVariables": {
          "XII_BUILD_VULKAN": "ON",
          "XII_ENABLE_FOLDER_UNITY_FILES" : "ON",
          "XII_COMPILE_ENGINE_AS_DLL" : "ON"
        },
        "environment": {}
      },
      {
        "name": "linux-base",
        "hidden": true,
        "generator": "Ninja",
        "binaryDir": "${sourceDir}/Workspace/${presetName}",
        "cacheVariables": {
          "XII_EXPERIMENTAL_EDITOR_ON_LINUX": "ON",
          "XII_BUILD_VULKAN": "ON",
          "XII_ENABLE_FOLDER_UNITY_FILES" : "ON",
          "XII_COMPILE_ENGINE_AS_DLL" : "ON",
          "CMAKE_EXPORT_COMPILE_COMMANDS" : "ON"
        }
      },
      {
        "name": "linux-clang-base",
        "inherits" : ["linux-base"],
        "hidden": true,
        "cacheVariables": {
          "CMAKE_CXX_COMPILER" : "clang++-19",
          "CMAKE_C_COMPILER" : "clang-19"
        }
      },
      {
        "name": "linux-gcc-base",
        "inherits" : ["linux-base"],
        "hidden": true,
        "cacheVariables": {
          "CMAKE_CXX_COMPILER" : "/usr/bin/g++",
          "CMAKE_C_COMPILER" : "/usr/bin/gcc"
        }
      },

      {
        "name": "linux-clang-debug",
        "inherits" : ["linux-clang-base"],
        "hidden" : false,
        "cacheVariables": {
          "CMAKE_BUILD_TYPE": "Debug"
        }
      },
      {
        "name": "linux-clang-dev",
        "inherits" : ["linux-clang-base"],
        "hidden" : false,
        "cacheVariables": {
          "CMAKE_BUILD_TYPE": "Dev"
        }
      },
      {
        "name": "linux-clang-shipping",
        "inherits" : ["linux-clang-base"],
        "hidden" : false,
        "cacheVariables": {
          "CMAKE_BUILD_TYPE": "Shipping"
        }
      },
      {
        "name": "linux-gcc-debug",
        "inherits" : ["linux-gcc-base"],
        "hidden" : false,
        "cacheVariables": {
          "CMAKE_BUILD_TYPE": "Debug"
        }
      },
      {
        "name": "linux-gcc-dev",
        "inherits" : ["linux-gcc-base"],
        "hidden" : false,
        "cacheVariables": {
          "CMAKE_BUILD_TYPE": "Dev"
        }
      },
      {
        "name": "linux-gcc-shipping",
        "inherits" : ["linux-gcc-base"],
        "hidden" : false,
        "cacheVariables": {
          "CMAKE_BUILD_TYPE": "Shipping"
        }
      }
    ]
  }
