# Native NuGet acquisition follows xii_download_and_extract's archive/marker cache model.
# Archives and validated extractions are shared by every configuration and build directory.
# No package scripts, MSBuild files, NuGet executable, or language runtime are executed.
function(xii_nuget_init)
  if(NOT XII_ROOT)
    message(FATAL_ERROR "xii_nuget_init requires XII_ROOT.")
  endif()
  set(XII_NUGET_ROOT "${XII_ROOT}/Workspace/Nuget" CACHE PATH "Shared versioned NuGet archive and extraction cache")
  set(XII_NUGET_SOURCE "https://api.nuget.org/v3-flatcontainer" CACHE STRING "NuGet v3 flat-container package source")
  option(XII_NUGET_OFFLINE "Use only verified cached NuGet archives" OFF)
  if(NOT IS_ABSOLUTE "${XII_NUGET_ROOT}")
    message(FATAL_ERROR "XII_NUGET_ROOT must be an absolute persistent cache path.")
  endif()
  set(BINARY_ROOT "${CMAKE_BINARY_DIR}")
  cmake_path(IS_PREFIX BINARY_ROOT "${XII_NUGET_ROOT}" NORMALIZE IN_BINARY_TREE)
  if(IN_BINARY_TREE AND NOT CMAKE_SCRIPT_MODE_FILE)
    message(FATAL_ERROR "XII_NUGET_ROOT must be outside CMAKE_BINARY_DIR.")
  endif()
  file(MAKE_DIRECTORY "${XII_NUGET_ROOT}")
endfunction()

function(_xii_nuget_identity PACKAGE VERSION OUT_ID OUT_VERSION)
  string(TOLOWER "${PACKAGE}" ID)
  string(LENGTH "${ID}" ID_LENGTH)
  if(NOT ID MATCHES "^[a-z0-9_][a-z0-9_.-]*$" OR ID MATCHES "[.]$" OR ID_LENGTH GREATER 100)
    message(FATAL_ERROR "Invalid NuGet package ID '${PACKAGE}'.")
  endif()
  # NuGet identity ignores build metadata and normalizes numeric components and casing.
  string(TOLOWER "${VERSION}" NORMAL)
  string(REGEX REPLACE "[+][0-9a-z.-]+$" "" NORMAL "${NORMAL}")
  if(NOT NORMAL MATCHES "^([0-9]+)[.]([0-9]+)([.]([0-9]+))?([.]([0-9]+))?(-[0-9a-z.-]+)?$")
    message(FATAL_ERROR "An explicit NuGet version is required, got '${VERSION}'.")
  endif()
  set(MAJOR "${CMAKE_MATCH_1}")
  set(MINOR "${CMAKE_MATCH_2}")
  set(PATCH "${CMAKE_MATCH_4}")
  set(REVISION "${CMAKE_MATCH_6}")
  set(PRERELEASE "${CMAKE_MATCH_7}")
  foreach(PART IN ITEMS MAJOR MINOR PATCH REVISION)
    string(REGEX REPLACE "^0+" "" ${PART} "${${PART}}")
    if("${${PART}}" STREQUAL "")
      set(${PART} 0)
    endif()
  endforeach()
  set(NORMAL "${MAJOR}.${MINOR}.${PATCH}")
  if(NOT REVISION STREQUAL "0")
    string(APPEND NORMAL ".${REVISION}")
  endif()
  string(APPEND NORMAL "${PRERELEASE}")
  set(${OUT_ID} "${ID}" PARENT_SCOPE)
  set(${OUT_VERSION} "${NORMAL}" PARENT_SCOPE)
endfunction()

function(_xii_nuget_safe_path PATH_VALUE)
  # Also reject Windows device names, alternate streams and ambiguous cross-platform spellings.
  if("${PATH_VALUE}" STREQUAL "" OR PATH_VALUE MATCHES "^[/.]*/$|^/|\\\\|[:;<>|?*\"\r\n\t]" OR PATH_VALUE MATCHES "(^|/)[.][.]?(/|$)|[. ](/|$)|//")
    message(FATAL_ERROR "Unsafe NuGet archive or asset path '${PATH_VALUE}'.")
  endif()
  string(TOLOWER "${PATH_VALUE}" LOWER)
  if(LOWER MATCHES "(^|/)(con|prn|aux|nul|com[1-9]|lpt[1-9])([.]|/|$)")
    message(FATAL_ERROR "Unsafe Windows device path in NuGet package '${PATH_VALUE}'.")
  endif()
endfunction()

function(_xii_nuget_zip_name ARCHIVE OFFSET LENGTH OUT_NAME)
  # Read binary slices as hex. Text-mode file(READ) may translate line endings at slice boundaries.
  file(READ "${ARCHIVE}" HEX_NAME OFFSET ${OFFSET} LIMIT ${LENGTH} HEX)
  set(NAME "")
  math(EXPR LAST "${LENGTH} - 1")
  foreach(INDEX RANGE 0 ${LAST})
    math(EXPR POSITION "${INDEX} * 2")
    string(SUBSTRING "${HEX_NAME}" ${POSITION} 2 BYTE)
    math(EXPR BYTE "0x${BYTE}")
    if(BYTE LESS 32 OR BYTE EQUAL 127)
      message(FATAL_ERROR "Unsafe control character in NuGet ZIP filename.")
    endif()
    string(ASCII ${BYTE} CHARACTER)
    string(APPEND NAME "${CHARACTER}")
  endforeach()
  string(REGEX REPLACE "/$" "" NAME "${NAME}")
  _xii_nuget_safe_path("${NAME}")
  set(${OUT_NAME} "${NAME}" PARENT_SCOPE)
endfunction()

# Inspect raw ZIP names as well as libarchive's listing, which can normalize backslashes.
# ZIP64/multi-volume/encrypted packages require a separate reviewed acquisition adapter.
function(_xii_nuget_zip_paths ARCHIVE)
  file(SIZE "${ARCHIVE}" SIZE)
  if(SIZE LESS 22)
    message(FATAL_ERROR "Invalid NuGet archive: ${ARCHIVE}")
  endif()
  math(EXPR TAIL_OFFSET "${SIZE} - 65557")
  if(TAIL_OFFSET LESS 0)
    set(TAIL_OFFSET 0)
  endif()
  file(READ "${ARCHIVE}" TAIL OFFSET ${TAIL_OFFSET} HEX)
  string(FIND "${TAIL}" "504b0506" END REVERSE)
  if(END LESS 0)
    message(FATAL_ERROR "Invalid NuGet archive ZIP directory: ${ARCHIVE}")
  endif()
  math(EXPR DIRECTORY_FIELD "${END} + 32")
  string(SUBSTRING "${TAIL}" ${DIRECTORY_FIELD} 8 VALUE)
  _xii_nuget_u32("${VALUE}" OFFSET)
  math(EXPR COUNT_FIELD "${END} + 20")
  string(SUBSTRING "${TAIL}" ${COUNT_FIELD} 4 VALUE)
  _xii_nuget_u32("${VALUE}0000" COUNT)
  math(EXPR TRAILER "${TAIL_OFFSET} + ${END} / 2")
  if(OFFSET GREATER_EQUAL TRAILER OR COUNT EQUAL 65535 OR COUNT EQUAL 0)
    message(FATAL_ERROR "Unsupported ZIP64, split, or empty NuGet archive: ${ARCHIVE}")
  endif()
  foreach(INDEX RANGE 1 ${COUNT})
    math(EXPR HEADER_END "${OFFSET} + 46")
    if(HEADER_END GREATER TRAILER)
      message(FATAL_ERROR "Invalid NuGet archive directory bounds: ${ARCHIVE}")
    endif()
    file(READ "${ARCHIVE}" HEADER OFFSET ${OFFSET} LIMIT 46 HEX)
    if(NOT HEADER MATCHES "^504b0102")
      message(FATAL_ERROR "Invalid NuGet archive directory entry: ${ARCHIVE}")
    endif()
    string(SUBSTRING "${HEADER}" 56 4 VALUE)
    _xii_nuget_u32("${VALUE}0000" NAME_LENGTH)
    string(SUBSTRING "${HEADER}" 60 4 VALUE)
    _xii_nuget_u32("${VALUE}0000" EXTRA_LENGTH)
    string(SUBSTRING "${HEADER}" 64 4 VALUE)
    _xii_nuget_u32("${VALUE}0000" COMMENT_LENGTH)
    string(SUBSTRING "${HEADER}" 84 8 VALUE)
    _xii_nuget_u32("${VALUE}" LOCAL_OFFSET)
    math(EXPR NEXT "${HEADER_END} + ${NAME_LENGTH} + ${EXTRA_LENGTH} + ${COMMENT_LENGTH}")
    if(NAME_LENGTH EQUAL 0 OR NEXT GREATER TRAILER)
      message(FATAL_ERROR "Invalid NuGet archive filename bounds: ${ARCHIVE}")
    endif()
    _xii_nuget_zip_name("${ARCHIVE}" ${HEADER_END} ${NAME_LENGTH} NAME)
    math(EXPR LOCAL_END "${LOCAL_OFFSET} + 30")
    if(LOCAL_END GREATER OFFSET)
      message(FATAL_ERROR "Invalid NuGet archive local header: ${ARCHIVE}")
    endif()
    file(READ "${ARCHIVE}" LOCAL_HEADER OFFSET ${LOCAL_OFFSET} LIMIT 30 HEX)
    if(NOT LOCAL_HEADER MATCHES "^504b0304")
      message(FATAL_ERROR "Invalid NuGet archive local signature: ${ARCHIVE}")
    endif()
    string(SUBSTRING "${LOCAL_HEADER}" 52 4 VALUE)
    _xii_nuget_u32("${VALUE}0000" LOCAL_NAME_LENGTH)
    if(NOT LOCAL_NAME_LENGTH EQUAL NAME_LENGTH)
      message(FATAL_ERROR "Ambiguous NuGet archive local filename: ${ARCHIVE}")
    endif()
    _xii_nuget_zip_name("${ARCHIVE}" ${LOCAL_END} ${NAME_LENGTH} LOCAL_NAME)
    if(NOT NAME STREQUAL LOCAL_NAME)
      message(FATAL_ERROR "Ambiguous NuGet archive local filename: ${ARCHIVE}")
    endif()
    set(OFFSET ${NEXT})
  endforeach()
endfunction()

# Read only the explicit native dependency subset. Framework selection, ranges and MSBuild behavior
# require an explicit adapter rather than an implicit or partial NuGet restore.
function(_xii_nuget_metadata DIRECTORY PACKAGE VERSION DEPENDENCIES)
  file(GLOB NUSPECS "${DIRECTORY}/*.nuspec")
  list(LENGTH NUSPECS COUNT)
  if(NOT COUNT EQUAL 1 OR NOT EXISTS "${DIRECTORY}/[Content_Types].xml" OR NOT EXISTS "${DIRECTORY}/_rels/.rels")
    message(FATAL_ERROR "NuGet '${PACKAGE}' requires one root .nuspec and OPC package metadata.")
  endif()
  list(GET NUSPECS 0 NUSPEC)
  file(SIZE "${NUSPEC}" SIZE)
  if(SIZE GREATER 2097152)
    message(FATAL_ERROR "NuGet metadata exceeds 2 MiB: ${NUSPEC}")
  endif()
  file(READ "${NUSPEC}" XML)
  # Comments must not manufacture IDs or dependencies. Reject external-entity mechanisms.
  while(XML MATCHES "<!--")
    string(FIND "${XML}" "<!--" BEGIN)
    string(SUBSTRING "${XML}" ${BEGIN} -1 TAIL)
    string(FIND "${TAIL}" "-->" END)
    if(END LESS 0)
      message(FATAL_ERROR "Unterminated NuGet XML comment: ${NUSPEC}")
    endif()
    string(SUBSTRING "${XML}" 0 ${BEGIN} PREFIX)
    math(EXPR AFTER "${BEGIN} + ${END} + 3")
    string(SUBSTRING "${XML}" ${AFTER} -1 SUFFIX)
    set(XML "${PREFIX}${SUFFIX}")
  endwhile()
  if(XML MATCHES "<!|<frameworkAssemblies|<references|<contentFiles|<frameworkReferences" OR NOT XML MATCHES "<package[ >\r\n]" OR NOT XML MATCHES "</package>[ \t\r\n]*$")
    message(FATAL_ERROR "Unsupported or invalid native NuGet metadata in ${NUSPEC}. Supply a reviewed package adapter for framework/MSBuild behavior.")
  endif()
  foreach(TAG IN ITEMS id version)
    string(REGEX MATCHALL "<${TAG}>[^<>]+</${TAG}>" MATCHES "${XML}")
    list(LENGTH MATCHES COUNT)
    if(NOT COUNT EQUAL 1)
      message(FATAL_ERROR "NuGet metadata must contain one ${TAG}: ${NUSPEC}")
    endif()
    string(REGEX REPLACE "^<${TAG}>|</${TAG}>$" "" META_${TAG} "${MATCHES}")
    string(STRIP "${META_${TAG}}" META_${TAG})
  endforeach()
  _xii_nuget_identity("${META_id}" "${META_version}" META_ID META_VERSION)
  if(NOT META_ID STREQUAL PACKAGE OR NOT META_VERSION STREQUAL VERSION)
    message(FATAL_ERROR "NuGet metadata identity mismatch: expected ${PACKAGE}@${VERSION}, got ${META_ID}@${META_VERSION}.")
  endif()
  string(REGEX MATCH "<dependencies[ >\r\n][^>]*>(.*)</dependencies>" BLOCK "${XML}")
  if(XML MATCHES "<dependencies" AND NOT BLOCK AND NOT XML MATCHES "<dependencies[ \t\r\n]*/>")
    message(FATAL_ERROR "Unsupported NuGet dependency metadata: ${NUSPEC}")
  endif()
  set(BODY "${CMAKE_MATCH_1}")
  if(BLOCK)
    string(REGEX REPLACE "^<dependencies[^>]*>|</dependencies>$" "" BODY "${BLOCK}")
    # Only unconditioned/native groups can be selected without a managed-framework resolver.
    string(REGEX MATCHALL "<group[^>]*>" GROUPS "${BODY}")
    foreach(GROUP IN LISTS GROUPS)
      if(NOT GROUP MATCHES "^<group([ \t\r\n]+targetFramework=\"native\")?[ \t\r\n]*/?>$")
        message(FATAL_ERROR "NuGet framework dependency group '${GROUP}' requires an explicit adapter.")
      endif()
    endforeach()
    string(REGEX REPLACE "</?group[^>]*>" "" BODY "${BODY}")
    string(REGEX MATCHALL "<dependency[ \t\r\n]+[^<>]*/>" ENTRIES "${BODY}")
    foreach(ENTRY IN LISTS ENTRIES)
      string(REGEX MATCH "[ \t\r\n]id=\"([^\"]+)\"" MATCH "${ENTRY}")
      set(DEP_ID "${CMAKE_MATCH_1}")
      string(REGEX MATCH "[ \t\r\n]version=\"([^\"]+)\"" MATCH "${ENTRY}")
      set(DEP_VERSION "${CMAKE_MATCH_1}")
      if(DEP_VERSION MATCHES "^\\[([^,]+)\\]$")
        set(DEP_VERSION "${CMAKE_MATCH_1}")
      endif()
      # A bare NuGet version is a minimum. Choosing exactly that version satisfies the constraint.
      # Ranges/prerelease resolution are deliberately not inferred.
      _xii_nuget_identity("${DEP_ID}" "${DEP_VERSION}" DEP_ID DEP_VERSION)
      set(KEY "${DEP_ID}@${DEP_VERSION}")
      if(NOT KEY IN_LIST DEPENDENCIES)
        message(FATAL_ERROR "NuGet ${PACKAGE}@${VERSION} requires explicitly pinned dependency ${KEY}. Fetch it first and list it in DEPENDENCIES. Version ranges require a reviewed adapter.")
      endif()
      get_property(FETCHED GLOBAL PROPERTY "XII_NUGET_PACKAGE_${KEY}")
      if(NOT FETCHED)
        message(FATAL_ERROR "NuGet dependency ${KEY} must be successfully fetched before ${PACKAGE}.")
      endif()
    endforeach()
    string(REGEX REPLACE "<dependency[ \t\r\n]+[^<>]*/>" "" BODY "${BODY}")
    string(STRIP "${BODY}" BODY)
    if(NOT BODY STREQUAL "")
      message(FATAL_ERROR "Unsupported NuGet dependency metadata in ${NUSPEC}: ${BODY}")
    endif()
  endif()
endfunction()

function(_xii_nuget_manifest DIRECTORY OUT_MANIFEST)
  file(GLOB_RECURSE ENTRIES LIST_DIRECTORIES true RELATIVE "${DIRECTORY}" "${DIRECTORY}/*" "${DIRECTORY}/.*")
  list(SORT ENTRIES)
  set(MANIFEST "")
  foreach(ENTRY IN LISTS ENTRIES)
    _xii_nuget_safe_path("${ENTRY}")
    if(IS_SYMLINK "${DIRECTORY}/${ENTRY}")
      message(FATAL_ERROR "NuGet symbolic links are unsupported: ${ENTRY}")
    endif()
    if(NOT IS_DIRECTORY "${DIRECTORY}/${ENTRY}")
      file(SHA256 "${DIRECTORY}/${ENTRY}" HASH)
      string(APPEND MANIFEST "${HASH} ${ENTRY}\n")
    endif()
  endforeach()
  if(MANIFEST STREQUAL "")
    message(FATAL_ERROR "NuGet extraction is empty: ${DIRECTORY}")
  endif()
  set(${OUT_MANIFEST} "${MANIFEST}" PARENT_SCOPE)
endfunction()

# xii_nuget_validate_package(PACKAGE <id> VERSION <exact> SHA256 <hash>
#   OUT_VALID <variable> [DEPENDENCIES <normalized-id@exact-version>...])
# Cache validation is read-only. Fetch/find serialize validation with the per-version cache lock.
function(xii_nuget_validate_package)
  cmake_parse_arguments(PARSE_ARGV 0 ARG "" "PACKAGE;VERSION;SHA256;OUT_VALID" "DEPENDENCIES")
  _xii_nuget_arguments(ARG PACKAGE VERSION SHA256 OUT_VALID)
  xii_nuget_init()
  _xii_nuget_identity("${ARG_PACKAGE}" "${ARG_VERSION}" ID VERSION)
  set(ROOT "${XII_NUGET_ROOT}/${ID}/${VERSION}")
  set(ARCHIVE "${ROOT}/${ID}.${VERSION}.nupkg")
  set(${ARG_OUT_VALID} FALSE PARENT_SCOPE)
  if(NOT EXISTS "${ARCHIVE}" OR NOT EXISTS "${ROOT}/.extracted" OR NOT IS_DIRECTORY "${ROOT}/Extracted")
    return()
  endif()
  file(SHA256 "${ARCHIVE}" HASH)
  if(NOT HASH STREQUAL ARG_SHA256)
    return()
  endif()
  _xii_nuget_manifest("${ROOT}/Extracted" MANIFEST)
  set(EXPECTED "XII-NUGET-1\n${ID}@${VERSION}\n${HASH}\n${MANIFEST}")
  file(READ "${ROOT}/.extracted" MARKER)
  if(NOT MARKER STREQUAL EXPECTED)
    return()
  endif()
  _xii_nuget_metadata("${ROOT}/Extracted" "${ID}" "${VERSION}" "${ARG_DEPENDENCIES}")
  set(${ARG_OUT_VALID} TRUE PARENT_SCOPE)
endfunction()

function(_xii_nuget_arguments PREFIX)
  if(${PREFIX}_UNPARSED_ARGUMENTS OR ${PREFIX}_KEYWORDS_MISSING_VALUES)
    message(FATAL_ERROR "Invalid NuGet arguments: ${${PREFIX}_UNPARSED_ARGUMENTS} ${${PREFIX}_KEYWORDS_MISSING_VALUES}")
  endif()
  foreach(KEY IN LISTS ARGN)
    if(NOT DEFINED ${PREFIX}_${KEY} OR "${${PREFIX}_${KEY}}" STREQUAL "")
      message(FATAL_ERROR "NuGet requires ${KEY}.")
    endif()
  endforeach()
  if(DEFINED ${PREFIX}_SHA256)
    string(LENGTH "${${PREFIX}_SHA256}" LENGTH)
    if(NOT LENGTH EQUAL 64 OR NOT "${${PREFIX}_SHA256}" MATCHES "^[0-9a-f]+$")
      message(FATAL_ERROR "NuGet SHA256 must be a pinned lowercase 64-digit hash.")
    endif()
  endif()
endfunction()

# xii_nuget_fetch_package(PACKAGE <id> VERSION <exact> SHA256 <hash>
#   OUT_PACKAGE_DIR <variable> [SOURCE <flat-container-url>] [DEPENDENCIES <id@version>...])
function(xii_nuget_fetch_package)
  cmake_parse_arguments(PARSE_ARGV 0 ARG "" "PACKAGE;VERSION;SHA256;OUT_PACKAGE_DIR;SOURCE" "DEPENDENCIES")
  _xii_nuget_arguments(ARG PACKAGE VERSION SHA256 OUT_PACKAGE_DIR)
  xii_nuget_init()
  _xii_nuget_identity("${ARG_PACKAGE}" "${ARG_VERSION}" ID VERSION)
  set(ROOT "${XII_NUGET_ROOT}/${ID}/${VERSION}")
  file(MAKE_DIRECTORY "${ROOT}")
  file(LOCK "${ROOT}/.lock" GUARD FUNCTION TIMEOUT 180 RESULT_VARIABLE LOCK_STATUS)
  if(NOT LOCK_STATUS STREQUAL "0")
    message(FATAL_ERROR "NuGet ${ID}@${VERSION} cache lock failed: ${LOCK_STATUS}")
  endif()
  set(DEPENDENCY_ARGS "")
  if(ARG_DEPENDENCIES)
    set(DEPENDENCY_ARGS DEPENDENCIES ${ARG_DEPENDENCIES})
  endif()
  xii_nuget_validate_package(PACKAGE "${ID}" VERSION "${VERSION}" SHA256 "${ARG_SHA256}" ${DEPENDENCY_ARGS} OUT_VALID VALID)
  if(NOT VALID)
    set(ARCHIVE "${ROOT}/${ID}.${VERSION}.nupkg")
    if(EXISTS "${ARCHIVE}")
      file(SHA256 "${ARCHIVE}" HASH)
      if(NOT HASH STREQUAL ARG_SHA256)
        message(FATAL_ERROR "SHA256 mismatch for cached NuGet archive ${ARCHIVE}. Preserve it for diagnosis or remove it explicitly before fetching again.")
      endif()
    else()
      if(XII_NUGET_OFFLINE)
        message(FATAL_ERROR "NuGet offline cache miss: ${ID}@${VERSION}")
      endif()
      if(ARG_SOURCE)
        set(SOURCE "${ARG_SOURCE}")
      else()
        set(SOURCE "${XII_NUGET_SOURCE}")
      endif()
      if(NOT SOURCE MATCHES "^(https|file)://")
        message(FATAL_ERROR "NuGet SOURCE must be an HTTPS or file flat-container URL.")
      endif()
      set(TEMP "${ARCHIVE}.download")
      file(REMOVE "${TEMP}")
      message(STATUS "Downloading NuGet ${ID}@${VERSION}")
      file(DOWNLOAD "${SOURCE}/${ID}/${VERSION}/${ID}.${VERSION}.nupkg" "${TEMP}"
        TLS_VERIFY ON TIMEOUT 180 INACTIVITY_TIMEOUT 30 STATUS STATUS LOG LOG)
      list(GET STATUS 0 CODE)
      if(NOT CODE EQUAL 0)
        file(REMOVE "${TEMP}")
        message(FATAL_ERROR "NuGet download failed for ${ID}@${VERSION}: ${STATUS}")
      endif()
      file(SHA256 "${TEMP}" HASH)
      if(NOT HASH STREQUAL ARG_SHA256)
        file(REMOVE "${TEMP}")
        message(FATAL_ERROR "SHA256 mismatch for NuGet ${ID}@${VERSION} download.")
      endif()
      file(RENAME "${TEMP}" "${ARCHIVE}")
    endif()
    # Libarchive lists paths and types before extraction. Reject links, duplicate/case-colliding
    # paths, devices, ambiguous Windows paths and traversal before creating any package files.
    _xii_nuget_zip_paths("${ARCHIVE}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar tf "${ARCHIVE}" OUTPUT_VARIABLE NAMES RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR)
    if(NOT STATUS EQUAL 0)
      message(FATAL_ERROR "Invalid NuGet archive ${ARCHIVE}: ${ERROR}")
    endif()
    if(NAMES MATCHES ";|\r")
      message(FATAL_ERROR "Unsafe NuGet archive filename encoding: ${ARCHIVE}")
    endif()
    string(REPLACE "\n" ";" ENTRIES "${NAMES}")
    set(SEEN "")
    foreach(ENTRY IN LISTS ENTRIES)
      if(ENTRY STREQUAL "")
        continue()
      endif()
      string(REGEX REPLACE "/$" "" ENTRY "${ENTRY}")
      _xii_nuget_safe_path("${ENTRY}")
      string(TOLOWER "${ENTRY}" LOWER)
      if(LOWER IN_LIST SEEN)
        message(FATAL_ERROR "Duplicate/case-colliding NuGet archive path '${ENTRY}'.")
      endif()
      list(APPEND SEEN "${LOWER}")
    endforeach()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar tvf "${ARCHIVE}" OUTPUT_VARIABLE TYPES RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR)
    if(NOT STATUS EQUAL 0)
      message(FATAL_ERROR "Invalid NuGet archive ${ARCHIVE}: ${ERROR}")
    endif()
    string(REPLACE "\n" ";" TYPES "${TYPES}")
    foreach(ENTRY IN LISTS TYPES)
      if(NOT ENTRY STREQUAL "" AND NOT ENTRY MATCHES "^[-d][rwxstST-][rwxstST-][rwxstST-][rwxstST-][rwxstST-][rwxstST-][rwxstST-][rwxstST-][rwxstST-] ")
        message(FATAL_ERROR "Unsupported NuGet archive entry (links and special files are forbidden): ${ENTRY}")
      endif()
    endforeach()
    set(STAGING "${ROOT}/.extracting")
    file(REMOVE_RECURSE "${STAGING}")
    file(MAKE_DIRECTORY "${STAGING}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${ARCHIVE}" WORKING_DIRECTORY "${STAGING}" RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR)
    if(NOT STATUS EQUAL 0)
      file(REMOVE_RECURSE "${STAGING}")
      message(FATAL_ERROR "NuGet extraction failed: ${ERROR}")
    endif()
    _xii_nuget_metadata("${STAGING}" "${ID}" "${VERSION}" "${ARG_DEPENDENCIES}")
    _xii_nuget_manifest("${STAGING}" MANIFEST)
    # Incomplete previous extractions never become visible as validated package content.
    file(REMOVE "${ROOT}/.extracted")
    file(REMOVE_RECURSE "${ROOT}/Extracted")
    file(RENAME "${STAGING}" "${ROOT}/Extracted")
    file(WRITE "${ROOT}/.extracted.pending" "XII-NUGET-1\n${ID}@${VERSION}\n${ARG_SHA256}\n${MANIFEST}")
    file(RENAME "${ROOT}/.extracted.pending" "${ROOT}/.extracted")
  endif()
  set_property(GLOBAL PROPERTY "XII_NUGET_PACKAGE_${ID}@${VERSION}" "${ROOT}/Extracted")
  set(${ARG_OUT_PACKAGE_DIR} "${ROOT}/Extracted" PARENT_SCOPE)
endfunction()

# Read-only offline lookup with the same integrity policy as fetch. Returns an empty path on a miss.
function(xii_nuget_find_package)
  cmake_parse_arguments(PARSE_ARGV 0 ARG "" "PACKAGE;VERSION;SHA256;OUT_PACKAGE_DIR" "DEPENDENCIES")
  _xii_nuget_arguments(ARG PACKAGE VERSION SHA256 OUT_PACKAGE_DIR)
  xii_nuget_init()
  _xii_nuget_identity("${ARG_PACKAGE}" "${ARG_VERSION}" ID VERSION)
  set(${ARG_OUT_PACKAGE_DIR} "" PARENT_SCOPE)
  if(NOT IS_DIRECTORY "${XII_NUGET_ROOT}/${ID}/${VERSION}")
    return()
  endif()
  file(LOCK "${XII_NUGET_ROOT}/${ID}/${VERSION}/.lock" GUARD FUNCTION TIMEOUT 180)
  set(DEPENDENCY_ARGS "")
  if(ARG_DEPENDENCIES)
    set(DEPENDENCY_ARGS DEPENDENCIES ${ARG_DEPENDENCIES})
  endif()
  xii_nuget_validate_package(PACKAGE "${ID}" VERSION "${VERSION}" SHA256 "${ARG_SHA256}" ${DEPENDENCY_ARGS} OUT_VALID VALID)
  if(VALID)
    set_property(GLOBAL PROPERTY "XII_NUGET_PACKAGE_${ID}@${VERSION}" "${XII_NUGET_ROOT}/${ID}/${VERSION}/Extracted")
    set(${ARG_OUT_PACKAGE_DIR} "${XII_NUGET_ROOT}/${ID}/${VERSION}/Extracted" PARENT_SCOPE)
  endif()
endfunction()

function(_xii_nuget_asset PACKAGE_DIR RELATIVE OUT_PATH)
  _xii_nuget_safe_path("${RELATIVE}")
  set(PATH_VALUE "${PACKAGE_DIR}/${RELATIVE}")
  if(NOT EXISTS "${PATH_VALUE}" OR IS_SYMLINK "${PATH_VALUE}")
    message(FATAL_ERROR "Missing or linked NuGet asset: ${PATH_VALUE}")
  endif()
  file(REAL_PATH "${PACKAGE_DIR}" ROOT)
  file(REAL_PATH "${PATH_VALUE}" REAL)
  cmake_path(IS_PREFIX ROOT "${REAL}" NORMALIZE INSIDE)
  if(NOT INSIDE)
    message(FATAL_ERROR "NuGet asset escapes its package: ${PATH_VALUE}")
  endif()
  set(${OUT_PATH} "${PATH_VALUE}" PARENT_SCOPE)
endfunction()

# Decode a little-endian 32-bit integer without depending on a native object inspection utility.
function(_xii_nuget_u32 HEX_VALUE OUT_VALUE)
  string(SUBSTRING "${HEX_VALUE}" 0 2 B0)
  string(SUBSTRING "${HEX_VALUE}" 2 2 B1)
  string(SUBSTRING "${HEX_VALUE}" 4 2 B2)
  string(SUBSTRING "${HEX_VALUE}" 6 2 B3)
  math(EXPR VALUE "0x${B3}${B2}${B1}${B0}")
  set(${OUT_VALUE} "${VALUE}" PARENT_SCOPE)
endfunction()

function(_xii_nuget_object_machine FILE_PATH OFFSET OUT_MACHINE)
  file(READ "${FILE_PATH}" HEADER OFFSET ${OFFSET} LIMIT 24 HEX)
  if(HEADER MATCHES "^7f454c46")
    # Native ELF assets are little-endian ELF64 on the supported x64/ARM64 targets.
    if(NOT HEADER MATCHES "^7f454c460201")
      message(FATAL_ERROR "Unsupported ELF class or byte order in ${FILE_PATH}")
    endif()
    string(SUBSTRING "${HEADER}" 36 4 MACHINE)
  elseif(HEADER MATCHES "^cffaedfe")
    string(SUBSTRING "${HEADER}" 8 8 MACHINE)
  elseif(HEADER MATCHES "^0000ffff")
    string(SUBSTRING "${HEADER}" 12 4 MACHINE)
  else()
    string(SUBSTRING "${HEADER}" 0 4 MACHINE)
  endif()
  set(${OUT_MACHINE} "${MACHINE}" PARENT_SCOPE)
endfunction()

function(_xii_nuget_check_machine FILE_PATH ARCH PLATFORM)
  if(PLATFORM STREQUAL "Windows")
    if(ARCH STREQUAL "x64")
      set(EXPECTED 6486)
    else()
      set(EXPECTED 64aa)
    endif()
  elseif(PLATFORM STREQUAL "Linux")
    if(ARCH STREQUAL "x64")
      set(EXPECTED 3e00)
    else()
      set(EXPECTED b700)
    endif()
  elseif(PLATFORM STREQUAL "Darwin")
    if(ARCH STREQUAL "x64")
      set(EXPECTED 07000001)
    else()
      set(EXPECTED 0c000001)
    endif()
  else()
    message(FATAL_ERROR "Unsupported native NuGet platform '${PLATFORM}'.")
  endif()
  file(SIZE "${FILE_PATH}" SIZE)
  if(SIZE LESS 24)
    message(FATAL_ERROR "Invalid native NuGet binary: ${FILE_PATH}")
  endif()
  file(READ "${FILE_PATH}" MAGIC LIMIT 8 HEX)
  if(MAGIC STREQUAL "213c617263683e0a")
    set(OFFSET 8)
    set(COUNT 0)
    while(OFFSET LESS SIZE)
      math(EXPR END "${OFFSET} + 60")
      if(END GREATER SIZE)
        message(FATAL_ERROR "Truncated NuGet library archive: ${FILE_PATH}")
      endif()
      file(READ "${FILE_PATH}" HEADER OFFSET ${OFFSET} LIMIT 60)
      string(SUBSTRING "${HEADER}" 0 16 NAME)
      string(STRIP "${NAME}" NAME)
      string(SUBSTRING "${HEADER}" 48 10 LENGTH)
      string(STRIP "${LENGTH}" LENGTH)
      if(NOT LENGTH MATCHES "^[0-9]+$")
        message(FATAL_ERROR "Invalid NuGet library member size: ${FILE_PATH}")
      endif()
      math(EXPR NEXT "${END} + ${LENGTH} + (${LENGTH} % 2)")
      if(NEXT GREATER SIZE)
        message(FATAL_ERROR "Truncated NuGet library member: ${FILE_PATH}")
      endif()
      if(NAME MATCHES "^#1/([0-9]+)$")
        set(NAME_SIZE "${CMAKE_MATCH_1}")
        file(READ "${FILE_PATH}" NAME OFFSET ${END} LIMIT ${NAME_SIZE})
        math(EXPR END "${END} + ${NAME_SIZE}")
      endif()
      if(NOT NAME MATCHES "^/($|/|SYM64)|^__.SYMDEF")
        _xii_nuget_object_machine("${FILE_PATH}" ${END} MACHINE)
        if(NOT MACHINE STREQUAL EXPECTED)
          message(FATAL_ERROR "NuGet library architecture mismatch: ${FILE_PATH} member ${NAME} (${MACHINE}, expected ${ARCH}/${PLATFORM}).")
        endif()
        math(EXPR COUNT "${COUNT} + 1")
      endif()
      set(OFFSET ${NEXT})
    endwhile()
    if(COUNT EQUAL 0)
      message(FATAL_ERROR "NuGet library has no native objects: ${FILE_PATH}")
    endif()
  else()
    set(OFFSET 0)
    if(PLATFORM STREQUAL "Windows")
      if(NOT MAGIC MATCHES "^4d5a" OR SIZE LESS 64)
        message(FATAL_ERROR "NuGet Windows runtime is not a PE binary: ${FILE_PATH}")
      endif()
      file(READ "${FILE_PATH}" VALUE OFFSET 60 LIMIT 4 HEX)
      _xii_nuget_u32("${VALUE}" OFFSET)
      math(EXPR END "${OFFSET} + 24")
      if(END GREATER SIZE)
        message(FATAL_ERROR "Invalid NuGet PE offset: ${FILE_PATH}")
      endif()
      file(READ "${FILE_PATH}" SIGNATURE OFFSET ${OFFSET} LIMIT 4 HEX)
      if(NOT SIGNATURE STREQUAL "50450000")
        message(FATAL_ERROR "Invalid NuGet PE signature: ${FILE_PATH}")
      endif()
      math(EXPR OFFSET "${OFFSET} + 4")
    endif()
    _xii_nuget_object_machine("${FILE_PATH}" ${OFFSET} MACHINE)
    if(NOT MACHINE STREQUAL EXPECTED)
      message(FATAL_ERROR "NuGet binary architecture mismatch: ${FILE_PATH} (${MACHINE}, expected ${ARCH}/${PLATFORM}).")
    endif()
  endif()
endfunction()

# Explicit asset mappings, relative to a verified package. LOCATION/IMPLIB/SYMBOLS are fallback
# assets for all XII configurations. DEBUG/DEV/SHIPPING_* override them independently.
# ABI declares a C boundary or an exact compiler-family/major C++ boundary. CRT declares the
# package's runtime linkage. C++ Debug assets must be explicitly provided on Windows.
function(xii_nuget_import_native_library)
  cmake_parse_arguments(PARSE_ARGV 0 ARG "" "TARGET;PACKAGE_DIR;TYPE;PLATFORM;ARCHITECTURE;ABI;CRT;COMPILER_VERSION;LOCATION;IMPLIB;DEBUG_LOCATION;DEV_LOCATION;SHIPPING_LOCATION;DEBUG_IMPLIB;DEV_IMPLIB;SHIPPING_IMPLIB" "INCLUDE_DIRS;SYMBOLS;DEBUG_SYMBOLS;DEV_SYMBOLS;SHIPPING_SYMBOLS;LINK_LIBRARIES;COMPILE_DEFINITIONS")
  _xii_nuget_arguments(ARG TARGET PACKAGE_DIR TYPE PLATFORM ARCHITECTURE ABI CRT)
  if(TARGET "${ARG_TARGET}")
    message(FATAL_ERROR "NuGet target already exists: ${ARG_TARGET}")
  endif()
  if(NOT ARG_TYPE MATCHES "^(SHARED|STATIC)$" OR NOT ARG_ARCHITECTURE MATCHES "^(x64|arm64)$" OR
      NOT ARG_ABI MATCHES "^(C|MSVC|GNU|Clang|AppleClang)$" OR NOT ARG_CRT MATCHES "^(NONE|STATIC|DYNAMIC)$")
    message(FATAL_ERROR "Invalid NuGet native target type, architecture, ABI or CRT declaration.")
  endif()
  if(NOT ARG_PLATFORM STREQUAL CMAKE_SYSTEM_NAME)
    message(FATAL_ERROR "NuGet platform mismatch: ${ARG_PLATFORM} package for ${CMAKE_SYSTEM_NAME} target.")
  endif()
  if(COMMAND xii_pull_compiler_and_architecture_vars)
    xii_pull_compiler_and_architecture_vars()
  endif()
  if(CMAKE_GENERATOR_PLATFORM STREQUAL "ARM64" OR XII_CMAKE_ARCHITECTURE_ARM OR CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$")
    set(ARCH arm64)
  elseif(CMAKE_SIZEOF_VOID_P EQUAL 8 AND (CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64|x64)$" OR CMAKE_GENERATOR_PLATFORM STREQUAL "x64"))
    set(ARCH x64)
  else()
    message(FATAL_ERROR "NuGet native target architecture must be x64 or ARM64.")
  endif()
  if(NOT ARCH STREQUAL ARG_ARCHITECTURE)
    message(FATAL_ERROR "NuGet architecture mismatch: ${ARG_ARCHITECTURE} assets for ${ARCH} target.")
  endif()
  if(NOT ARG_ABI STREQUAL "C")
    if(NOT ARG_ABI STREQUAL CMAKE_CXX_COMPILER_ID OR NOT ARG_COMPILER_VERSION)
      message(FATAL_ERROR "NuGet C++ ABI requires a matching compiler and explicit COMPILER_VERSION.")
    endif()
    string(REGEX MATCH "^[0-9]+" PACKAGE_MAJOR "${ARG_COMPILER_VERSION}")
    string(REGEX MATCH "^[0-9]+" COMPILER_MAJOR "${CMAKE_CXX_COMPILER_VERSION}")
    if(NOT PACKAGE_MAJOR STREQUAL COMPILER_MAJOR)
      message(FATAL_ERROR "NuGet C++ compiler major version mismatch.")
    endif()
    if(ARG_PLATFORM STREQUAL "Windows" AND NOT ARG_DEBUG_LOCATION)
      message(FATAL_ERROR "NuGet C++ Windows packages require explicit Debug assets for Debug ABI compatibility.")
    endif()
  endif()
  if(ARG_PLATFORM STREQUAL "Windows" AND (ARG_TYPE STREQUAL "STATIC" OR NOT ARG_ABI STREQUAL "C"))
    if(NOT ARG_CRT MATCHES "^(STATIC|DYNAMIC)$")
      message(FATAL_ERROR "Windows native libraries must declare their CRT linkage.")
    endif()
    if((ARG_CRT STREQUAL "STATIC" AND (NOT CMAKE_MSVC_RUNTIME_LIBRARY OR CMAKE_MSVC_RUNTIME_LIBRARY MATCHES "DLL")) OR
        (ARG_CRT STREQUAL "DYNAMIC" AND CMAKE_MSVC_RUNTIME_LIBRARY AND NOT CMAKE_MSVC_RUNTIME_LIBRARY MATCHES "DLL"))
      message(FATAL_ERROR "NuGet CRT linkage differs from CMAKE_MSVC_RUNTIME_LIBRARY.")
    endif()
  endif()
  get_filename_component(VERSION_DIR "${ARG_PACKAGE_DIR}" DIRECTORY)
  get_filename_component(VERSION "${VERSION_DIR}" NAME)
  get_filename_component(ID_DIR "${VERSION_DIR}" DIRECTORY)
  get_filename_component(ID "${ID_DIR}" NAME)
  get_property(VERIFIED GLOBAL PROPERTY "XII_NUGET_PACKAGE_${ID}@${VERSION}")
  if(NOT VERIFIED STREQUAL ARG_PACKAGE_DIR)
    message(FATAL_ERROR "NuGet native assets must come from a package fetched/found in this configure: ${ARG_PACKAGE_DIR}")
  endif()
  add_library(${ARG_TARGET} ${ARG_TYPE} IMPORTED GLOBAL)
  set_property(TARGET ${ARG_TARGET} PROPERTY XII_NUGET_PACKAGE "${ID}@${VERSION}")
  set_property(TARGET ${ARG_TARGET} PROPERTY INTERFACE_LINK_LIBRARIES "${ARG_LINK_LIBRARIES}")
  set_property(TARGET ${ARG_TARGET} PROPERTY INTERFACE_COMPILE_DEFINITIONS "${ARG_COMPILE_DEFINITIONS}")
  set(INCLUDES "")
  foreach(PATH_VALUE IN LISTS ARG_INCLUDE_DIRS)
    _xii_nuget_asset("${ARG_PACKAGE_DIR}" "${PATH_VALUE}" PATH_VALUE)
    if(NOT IS_DIRECTORY "${PATH_VALUE}")
      message(FATAL_ERROR "NuGet include asset must be a directory: ${PATH_VALUE}")
    endif()
    list(APPEND INCLUDES "${PATH_VALUE}")
  endforeach()
  set_property(TARGET ${ARG_TARGET} PROPERTY INTERFACE_INCLUDE_DIRECTORIES "${INCLUDES}")
  foreach(CONFIG IN ITEMS DEBUG DEV SHIPPING)
    foreach(KIND IN ITEMS LOCATION IMPLIB SYMBOLS)
      set(VALUE "${ARG_${CONFIG}_${KIND}}")
      if(NOT VALUE)
        set(VALUE "${ARG_${KIND}}")
      endif()
      set(ASSETS "")
      foreach(PATH_VALUE IN LISTS VALUE)
        _xii_nuget_asset("${ARG_PACKAGE_DIR}" "${PATH_VALUE}" PATH_VALUE)
        if(IS_DIRECTORY "${PATH_VALUE}")
          message(FATAL_ERROR "NuGet binary asset must be a file: ${PATH_VALUE}")
        endif()
        if(NOT KIND STREQUAL "SYMBOLS")
          _xii_nuget_check_machine("${PATH_VALUE}" "${ARCH}" "${ARG_PLATFORM}")
        endif()
        list(APPEND ASSETS "${PATH_VALUE}")
      endforeach()
      if(KIND STREQUAL "SYMBOLS")
        set_property(TARGET ${ARG_TARGET} PROPERTY XII_NUGET_SYMBOLS_${CONFIG} "${ASSETS}")
      elseif(ASSETS)
        set_property(TARGET ${ARG_TARGET} PROPERTY IMPORTED_${KIND}_${CONFIG} "${ASSETS}")
      elseif(KIND STREQUAL "LOCATION" OR (KIND STREQUAL "IMPLIB" AND ARG_TYPE STREQUAL "SHARED" AND ARG_PLATFORM STREQUAL "Windows"))
        message(FATAL_ERROR "NuGet ${ARG_TARGET} requires ${CONFIG}_${KIND} or fallback ${KIND}.")
      endif()
    endforeach()
  endforeach()
  set_target_properties(${ARG_TARGET} PROPERTIES IMPORTED_CONFIGURATIONS "DEBUG;DEV;SHIPPING"
    MAP_IMPORTED_CONFIG_RELEASE SHIPPING MAP_IMPORTED_CONFIG_RELWITHDEBINFO DEV MAP_IMPORTED_CONFIG_MINSIZEREL SHIPPING
    MAP_IMPORTED_CONFIG_NOCONFIG SHIPPING)
  set_property(GLOBAL APPEND PROPERTY XII_NUGET_TARGETS "${ARG_TARGET}")
endfunction()

function(_xii_nuget_runtime_targets OUT_TARGETS)
  set(QUEUE ${ARGN})
  set(SEEN "")
  set(RESULT "")
  while(QUEUE)
    list(POP_FRONT QUEUE CURRENT)
    string(REGEX REPLACE "^\\$<LINK_ONLY:([^>]+)>$" "\\1" CURRENT "${CURRENT}")
    if(NOT TARGET "${CURRENT}" OR CURRENT IN_LIST SEEN)
      continue()
    endif()
    list(APPEND SEEN "${CURRENT}")
    get_target_property(PACKAGE "${CURRENT}" XII_NUGET_PACKAGE)
    if(PACKAGE)
      list(APPEND RESULT "${CURRENT}")
    endif()
    foreach(PROPERTY IN ITEMS LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
      get_target_property(DEPENDENCIES "${CURRENT}" ${PROPERTY})
      if(DEPENDENCIES)
        list(APPEND QUEUE ${DEPENDENCIES})
      endif()
    endforeach()
  endwhile()
  set(${OUT_TARGETS} "${RESULT}" PARENT_SCOPE)
endfunction()

# Stage the selected configuration's DLLs/shared objects and optional symbols beside the consumer.
# Walk explicit link dependencies, including static wrappers. SDK imports use the same metadata.
function(xii_nuget_stage_runtime)
  cmake_parse_arguments(PARSE_ARGV 0 ARG "" "TARGET" "LIBRARIES")
  _xii_nuget_arguments(ARG TARGET LIBRARIES)
  if(NOT TARGET "${ARG_TARGET}")
    message(FATAL_ERROR "Unknown NuGet runtime consumer ${ARG_TARGET}.")
  endif()
  _xii_nuget_runtime_targets(DEPENDENCIES ${ARG_LIBRARIES})
  foreach(DEPENDENCY IN LISTS DEPENDENCIES)
    get_target_property(STAGED ${ARG_TARGET} XII_NUGET_STAGED)
    if(DEPENDENCY IN_LIST STAGED)
      continue()
    endif()
    set_property(TARGET ${ARG_TARGET} APPEND PROPERTY XII_NUGET_STAGED "${DEPENDENCY}")
    get_target_property(TYPE ${DEPENDENCY} TYPE)
    if(TYPE STREQUAL "SHARED_LIBRARY")
      add_custom_command(TARGET ${ARG_TARGET} POST_BUILD
        COMMAND "${CMAKE_COMMAND}" -E copy_if_different "$<TARGET_FILE:${DEPENDENCY}>" "$<TARGET_FILE_DIR:${ARG_TARGET}>" VERBATIM)
    endif()
    foreach(CONFIG IN ITEMS DEBUG DEV SHIPPING)
      get_target_property(SYMBOLS ${DEPENDENCY} XII_NUGET_SYMBOLS_${CONFIG})
      foreach(SYMBOL IN LISTS SYMBOLS)
        if(SYMBOLS)
          add_custom_command(TARGET ${ARG_TARGET} POST_BUILD
            COMMAND "${CMAKE_COMMAND}" -E "$<IF:$<CONFIG:${CONFIG}>,copy_if_different,true>"
              "${SYMBOL}" "$<TARGET_FILE_DIR:${ARG_TARGET}>" VERBATIM)
        endif()
      endforeach()
    endforeach()
  endforeach()
endfunction()

# Produce a relocatable SDK import file and copy only declared native assets beside it.
# INSTALL_DESTINATION optionally installs that self-contained export directory as an SDK component.
function(xii_nuget_export_targets)
  cmake_parse_arguments(PARSE_ARGV 0 ARG "" "FILE;INSTALL_DESTINATION" "TARGETS")
  _xii_nuget_arguments(ARG FILE TARGETS)
  get_filename_component(EXPORT_DIR "${ARG_FILE}" DIRECTORY)
  file(MAKE_DIRECTORY "${EXPORT_DIR}")
  set(CONTENT "# Generated XII native NuGet targets. Paths are relative to this SDK file.\n")
  foreach(TARGET_NAME IN LISTS ARG_TARGETS)
    get_target_property(PACKAGE ${TARGET_NAME} XII_NUGET_PACKAGE)
    get_target_property(TYPE ${TARGET_NAME} TYPE)
    if(NOT PACKAGE OR NOT TYPE MATCHES "^(SHARED|STATIC)_LIBRARY$")
      message(FATAL_ERROR "Cannot export non-NuGet target ${TARGET_NAME}.")
    endif()
    string(REPLACE "::" "_" FOLDER "${TARGET_NAME}")
    if(NOT FOLDER MATCHES "^[a-zA-Z0-9_.-]+$")
      message(FATAL_ERROR "Unsupported NuGet target name ${TARGET_NAME}.")
    endif()
    set(RELATIVE "Nuget/${PACKAGE}/${FOLDER}")
    string(REPLACE "@" "/" RELATIVE "${RELATIVE}")
    string(REGEX REPLACE "_LIBRARY$" "" TYPE "${TYPE}")
    string(APPEND CONTENT "if(NOT TARGET ${TARGET_NAME})\n  add_library(${TARGET_NAME} ${TYPE} IMPORTED GLOBAL)\n  set_target_properties(${TARGET_NAME} PROPERTIES\n    XII_NUGET_PACKAGE [==[${PACKAGE}]==]\n    IMPORTED_CONFIGURATIONS [==[DEBUG;DEV;SHIPPING]==]\n    MAP_IMPORTED_CONFIG_RELEASE SHIPPING\n    MAP_IMPORTED_CONFIG_RELWITHDEBINFO DEV\n    MAP_IMPORTED_CONFIG_MINSIZEREL SHIPPING\n    MAP_IMPORTED_CONFIG_NOCONFIG SHIPPING\n")
    foreach(PROPERTY IN ITEMS INTERFACE_LINK_LIBRARIES INTERFACE_COMPILE_DEFINITIONS)
      get_target_property(VALUE ${TARGET_NAME} ${PROPERTY})
      if(VALUE)
        string(APPEND CONTENT "    ${PROPERTY} [==[${VALUE}]==]\n")
      endif()
    endforeach()
    get_target_property(INCLUDES ${TARGET_NAME} INTERFACE_INCLUDE_DIRECTORIES)
    set(EXPORTED_INCLUDES "")
    set(INDEX 0)
    foreach(INCLUDE IN LISTS INCLUDES)
      if(INCLUDES)
        set(DESTINATION "${RELATIVE}/include/${INDEX}")
        file(MAKE_DIRECTORY "${EXPORT_DIR}/${DESTINATION}")
        file(COPY "${INCLUDE}/" DESTINATION "${EXPORT_DIR}/${DESTINATION}")
        list(APPEND EXPORTED_INCLUDES "\${CMAKE_CURRENT_LIST_DIR}/${DESTINATION}")
        math(EXPR INDEX "${INDEX} + 1")
      endif()
    endforeach()
    string(APPEND CONTENT "    INTERFACE_INCLUDE_DIRECTORIES \"${EXPORTED_INCLUDES}\"\n")
    foreach(CONFIG IN ITEMS DEBUG DEV SHIPPING)
      foreach(PROPERTY IN ITEMS IMPORTED_LOCATION IMPORTED_IMPLIB XII_NUGET_SYMBOLS)
        get_target_property(ASSETS ${TARGET_NAME} ${PROPERTY}_${CONFIG})
        set(EXPORTED "")
        foreach(ASSET IN LISTS ASSETS)
          if(ASSETS)
            get_filename_component(NAME "${ASSET}" NAME)
            set(DESTINATION "${RELATIVE}/${CONFIG}")
            file(MAKE_DIRECTORY "${EXPORT_DIR}/${DESTINATION}")
            file(COPY "${ASSET}" DESTINATION "${EXPORT_DIR}/${DESTINATION}")
            list(APPEND EXPORTED "\${CMAKE_CURRENT_LIST_DIR}/${DESTINATION}/${NAME}")
          endif()
        endforeach()
        if(EXPORTED)
          string(APPEND CONTENT "    ${PROPERTY}_${CONFIG} \"${EXPORTED}\"\n")
        endif()
      endforeach()
    endforeach()
    string(APPEND CONTENT "  )\nendif()\n")
  endforeach()
  file(WRITE "${ARG_FILE}.pending" "${CONTENT}")
  file(RENAME "${ARG_FILE}.pending" "${ARG_FILE}")
  if(ARG_INSTALL_DESTINATION)
    install(DIRECTORY "${EXPORT_DIR}/Nuget" DESTINATION "${ARG_INSTALL_DESTINATION}")
    install(FILES "${ARG_FILE}" DESTINATION "${ARG_INSTALL_DESTINATION}")
  endif()
endfunction()
