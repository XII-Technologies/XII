{
  "version": "0.2.1",
  "defaults": {},
  "environments": [
    {
      "ANDROID_NDK_HOME": "PATH_TO_ANDROID_NDK_HOME_HERE",
      "ANDROID_HOME": "PATH_TO_ANDROID_HOME_HERE",
      "JAVA_HOME": "PATH_TO_JAVA_HOME_HERE"
    }
  ],
  "configurations": [
    {
      "type": "cppdbg",
      "name": "> FoundationTest",
      "project": "CMakeLists.txt",
      "projectTarget": "libFoundationTest.so (Source\\UnitTests\\FoundationTest\\libFoundationTest.so)",
      "cwd": "${workspaceRoot}",
      "MIMode": "gdb",
      "program": "debugtemp/app_process32",
      "externalConsole": true,
      "inheritEnvironments": [
        "gcc_arm"
      ],
      "miDebuggerPath": "${workspaceRoot}\\Data\\Tools\\Precompiled\\GdbProxy.exe",
      "setupCommands": [
        {
          "text": "shell powershell -ExecutionPolicy Bypass -NoLogo -NoProfile -File \"${workspaceRoot}\\Utilities\\DbgAndroid.ps1\" -PrepareOnly -PackageName \"com.xiiengine.FoundationTest\" -detectArch \"${cmake.name}\" -originalSoDir \"${cmake.buildRoot}\\Source\\UnitTests\\FoundationTest\" -debugTemp \"${workspaceRoot}\\debugtemp\" -apk \"${cmake.buildRoot}\\Source\\UnitTests\\FoundationTest\\FoundationTest.apk\" -MessageBoxOnError",
          "ignoreFailures": false
        },
        {
          "text": "source ${workspaceRoot}\\debugtemp\\gdb.setup"
        }
      ],
      "customLaunchSetupCommands": [],
      "visualizerFile": "${debugInfo.linuxNatvisPath}",
      "showDisplayString": true,
      "miDebuggerServerAddress": "localhost:5039",
      "launchCompleteCommand": "None",
      "filterStderr": true,
      "filterStdout": true
    },
    {
      "type": "cppdbg",
      "name": "> FoundationTest (Don't deploy)",
      "project": "CMakeLists.txt",
      "projectTarget": "libFoundationTest.so (Source\\UnitTests\\FoundationTest\\libFoundationTest.so)",
      "cwd": "${workspaceRoot}",
      "MIMode": "gdb",
      "program": "debugtemp/app_process32",
      "externalConsole": true,
      "inheritEnvironments": [
        "gcc_arm"
      ],
      "miDebuggerPath": "${workspaceRoot}\\Data\\Tools\\Precompiled\\GdbProxy.exe",
      "setupCommands": [
        {
          "text": "shell powershell -ExecutionPolicy Bypass -NoLogo -NoProfile -File \"${workspaceRoot}\\Utilities\\DbgAndroid.ps1\" -PrepareOnly -PackageName \"com.xiiengine.FoundationTest\" -detectArch \"${cmake.name}\" -originalSoDir \"${cmake.buildRoot}\\Source\\UnitTests\\FoundationTest\" -debugTemp \"${workspaceRoot}\\debugtemp\" -MessageBoxOnError",
          "ignoreFailures": false
        },
        {
          "text": "source ${workspaceRoot}\\debugtemp\\gdb.setup"
        }
      ],
      "customLaunchSetupCommands": [],
      "visualizerFile": "${debugInfo.linuxNatvisPath}",
      "showDisplayString": true,
      "miDebuggerServerAddress": "localhost:5039",
      "launchCompleteCommand": "None",
      "filterStderr": true,
      "filterStdout": true
    }
  ]
}