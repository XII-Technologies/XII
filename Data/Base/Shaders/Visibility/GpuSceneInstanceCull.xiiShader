// Compact world-derived instances that pass flags, residency, mask and frustum tests.
[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTE_SHADER]

#include "GpuSceneCommon.h"

StructuredBuffer<GpuSceneInstance> g_SceneInstances;
StructuredBuffer<GpuVisibilityView> g_VisibilityView;
StructuredBuffer<GpuGeometryRecord> g_Geometry;
StructuredBuffer<uint4> g_PreviousLodHistory;
StructuredBuffer<uint> g_CandidateInstances;
RWStructuredBuffer<uint4> g_CurrentLodHistory;
RWStructuredBuffer<uint> g_VisibleInstances;
RWStructuredBuffer<uint> g_VisibleInstanceCount;

bool ReserveVisibleInstance(out uint destination)
{
  uint outputCapacity, outputStride;
  uint counterCapacity, counterStride;
  g_VisibleInstances.GetDimensions(outputCapacity, outputStride);
  g_VisibleInstanceCount.GetDimensions(counterCapacity, counterStride);
  if (outputCapacity == 0u || counterCapacity == 0u)
  {
    destination = 0u;
    return false;
  }

  // Saturating reservation keeps both the compact list and its published count valid even
  // when a prior reset was skipped or a future producer accidentally over-subscribes it.
  for (;;)
  {
    const uint currentCount = g_VisibleInstanceCount[0];
    if (currentCount >= outputCapacity)
    {
      destination = 0u;
      return false;
    }

    uint observedCount;
    InterlockedCompareExchange(g_VisibleInstanceCount[0], currentCount, currentCount + 1u, observedCount);
    if (observedCount == currentCount)
    {
      destination = currentCount;
      return true;
    }
  }
}

[numthreads(64, 1, 1)]
void main(uint3 dispatchThreadId : SV_DispatchThreadID)
{
  uint viewCount, viewStride;
  uint sceneCount, sceneStride;
  uint geometryCount, geometryStride;
  g_VisibilityView.GetDimensions(viewCount, viewStride);
  g_SceneInstances.GetDimensions(sceneCount, sceneStride);
  g_Geometry.GetDimensions(geometryCount, geometryStride);
  if (viewCount == 0u)
    return;

  const GpuVisibilityView view = g_VisibilityView[0];
  uint instanceIndex = dispatchThreadId.x;
  if (view.UseCandidates != 0u)
  {
    uint candidateCount, candidateStride;
    g_CandidateInstances.GetDimensions(candidateCount, candidateStride);
    if (instanceIndex >= min(view.CandidateCount, candidateCount)) return;
    instanceIndex = g_CandidateInstances[instanceIndex];
  }
  if (instanceIndex >= min(view.InstanceCount, sceneCount))
    return;

  GpuSceneInstance instance = g_SceneInstances[instanceIndex];
  if (instance.GeometryIndex == 0xFFFFFFFFu)
    return;

  if (view.GeometryBaseIndex >= geometryCount || instance.GeometryIndex >= geometryCount - view.GeometryBaseIndex)
    return;

  const GpuGeometryRecord geometry = g_Geometry[view.GeometryBaseIndex + instance.GeometryIndex];
  // Update history before flags, frustum and Hi-Z tests. Material routing must never
  // leave section candidates of one mesh with different temporal LOD decisions.
  uint selectionIndex = instanceIndex;
  if (instance.LodSelectionIndex < min(view.InstanceCount, sceneCount) && g_SceneInstances[instance.LodSelectionIndex].GeometryIndex == instance.GeometryIndex)
    selectionIndex = instance.LodSelectionIndex;
  const GpuSceneInstance selection = g_SceneInstances[selectionIndex];
  uint previousCapacity, previousStride, currentCapacity, currentStride;
  g_PreviousLodHistory.GetDimensions(previousCapacity, previousStride);
  g_CurrentLodHistory.GetDimensions(currentCapacity, currentStride);
  const uint4 previousHistory = selectionIndex < previousCapacity ? g_PreviousLodHistory[selectionIndex] : uint4(0xFFFFFFFFu, 0xFFFFFFFFu, 0xFFFFFFFFu, 0xFFFFFFFFu);
  const float distanceToCamera = view.LodParameters.w != 0.0f ? 1.0f : length(selection.BoundsCenterRadius.xyz - view.CameraPosition.xyz);
  const uint lod = SelectInstanceResidentLod(geometry, selection, distanceToCamera, view.ViewportAndHiZ.y,
                                             previousHistory, (uint)view.LodParameters.z, view.LodParameters.x);
  if (instanceIndex < currentCapacity)
    g_CurrentLodHistory[instanceIndex] = uint4(lod, geometry.Generation, selection.ObjectId, (uint)view.LodParameters.y);
  if ((instance.Flags & view.RequiredFlags) != view.RequiredFlags || (instance.Flags & view.ExcludedFlags) != 0u || (instance.VisibilityMask & view.VisibilityMask) == 0u)
    return;
  if (geometry.ResidentLodMask == 0u || !SphereInsideFrustum(instance.BoundsCenterRadius.xyz, instance.BoundsCenterRadius.w, view))
    return;

  uint destination;
  if (ReserveVisibleInstance(destination))
    g_VisibleInstances[destination] = instanceIndex;
}
