// Final stage: translate compact meshlet work into DrawMeshIndirect-compatible commands.
[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTE_SHADER]

struct MeshDispatchIndirectArguments
{
  uint ThreadGroupCountX;
  uint ThreadGroupCountY;
  uint ThreadGroupCountZ;
};

StructuredBuffer<uint2> g_VisibleMeshlets;
Buffer<uint> g_VisibleMeshletCount;
RWStructuredBuffer<MeshDispatchIndirectArguments> g_IndirectCommands;
RWBuffer<uint> g_IndirectCommandCount;

[numthreads(64, 1, 1)]
void main(uint3 dispatchThreadId : SV_DispatchThreadID)
{
  const uint count = g_VisibleMeshletCount[0];
  uint commandCapacity, commandStride;
  g_IndirectCommands.GetDimensions(commandCapacity, commandStride);
  if (dispatchThreadId.x >= min(count, commandCapacity))
    return;

  // One mesh workgroup consumes one compacted (instance, meshlet) entry. The mesh shader uses
  // SV_DrawID to fetch the pair from g_VisibleMeshlets.
  MeshDispatchIndirectArguments command;
  command.ThreadGroupCountX = 1u;
  command.ThreadGroupCountY = 1u;
  command.ThreadGroupCountZ = 1u;
  g_IndirectCommands[dispatchThreadId.x] = command;
  if (dispatchThreadId.x == 0u)
    g_IndirectCommandCount[0] = min(count, commandCapacity);
}
