[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTE_SHADER]

#include "GpuSceneCommon.h"

StructuredBuffer<GpuSceneInstance> g_SceneInstances;
StructuredBuffer<GpuVisibilityView> g_VisibilityView;
StructuredBuffer<uint> g_CandidateInstances;
StructuredBuffer<uint> g_CandidateCount;
Texture2D<float> g_HiZ;
RWStructuredBuffer<uint> g_VisibleInstances;
RWStructuredBuffer<uint> g_VisibleInstanceCount;

// Returns false when a bound crosses the projection plane. Such objects stay visible because a
// finite screen-space rectangle cannot conservatively represent them. World-space AABB corners
// avoid the under-estimated rectangles produced by projecting a sphere radius with one matrix
// coefficient under wide FOVs and asymmetric projections.
bool ProjectBounds(GpuSceneInstance instance, GpuVisibilityView view, out float4 screenRect, out float nearestDepth)
{
  float2 minimumUV = float2(1.0f, 1.0f);
  float2 maximumUV = float2(0.0f, 0.0f);
  nearestDepth = 0.0f;

  [unroll]
  for (uint cornerIndex = 0u; cornerIndex < 8u; ++cornerIndex)
  {
    const float3 cornerSign = float3((cornerIndex & 1u) != 0u ? 1.0f : -1.0f,
                                     (cornerIndex & 2u) != 0u ? 1.0f : -1.0f,
                                     (cornerIndex & 4u) != 0u ? 1.0f : -1.0f);
    const float3 corner = instance.BoundsCenterRadius.xyz + instance.BoundsExtents.xyz * cornerSign;
    const float4 clip = mul(view.ViewProjectionMatrix, float4(corner, 1.0f));
    if (clip.w <= 0.0001f)
    {
      screenRect = float4(0.0f, 0.0f, 1.0f, 1.0f);
      return false;
    }

    const float3 ndc = clip.xyz / clip.w;
    const float2 uv = ndc.xy * float2(0.5f, -0.5f) + 0.5f;
    minimumUV = min(minimumUV, uv);
    maximumUV = max(maximumUV, uv);
    // Reversed-Z maps nearer geometry to larger device depth.
    nearestDepth = max(nearestDepth, saturate(ndc.z));
  }

  screenRect = saturate(float4(minimumUV, maximumUV));
  return true;
}

bool ReserveVisibleInstance(out uint destination)
{
  uint outputCapacity, outputStride;
  uint counterCapacity, counterStride;
  g_VisibleInstances.GetDimensions(outputCapacity, outputStride);
  g_VisibleInstanceCount.GetDimensions(counterCapacity, counterStride);
  if (outputCapacity == 0u || counterCapacity == 0u)
  {
    destination = 0u;
    return false;
  }

  // Never publish a count larger than the compact list. The count directly controls the
  // subsequent indirect meshlet dispatch and therefore must remain valid under contention.
  for (;;)
  {
    const uint currentCount = g_VisibleInstanceCount[0];
    if (currentCount >= outputCapacity)
    {
      destination = 0u;
      return false;
    }

    uint observedCount;
    InterlockedCompareExchange(g_VisibleInstanceCount[0], currentCount, currentCount + 1u, observedCount);
    if (observedCount == currentCount)
    {
      destination = currentCount;
      return true;
    }
  }
}

[numthreads(64, 1, 1)]
void main(uint3 dispatchThreadId : SV_DispatchThreadID)
{
  uint candidateCapacity, candidateStride;
  uint candidateCountCapacity, candidateCountStride;
  uint sceneCapacity, sceneStride;
  uint viewCapacity, viewStride;
  g_CandidateInstances.GetDimensions(candidateCapacity, candidateStride);
  g_CandidateCount.GetDimensions(candidateCountCapacity, candidateCountStride);
  g_SceneInstances.GetDimensions(sceneCapacity, sceneStride);
  g_VisibilityView.GetDimensions(viewCapacity, viewStride);
  if (candidateCountCapacity == 0u || viewCapacity == 0u)
    return;

  const uint candidateCount = min(g_CandidateCount[0], candidateCapacity);
  if (dispatchThreadId.x >= candidateCount)
    return;

  const uint instanceIndex = g_CandidateInstances[dispatchThreadId.x];
  if (instanceIndex >= sceneCapacity)
    return;

  const GpuSceneInstance instance = g_SceneInstances[instanceIndex];
  const GpuVisibilityView view = g_VisibilityView[0];

  float4 rect;
  float nearestDepth;
  bool visible = true;
  if (ProjectBounds(instance, view, rect, nearestDepth))
  {
    uint width, height, levels;
    g_HiZ.GetDimensions(0, width, height, levels);
    const float2 footprint = (rect.zw - rect.xy) * float2(width, height);
    const uint mip = min((uint)max(0.0f, floor(log2(max(max(footprint.x, footprint.y), 1.0f)))), max(levels, 1u) - 1u);

    uint mipWidth, mipHeight, ignoredLevels;
    g_HiZ.GetDimensions(mip, mipWidth, mipHeight, ignoredLevels);
    const int2 maximumPixel = int2(max(mipWidth, 1u) - 1u, max(mipHeight, 1u) - 1u);
    const int2 p0 = clamp(int2(rect.xy * float2(mipWidth, mipHeight)), int2(0, 0), maximumPixel);
    const int2 p1 = clamp(int2(rect.zw * float2(mipWidth, mipHeight)), int2(0, 0), maximumPixel);
    const float occluderDepth = min(min(g_HiZ.Load(int3(p0, mip)), g_HiZ.Load(int3(p1.x, p0.y, mip))),
                                    min(g_HiZ.Load(int3(p0.x, p1.y, mip)), g_HiZ.Load(int3(p1, mip))));
    visible = nearestDepth >= occluderDepth - view.ViewportAndHiZ.w;
  }

  if (visible)
  {
    uint destination;
    if (ReserveVisibleInstance(destination))
      g_VisibleInstances[destination] = instanceIndex;
  }
}
