// XII Engine - AtmosphereMultiScatter.xiiShader  [NEW]
// Pass 25b: Precompute multiple-scattering approximation LUT (32 × 32 × RGBA16F).
// Method: Hillaire 2020 - single 2D LUT approximating higher-order scattering.
// Dispatch: ceil(32/8) × ceil(32/8) × 1

[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTE_SHADER]

#include <Shaders/Common/Common.h>
#include <Shaders/Pipeline/Passes/Atmosphere/AtmosphereConstants.h>

Texture2D<float4>   g_TransmittanceLUT;
RWTexture2D<float4> g_MultiScatterLUT;

float RayleighPhase(float cosTheta) { return (3.0f / (16.0f * 3.14159265f)) * (1.0f + cosTheta * cosTheta); }
float MiePhase(float cosTheta, float g)
{
    float g2 = g * g;
    return (3.0f / (8.0f * 3.14159265f)) * ((1.0f - g2) * (1.0f + cosTheta * cosTheta))
         / ((2.0f + g2) * pow(1.0f + g2 - 2.0f * g * cosTheta, 1.5f));
}

float RayleighDensity(float h) { return exp(-h / PlanetAtmosphereRadiiScaleHeights.z); }
float MieDensity(float h)      { return exp(-h / PlanetAtmosphereRadiiScaleHeights.w); }

[numthreads(8, 8, 1)]
void main(uint3 tid : SV_DispatchThreadID)
{
    uint2 dims; g_MultiScatterLUT.GetDimensions(dims.x, dims.y);
    if (any(tid.xy >= dims)) return;

    float2 uv      = (float2(tid.xy) + 0.5f) / float2(dims);
    float  cosSun  = uv.x * 2.0f - 1.0f;
    float  height  = lerp(PlanetAtmosphereRadiiScaleHeights.x, PlanetAtmosphereRadiiScaleHeights.y, uv.y);
    const uint sqrtSamples = max(SampleCounts.y, 1u);
    float3 sunTransmittance = g_TransmittanceLUT.SampleLevel(LinearClampSampler, float2(uv.y, cosSun * 0.5f + 0.5f), 0).rgb;

    // Integrate sphere of directions - approximation for multiple scatter luminance.
    float3 L2 = float3(0,0,0);
    float  dOmega = 4.0f * 3.14159265f / float(sqrtSamples * sqrtSamples);

    for (uint i = 0u; i < sqrtSamples; ++i)
    for (uint j = 0u; j < sqrtSamples; ++j)
    {
        float theta  = acos(1.0f - 2.0f * (float(i) + 0.5f) / float(sqrtSamples));
        float phi    = 2.0f * 3.14159265f * float(j) / float(sqrtSamples);
        float3 dir   = float3(sin(theta)*cos(phi), cos(theta), sin(theta)*sin(phi));
        float cosT   = dir.y;

        // Sum scatter at this height for this direction.
        float h      = height - PlanetAtmosphereRadiiScaleHeights.x;
        float rho_r  = RayleighDensity(h);
        float rho_m  = MieDensity(h);

        float3 scatter = (RayleighScattering.xyz    * rho_r * RayleighPhase(cosT)
                        + MieScatteringAndPhase.xyz * rho_m * MiePhase(cosT, MieScatteringAndPhase.w));
        L2 += scatter * sunTransmittance * dOmega;
    }

    // Final fms coefficient - used in sky composite to add higher-order scatter.
    float3 fms = L2 / (4.0f * 3.14159265f);
    g_MultiScatterLUT[tid.xy] = float4(fms, 1.0f);
}
