[PLATFORMS]
ALL

[PERMUTATIONS]

CAMERA_MODE = CAMERA_MODE_PERSPECTIVE

[RENDERSTATE]

DepthEnable = false
ComparisonDepthFunction = ComparisonFunction_Less
DepthWriteEnable = false
CullMode = CullMode_None

[VERTEX_SHADER]

#include <Shaders/Pipeline/FullscreenTriangleVertexShader.h>

[PIXEL_SHADER]

#include <Shaders/Pipeline/FullscreenTriangleInterpolator.h>
#include <Shaders/Pipeline/Passes/Output/FinalBlitConstants.h>
#include <Shaders/Common/Common.h>

Texture2D<float4> g_FinalColor;

// Perceptual Quantiser (SMPTE ST 2084 / PQ) transfer function.
float3 LinearToPQ(float3 L)
{
  const float m1  = 0.1593017578125f;
  const float m2  = 78.84375f;
  const float c1  = 0.8359375f;
  const float c2  = 18.8515625f;
  const float c3  = 18.6875f;
  float3      Lm1 = pow(L / 10000.0f, m1);
  return pow((c1 + c2 * Lm1) / (1.0f + c3 * Lm1), m2);
}

float3 LinearToSRGB(float3 color)
{
  color = max(color, 0.0f);
  return select(color < 0.0031308f, color * 12.92f, 1.055f * pow(color, 1.0f / 2.4f) - 0.055f);
}

float4 main(PS_IN input) : SV_Target
{
  float3 color = g_FinalColor.SampleLevel(PointClampSampler, input.TexCoord0, 0).rgb;

  if (OutputMode == 1u)
  {
    // HDR10: convert paper-white-relative linear values to absolute nits,
    // clamp to the calibrated panel peak, then encode ST.2084/PQ.
    float3 hdr10 = min(max(color, 0.0f) * PaperWhiteNits, MaximumDisplayNits);
    return float4(LinearToPQ(hdr10), 1.0f);
  }
  else if (OutputMode == 2u)
  {
    // scRGB defines 1.0 as 80 nits.
    return float4(color * (PaperWhiteNits / 80.0f), 1.0f);
  }
  else
  {
    // sRGB render targets apply the transfer function in hardware. Linear UNORM
    // targets require explicit encoding.
    return float4(ApplySRGBTransfer != 0u ? LinearToSRGB(color) : color, 1.0f);
  }
}
