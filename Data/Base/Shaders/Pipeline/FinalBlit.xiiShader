// XII Engine - FinalBlit.xiiShader  [NEW]
// Pass 65: Copy final colour target to swap-chain back buffer with display colour-space correction.
// Supports sRGB and HDR10/PQ output modes.

#include "PipelineCommon.xiiShader"
#include "FullscreenTriangleVertexShader.h"
#include "FullscreenTriangleInterpolator.h"
#include "Passes/Output/DisplayOutputConstants.h"

Texture2D<float4> g_FinalColor : register(t0);

struct PS_Out { float4 Color : SV_Target0; };

// Perceptual Quantiser (SMPTE ST 2084 / PQ) transfer function.
float3 LinearToPQ(float3 L)
{
    const float m1 = 0.1593017578125f;
    const float m2 = 78.84375f;
    const float c1 = 0.8359375f;
    const float c2 = 18.8515625f;
    const float c3 = 18.6875f;
    float3 Lm1 = pow(L / 10000.0f, m1);
    return pow((c1 + c2 * Lm1) / (1.0f + c3 * Lm1), m2);
}

float3 LinearToSRGB(float3 color)
{
    color = max(color, 0.0f);
    return select(color < 0.0031308f, color * 12.92f, 1.055f * pow(color, 1.0f / 2.4f) - 0.055f);
}

PS_Out PS_FinalBlit(FullscreenInterpolators In)
{
    float3 color = g_FinalColor.SampleLevel(g_sPointClamp, In.TexCoord, 0).rgb;

    PS_Out o;
    if (GET_CONSTANT(xiiFinalBlitConstants, OutputMode) == 1u)
    {
        // HDR10: convert paper-white-relative linear values to absolute nits,
        // clamp to the calibrated panel peak, then encode ST.2084/PQ.
        float3 hdr10 = min(max(color, 0.0f) * GET_CONSTANT(xiiFinalBlitConstants, PaperWhiteNits), GET_CONSTANT(xiiFinalBlitConstants, MaximumDisplayNits));
        o.Color = float4(LinearToPQ(hdr10), 1.0f);
    }
    else if (GET_CONSTANT(xiiFinalBlitConstants, OutputMode) == 2u)
    {
        // scRGB defines 1.0 as 80 nits.
        o.Color = float4(color * (GET_CONSTANT(xiiFinalBlitConstants, PaperWhiteNits) / 80.0f), 1.0f);
    }
    else
    {
        // sRGB render targets apply the transfer function in hardware. Linear UNORM
        // targets require explicit encoding.
        o.Color = float4(GET_CONSTANT(xiiFinalBlitConstants, ApplySRGBTransfer) != 0u ? LinearToSRGB(color) : color, 1.0f);
    }
    return o;
}
