// XII Engine - Initializes froxel scattering from view-aligned density data.

[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTE_SHADER]

#include <Shaders/Pipeline/PipelineCommon.xiiShader>
#include <Shaders/Pipeline/Passes/Volumetrics/VolumetricMediumData.h>

StructuredBuffer<xiiFroxelMediumData> g_FroxelMeta;
RWTexture3D<float4>                  g_FroxelScatterOut;

static const uint3 XII_FROXEL_COUNT = uint3(128u, 72u, 64u);

[numthreads(8, 8, 8)]
void main(uint3 dispatchThreadId : SV_DispatchThreadID)
{
  if (any(dispatchThreadId >= XII_FROXEL_COUNT))
    return;

  const uint linearIndex = (dispatchThreadId.z * XII_FROXEL_COUNT.y + dispatchThreadId.y) * XII_FROXEL_COUNT.x + dispatchThreadId.x;
  const xiiFroxelMediumData metadata = g_FroxelMeta[linearIndex];
  const float3 scattering = max(metadata.ScatteringAndExtinction.rgb, 0.0f);
  const float extinction = max(metadata.ScatteringAndExtinction.a, 0.0f);
  const float3 emission = max(metadata.EmissionAndAnisotropy.rgb, 0.0f);

  g_FroxelScatterOut[dispatchThreadId] = float4(max(g_AmbientLightColor.rgb, 0.0f) * scattering + emission, extinction);
}
