[PLATFORMS]
ALL

[SHADER]

// Cosine-weighted near-field diffuse path gather. Mid/far-field DDGI and sparse-voxel
// radiance remain active independently; alpha marks pixels with a valid traced near-field hit.

#include "PipelineCommon.xiiShader"
#include "Passes/RayTracing/RayTracingMaterialData.h"

struct xiiGlobalIlluminationPayload
{
  float3 Radiance;
  float  Confidence;
  uint   RandomState;
  uint   BounceDepth;
  uint   RayType;
};

static const uint XII_RTGI_RAY_TYPE_PATH       = 0u;
static const uint XII_RTGI_RAY_TYPE_VISIBILITY = 1u;

uint RTGIHash(uint value)
{
  value ^= value >> 16u;
  value *= 0x7FEB352Du;
  value ^= value >> 15u;
  value *= 0x846CA68Bu;
  value ^= value >> 16u;
  return value;
}

float RTGIRandom01(inout uint state)
{
  state = RTGIHash(state);
  return (float)(state & 0x00FFFFFFu) * (1.0f / 16777216.0f);
}

float3 CosineSampleHemisphere(float3 normal, float2 randomSample)
{
  const float phi = 6.28318530718f * randomSample.x;
  const float radius = sqrt(randomSample.y);
  const float z = sqrt(max(0.0f, 1.0f - randomSample.y));
  const float3 helper = abs(normal.z) < 0.999f ? float3(0.0f, 0.0f, 1.0f) : float3(1.0f, 0.0f, 0.0f);
  const float3 tangent = normalize(cross(helper, normal));
  const float3 bitangent = cross(normal, tangent);
  return normalize(tangent * (radius * cos(phi)) + bitangent * (radius * sin(phi)) + normal * z);
}

[RAY_GENERATION_SHADER]

RaytracingAccelerationStructure g_RayTracingScene : register(t4);
Texture2D<float>                 g_SceneDepth      : register(t5);
Texture2D<float2>                g_GBufferNormal   : register(t6);
Texture2D<float4>                g_GBufferAlbedo   : register(t7);
RWTexture2D<float4>              g_RTGIRaw         : register(u8);

[shader("raygeneration")]
void main()
{
  const uint2 pixel      = DispatchRaysIndex().xy;
  const uint2 dimensions = DispatchRaysDimensions().xy;
  const float depth      = g_SceneDepth.Load(int3(pixel, 0));

  float4 result = 0.0f;
  if (depth > 0.0f)
  {
    const float2 uv       = (float2(pixel) + 0.5f) / float2(dimensions);
    const float3 worldPos = ReconstructWorldPos(uv, depth);
    const float3 normal   = DecodeOctNormal(g_GBufferNormal.Load(int3(pixel, 0)));
    const float3 albedo   = max(g_GBufferAlbedo.Load(int3(pixel, 0)).rgb, 0.0f);
    uint randomState = RTGIHash(pixel.x + pixel.y * dimensions.x + g_FrameIndex * 0x9E3779B9u);
    const float2 randomSample = float2(RTGIRandom01(randomState), RTGIRandom01(randomState));

    RayDesc ray;
    ray.Origin    = worldPos + normal * 0.01f;
    ray.Direction = CosineSampleHemisphere(normal, randomSample);
    ray.TMin      = 0.001f;
    ray.TMax      = min(max(g_CameraForwardAndFarPlane.w, 10.0f), 100.0f);

    xiiGlobalIlluminationPayload payload;
    payload.Radiance   = 0.0f;
    payload.Confidence = 0.0f;
    payload.RandomState = randomState;
    payload.BounceDepth = 0u;
    payload.RayType = XII_RTGI_RAY_TYPE_PATH;
    TraceRay(g_RayTracingScene, 0U, 0xFFU, 0U, 1U, 0U, ray, payload);
    result = float4(albedo * max(payload.Radiance, 0.0f), payload.Confidence);
  }

  g_RTGIRaw[pixel] = result;
}

[RAY_MISS_SHADER]

[shader("miss")]
void main(inout xiiGlobalIlluminationPayload payload)
{
  payload.Radiance   = 0.0f;
  payload.Confidence = payload.RayType == XII_RTGI_RAY_TYPE_VISIBILITY ? 1.0f : 0.0f;
}

[RAY_CLOSEST_HIT_SHADER]

RaytracingAccelerationStructure g_RayTracingScene : register(t4);
StructuredBuffer<xiiRayTracingMaterialData> g_RayTracingMaterials : register(t9);
StructuredBuffer<xiiRayTracingGeometryData> g_RayTracingGeometry : register(t10);
ByteAddressBuffer g_RayTracingBuffers[] : register(t11);
Texture2D<float4> g_RayTracingTextures[] : register(t12);

#include <Shaders/Pipeline/SurfaceLighting.h>

StructuredBuffer<xiiGpuLightData> g_Lights;

float TraceRTGIVisibility(float3 worldPosition, float3 worldNormal, float3 direction, float maximumDistance, uint bounceDepth)
{
  if (g_RTGISettings.z == 0u || maximumDistance <= 0.002f)
    return 1.0f;

  RayDesc visibilityRay;
  visibilityRay.Origin = worldPosition + worldNormal * 0.002f;
  visibilityRay.Direction = direction;
  visibilityRay.TMin = 0.001f;
  visibilityRay.TMax = maximumDistance;

  xiiGlobalIlluminationPayload visibilityPayload;
  visibilityPayload.Radiance = 0.0f;
  visibilityPayload.Confidence = 0.0f;
  visibilityPayload.RandomState = 0u;
  visibilityPayload.BounceDepth = bounceDepth;
  visibilityPayload.RayType = XII_RTGI_RAY_TYPE_VISIBILITY;
  TraceRay(g_RayTracingScene, RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH | RAY_FLAG_SKIP_CLOSEST_HIT_SHADER,
           0xFFU, 0U, 1U, 0U, visibilityRay, visibilityPayload);
  return visibilityPayload.Confidence;
}

void SampleRTGILocalEmitter(xiiGpuLightData lightData, float3 worldPosition, inout uint randomState,
                            out float3 samplePosition, out float projectedArea)
{
  const uint lightType = GetLightType(lightData);
  samplePosition = GetRepresentativeLightPosition(lightData, worldPosition);
  projectedArea = 0.0f;

  if (lightType == XII_LIGHT_TYPE_POINT)
  {
    const float3 center = lightData.PositionAndInvRange.xyz;
    const float radius = max(lightData.AttenuationAndSize.y, 0.0f);
    if (radius > 1e-4f)
    {
      const float3 centerToPoint = NormalizeAreaLightDirection(worldPosition - center, float3(0.0f, 0.0f, 1.0f));
      float3 tangent;
      float3 bitangent;
      BuildAreaLightBasis(centerToPoint, tangent, bitangent);
      const float diskRadius = sqrt(RTGIRandom01(randomState)) * radius;
      const float diskAngle = RTGIRandom01(randomState) * 6.28318530718f;
      const float2 diskSample = float2(cos(diskAngle), sin(diskAngle)) * diskRadius;
      const float surfaceHeight = sqrt(max(radius * radius - dot(diskSample, diskSample), 0.0f));
      samplePosition = center + tangent * diskSample.x + bitangent * diskSample.y + centerToPoint * surfaceHeight;
    }
  }
  else if (lightType == XII_LIGHT_TYPE_SPOT)
  {
    const float radius = max(lightData.AttenuationAndSize.y, 0.0f);
    if (radius > 1e-4f)
    {
      const float3 emitterNormal = normalize(lightData.DirectionAndType.xyz);
      const float3 right = normalize(lightData.OrientationRightAndIES.xyz);
      const float3 up = normalize(cross(right, emitterNormal));
      const float diskRadius = sqrt(RTGIRandom01(randomState)) * radius;
      const float diskAngle = RTGIRandom01(randomState) * 6.28318530718f;
      samplePosition = lightData.PositionAndInvRange.xyz + right * (diskRadius * cos(diskAngle)) + up * (diskRadius * sin(diskAngle));
    }
  }
  else if (lightType == XII_LIGHT_TYPE_RECTANGLE)
  {
    const float3 emitterNormal = normalize(lightData.DirectionAndType.xyz);
    const float3 right = normalize(lightData.OrientationRightAndIES.xyz);
    const float3 up = normalize(cross(right, emitterNormal));
    const float width = max(lightData.SpotAnglesAndRectSize.z, 1e-4f);
    const float height = max(lightData.SpotAnglesAndRectSize.w, 1e-4f);
    const float2 sampleUV = float2(RTGIRandom01(randomState), RTGIRandom01(randomState)) - 0.5f;
    samplePosition = lightData.PositionAndInvRange.xyz + right * (sampleUV.x * width) + up * (sampleUV.y * height);
    projectedArea = width * height * saturate(dot(emitterNormal, normalize(worldPosition - samplePosition)));
  }
  else if (lightType == XII_LIGHT_TYPE_DISC)
  {
    const float3 emitterNormal = normalize(lightData.DirectionAndType.xyz);
    const float3 right = normalize(lightData.OrientationRightAndIES.xyz);
    const float3 up = normalize(cross(right, emitterNormal));
    const float radius = max(lightData.AttenuationAndSize.y, 1e-4f);
    const float diskRadius = sqrt(RTGIRandom01(randomState)) * radius;
    const float diskAngle = RTGIRandom01(randomState) * 6.28318530718f;
    samplePosition = lightData.PositionAndInvRange.xyz + right * (diskRadius * cos(diskAngle)) + up * (diskRadius * sin(diskAngle));
    projectedArea = 3.14159265f * radius * radius * saturate(dot(emitterNormal, normalize(worldPosition - samplePosition)));
  }
  else if (lightType == XII_LIGHT_TYPE_SPHERE)
  {
    const float3 center = lightData.PositionAndInvRange.xyz;
    const float radius = max(lightData.AttenuationAndSize.y, 1e-4f);
    const float3 centerToPoint = NormalizeAreaLightDirection(worldPosition - center, float3(0.0f, 0.0f, 1.0f));
    float3 tangent;
    float3 bitangent;
    BuildAreaLightBasis(centerToPoint, tangent, bitangent);
    const float diskRadius = sqrt(RTGIRandom01(randomState)) * radius;
    const float diskAngle = RTGIRandom01(randomState) * 6.28318530718f;
    const float2 diskSample = float2(cos(diskAngle), sin(diskAngle)) * diskRadius;
    const float surfaceHeight = sqrt(max(radius * radius - dot(diskSample, diskSample), 0.0f));
    samplePosition = center + tangent * diskSample.x + bitangent * diskSample.y + centerToPoint * surfaceHeight;
    projectedArea = 3.14159265f * radius * radius;
  }
  else if (lightType == XII_LIGHT_TYPE_TUBE)
  {
    const float3 center = lightData.PositionAndInvRange.xyz;
    const float3 axis = normalize(lightData.DirectionAndType.xyz);
    const float radius = max(lightData.AttenuationAndSize.y, 1e-4f);
    const float length = max(lightData.AttenuationAndSize.z, 1e-4f);
    const float3 centerToPoint = NormalizeAreaLightDirection(worldPosition - center, float3(0.0f, 0.0f, 1.0f));
    const float axisCosine = dot(centerToPoint, axis);
    const float sideOn = sqrt(saturate(1.0f - axisCosine * axisCosine));
    float3 radialToPoint = centerToPoint - axis * axisCosine;
    if (dot(radialToPoint, radialToPoint) < 1e-6f)
    {
      float3 unused;
      BuildAreaLightBasis(axis, radialToPoint, unused);
    }
    else
    {
      radialToPoint = normalize(radialToPoint);
    }

    const float sideArea = 2.0f * radius * length * sideOn;
    const float capArea = 3.14159265f * radius * radius;
    projectedArea = sideArea + capArea;
    if (RTGIRandom01(randomState) * projectedArea < sideArea)
    {
      const float axialOffset = (RTGIRandom01(randomState) - 0.5f) * length;
      samplePosition = center + axis * axialOffset + radialToPoint * radius;
    }
    else
    {
      const float endSign = axisCosine >= 0.0f ? 1.0f : -1.0f;
      samplePosition = center + axis * (endSign * length * 0.5f) + centerToPoint * radius;
    }
  }
}

[shader("closesthit")]
void main(inout xiiGlobalIlluminationPayload payload, in BuiltInTriangleIntersectionAttributes attributes)
{
  const xiiRayTracingMaterialData material = g_RayTracingMaterials[InstanceIndex()];
  const xiiRayTracingGeometryData geometry = g_RayTracingGeometry[InstanceIndex()];
  const uint vertexBufferIndex = NonUniformResourceIndex(geometry.BufferIndices.x);
  uint3 indices = PrimitiveIndex() * 3U + uint3(0U, 1U, 2U);
  if (geometry.BufferIndices.z != 0U)
  {
    const uint indexBufferIndex = NonUniformResourceIndex(geometry.BufferIndices.y);
    indices.x = xiiLoadRayTracingIndex(g_RayTracingBuffers[indexBufferIndex], indices.x, geometry.BufferIndices.z);
    indices.y = xiiLoadRayTracingIndex(g_RayTracingBuffers[indexBufferIndex], indices.y, geometry.BufferIndices.z);
    indices.z = xiiLoadRayTracingIndex(g_RayTracingBuffers[indexBufferIndex], indices.z, geometry.BufferIndices.z);
  }

  const float3 position0 = xiiLoadRayTracingPosition(g_RayTracingBuffers[vertexBufferIndex], geometry, indices.x);
  const float3 position1 = xiiLoadRayTracingPosition(g_RayTracingBuffers[vertexBufferIndex], geometry, indices.y);
  const float3 position2 = xiiLoadRayTracingPosition(g_RayTracingBuffers[vertexBufferIndex], geometry, indices.z);
  const float3 barycentrics = float3(1.0f - attributes.barycentrics.x - attributes.barycentrics.y, attributes.barycentrics.x, attributes.barycentrics.y);
  float3 objectNormal = normalize(cross(position1 - position0, position2 - position0));
  if (geometry.VertexLayout.z != 0xFFFFFFFFU)
  {
    objectNormal = normalize(
      xiiLoadRayTracingNormal(g_RayTracingBuffers[vertexBufferIndex], geometry, indices.x) * barycentrics.x +
      xiiLoadRayTracingNormal(g_RayTracingBuffers[vertexBufferIndex], geometry, indices.y) * barycentrics.y +
      xiiLoadRayTracingNormal(g_RayTracingBuffers[vertexBufferIndex], geometry, indices.z) * barycentrics.z);
  }
  float3 worldNormal = normalize(mul(objectNormal, (float3x3)WorldToObject3x4()));

  const bool hasTexCoord = geometry.VertexLayout.w != 0xFFFFFFFFU && geometry.VertexAttributes.z != 0U;
  float2 texCoord = 0.0f;
  if (hasTexCoord)
  {
    texCoord =
      xiiLoadRayTracingTexCoord(g_RayTracingBuffers[vertexBufferIndex], geometry, indices.x) * barycentrics.x +
      xiiLoadRayTracingTexCoord(g_RayTracingBuffers[vertexBufferIndex], geometry, indices.y) * barycentrics.y +
      xiiLoadRayTracingTexCoord(g_RayTracingBuffers[vertexBufferIndex], geometry, indices.z) * barycentrics.z;
  }

  if (hasTexCoord && geometry.VertexAttributes.x != 0xFFFFFFFFU && geometry.VertexAttributes.y != 0U && material.TextureIndices0.y != 0xFFFFFFFFU)
  {
    const float4 objectTangent =
      xiiLoadRayTracingTangent(g_RayTracingBuffers[vertexBufferIndex], geometry, indices.x) * barycentrics.x +
      xiiLoadRayTracingTangent(g_RayTracingBuffers[vertexBufferIndex], geometry, indices.y) * barycentrics.y +
      xiiLoadRayTracingTangent(g_RayTracingBuffers[vertexBufferIndex], geometry, indices.z) * barycentrics.z;
    float3 worldTangent = normalize(mul((float3x3)ObjectToWorld3x4(), objectTangent.xyz));
    worldTangent = normalize(worldTangent - worldNormal * dot(worldTangent, worldNormal));
    const float3 worldBitangent = cross(worldNormal, worldTangent) * (objectTangent.w < 0.0f ? -1.0f : 1.0f);
    const uint normalTextureIndex = NonUniformResourceIndex(material.TextureIndices0.y);
    const float3 tangentNormal = xiiDecodeRayTracingNormal(g_RayTracingTextures[normalTextureIndex].SampleLevel(g_sAnisotropicWrap, texCoord, 0.0f), material.LayerParameters.y);
    worldNormal = normalize(worldTangent * tangentNormal.x + worldBitangent * tangentNormal.y + worldNormal * tangentNormal.z);
  }
  if (dot(worldNormal, WorldRayDirection()) > 0.0f)
    worldNormal = -worldNormal;

  float3 baseColor = max(material.BaseColorOpacity.rgb, 0.0f);
  float3 emissive  = max(material.EmissiveColorAndRoughness.rgb, 0.0f);
  float  roughness = saturate(material.EmissiveColorAndRoughness.w);
  float  metallic  = saturate(material.SurfaceParameters.x);
  float  transmission = saturate(material.SurfaceParameters.z);
  float  clearCoat = saturate(material.LayerParameters.z);
  float  clearCoatRoughness = saturate(material.LayerParameters.w);
  float  occlusion = 1.0f;
  if (hasTexCoord && material.TextureIndices0.x != 0xFFFFFFFFU)
    baseColor *= max(g_RayTracingTextures[NonUniformResourceIndex(material.TextureIndices0.x)].SampleLevel(g_sAnisotropicWrap, texCoord, 0.0f).rgb, 0.0f);
  if (hasTexCoord && material.TextureIndices0.z != 0xFFFFFFFFU)
  {
    const float4 metallicRoughness = g_RayTracingTextures[NonUniformResourceIndex(material.TextureIndices0.z)].SampleLevel(g_sAnisotropicWrap, texCoord, 0.0f);
    roughness *= metallicRoughness.g;
    metallic *= metallicRoughness.b;
  }
  if (hasTexCoord && material.TextureIndices0.w != 0xFFFFFFFFU)
  {
    const float sampledOcclusion = g_RayTracingTextures[NonUniformResourceIndex(material.TextureIndices0.w)].SampleLevel(g_sAnisotropicWrap, texCoord, 0.0f).r;
    occlusion = lerp(1.0f, sampledOcclusion, saturate(material.SurfaceParameters.w));
  }
  if (hasTexCoord && material.TextureIndices1.x != 0xFFFFFFFFU)
    emissive *= max(g_RayTracingTextures[NonUniformResourceIndex(material.TextureIndices1.x)].SampleLevel(g_sAnisotropicWrap, texCoord, 0.0f).rgb, 0.0f);
  if (hasTexCoord && material.TextureIndices1.z != 0xFFFFFFFFU)
  {
    const float2 coatSample = g_RayTracingTextures[NonUniformResourceIndex(material.TextureIndices1.z)].SampleLevel(g_sAnisotropicWrap, texCoord, 0.0f).rg;
    clearCoat *= coatSample.r;
    clearCoatRoughness *= coatSample.g;
  }
  if (hasTexCoord && material.TextureIndices1.w != 0xFFFFFFFFU)
    transmission *= saturate(g_RayTracingTextures[NonUniformResourceIndex(material.TextureIndices1.w)].SampleLevel(g_sAnisotropicWrap, texCoord, 0.0f).r);

  roughness = max(roughness, 0.01f);
  clearCoatRoughness = max(clearCoatRoughness, 0.01f);
  const float dielectricSpecular = saturate(material.SurfaceParameters.y);
  const float3 viewDirection = normalize(-WorldRayDirection());
  const float3 hitPosition = WorldRayOrigin() + WorldRayDirection() * RayTCurrent();
  const float3 diffuseReflectance = baseColor * (1.0f - metallic) * (1.0f - transmission);
  float3 surfaceRadiance = max(g_AmbientLightColor.rgb, 0.0f) * diffuseReflectance * occlusion * 0.31830989f;

  // Infinite emitters form a deterministic prefix and are inexpensive enough
  // to evaluate exactly at every off-screen secondary hit.
  const uint directionalLightCount = min((uint)(g_MainLightColor.w + 0.5f), g_ActiveLightCount);
  [loop]
  for (uint directionalIndex = 0u; directionalIndex < directionalLightCount; ++directionalIndex)
  {
    const xiiGpuLightData lightData = g_Lights[directionalIndex];
    if (GetLightType(lightData) != XII_LIGHT_TYPE_DIRECTIONAL)
      break;

    const float3 directionToLight = normalize(-lightData.DirectionAndType.xyz);
    const float3 radiance = max(lightData.ColorAndIntensity.rgb * lightData.ColorAndIntensity.w, 0.0f);
    const float visibility = lightData.ShadowData.x > 0.5f ?
      TraceRTGIVisibility(hitPosition, worldNormal, directionToLight, max(g_CameraForwardAndFarPlane.w, 10.0f), payload.BounceDepth) : 1.0f;
    surfaceRadiance += BRDFLayered(baseColor, roughness, metallic, dielectricSpecular, transmission, clearCoat,
                                   clearCoatRoughness, worldNormal, directionToLight, viewDirection) * radiance * visibility;
  }

  // Secondary hits have no screen cluster. Stratifying the complete local-light
  // index domain produces an unbiased bounded-cost estimator that covers point,
  // spot, rectangle, disc, sphere, and tube emitters without an O(light count) loop.
  const uint localLightCount = g_ActiveLightCount - directionalLightCount;
  const uint localSampleCount = min(max(g_RTGISettings.y, 1u), localLightCount);
  if (localSampleCount > 0u)
  {
    const float sampleWeight = (float)localLightCount / (float)localSampleCount;
    [loop]
    for (uint sampleIndex = 0u; sampleIndex < localSampleCount; ++sampleIndex)
    {
      const float stratifiedSample = ((float)sampleIndex + RTGIRandom01(payload.RandomState)) / (float)localSampleCount;
      const uint lightIndex = directionalLightCount + min((uint)(stratifiedSample * (float)localLightCount), localLightCount - 1u);
      const xiiGpuLightData lightData = g_Lights[lightIndex];
      const uint lightType = GetLightType(lightData);
      if (lightType >= XII_LIGHT_TYPE_POINT && lightType <= XII_LIGHT_TYPE_TUBE)
      {
        float3 emitterPosition;
        float projectedArea;
        SampleRTGILocalEmitter(lightData, hitPosition, payload.RandomState, emitterPosition, projectedArea);
        const float3 toEmitter = emitterPosition - hitPosition;
        const float distanceToEmitter = length(toEmitter);
        const float3 directionToEmitter = distanceToEmitter > 1e-4f ? toEmitter / distanceToEmitter : worldNormal;
        const float visibility = dot(worldNormal, directionToEmitter) <= 0.0f ? 0.0f :
          (lightData.ShadowData.x > 0.5f ?
             TraceRTGIVisibility(hitPosition, worldNormal, directionToEmitter, max(distanceToEmitter - 0.004f, 0.001f), payload.BounceDepth) : 1.0f);

        xiiGpuLightData sampledLightData = lightData;
        if (lightType == XII_LIGHT_TYPE_POINT || lightType == XII_LIGHT_TYPE_SPOT)
          sampledLightData.PositionAndInvRange.xyz = emitterPosition;

        const float3 contribution = lightType >= XII_LIGHT_TYPE_RECTANGLE ?
          EvaluateAreaLightSample(lightData, emitterPosition, projectedArea, hitPosition, worldNormal, viewDirection, baseColor,
                                  roughness, metallic, dielectricSpecular, transmission, clearCoat, clearCoatRoughness) :
          EvaluateLocalLightLayered(sampledLightData, hitPosition, worldNormal, viewDirection, baseColor, roughness, metallic,
                                    dielectricSpecular, transmission, clearCoat, clearCoatRoughness);
        surfaceRadiance += contribution * visibility * sampleWeight;
      }
    }
  }

  float3 continuedBounce = 0.0f;
  const uint maxPathHits = clamp(g_RTGISettings.x, 1u, 2u);
  if (payload.BounceDepth + 1u < maxPathHits && metallic < 0.999f)
  {
    uint childRandomState = payload.RandomState;
    const float2 childRandomSample = float2(RTGIRandom01(childRandomState), RTGIRandom01(childRandomState));
    const float3 childDirection = CosineSampleHemisphere(worldNormal, childRandomSample);

    RayDesc childRay;
    childRay.Origin = hitPosition + worldNormal * 0.002f;
    childRay.Direction = childDirection;
    childRay.TMin = 0.001f;
    childRay.TMax = min(max(g_CameraForwardAndFarPlane.w, 10.0f), 100.0f);

    xiiGlobalIlluminationPayload childPayload;
    childPayload.Radiance = 0.0f;
    childPayload.Confidence = 0.0f;
    childPayload.RandomState = childRandomState;
    childPayload.BounceDepth = payload.BounceDepth + 1u;
    childPayload.RayType = XII_RTGI_RAY_TYPE_PATH;
    TraceRay(g_RayTracingScene, 0U, 0xFFU, 0U, 1U, 0U, childRay, childPayload);

    // Cosine-weighted sampling cancels the Lambertian cosine/PDF terms, so
    // only diffuse reflectance and material occlusion scale incoming radiance.
    continuedBounce = diffuseReflectance * occlusion * max(childPayload.Radiance, 0.0f);
    payload.RandomState = childPayload.RandomState;
  }

  payload.Radiance   = emissive + surfaceRadiance + continuedBounce;
  payload.Confidence = 1.0f;
}

[RAY_ANY_HIT_SHADER]

StructuredBuffer<xiiRayTracingMaterialData> g_RayTracingMaterials : register(t9);
StructuredBuffer<xiiRayTracingGeometryData> g_RayTracingGeometry : register(t10);
ByteAddressBuffer g_RayTracingBuffers[] : register(t11);
Texture2D<float4> g_RayTracingTextures[] : register(t12);

#include "Passes/RayTracing/RayTracingAlphaTest.h"

[shader("anyhit")]
void main(inout xiiGlobalIlluminationPayload payload, in BuiltInTriangleIntersectionAttributes attributes)
{
  if (xiiShouldIgnoreRayTracingHit(InstanceIndex(), PrimitiveIndex(), attributes.barycentrics))
    IgnoreHit();
}
