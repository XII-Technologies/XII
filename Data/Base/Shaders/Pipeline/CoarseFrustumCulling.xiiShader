// XII Engine - CoarseFrustumCulling.xiiShader  [REWRITTEN]
// Pass 9: Per-instance sphere test against 6 camera frustum planes.
// Dispatch: ceil(InstanceCount/64) × 1 × 1

#include "PipelineCommon.xiiShader"

cbuffer FrustumPlanes : register(b3)
{
    float4 g_Planes[6]; // xyz=normal, w=negDistance
};

struct InstanceBounds { float3 Center; float Radius; float3 Extents; float _pad; };

StructuredBuffer<InstanceBounds> g_Bounds      : register(t0);
StructuredBuffer<uint>           g_LODMetadata : register(t1);
RWStructuredBuffer<uint>         g_VisibleOut  : register(u0); // [0]=count, [1..]=indices

groupshared uint gs_Count;
groupshared uint gs_Scratch[64];

[numthreads(64, 1, 1)]
void CS_CoarseFrustumCull(uint3 tid : SV_DispatchThreadID, uint3 gtid : SV_GroupThreadID)
{
    if (gtid.x == 0u) gs_Count = 0u;
    GroupMemoryBarrierWithGroupSync();

    uint iIdx = tid.x;
    bool visible = (iIdx < 65536u);
    if (visible)
    {
        InstanceBounds b = g_Bounds[iIdx];
        [unroll(6)]
        for (int p = 0; p < 6; ++p)
            if (dot(g_Planes[p].xyz, b.Center) + g_Planes[p].w < -b.Radius)
            { visible = false; break; }
    }

    if (visible)
    {
        uint slot; InterlockedAdd(gs_Count, 1u, slot);
        gs_Scratch[slot] = iIdx;
    }
    GroupMemoryBarrierWithGroupSync();

    if (gtid.x == 0u && gs_Count > 0u)
    {
        uint base; InterlockedAdd(g_VisibleOut[0], gs_Count, base);
        for (uint i = 0u; i < gs_Count; ++i)
            g_VisibleOut[base + 1u + i] = gs_Scratch[i];
    }
}
