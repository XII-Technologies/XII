// Compacts extracted mesh bounds that overlap the current view frustum.
[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTE_SHADER]

#include <Shaders/Pipeline/Passes/Visibility/FrustumCullingConstants.h>

struct InstanceBounds
{
  float4 CenterRadius;
  float4 Extents;
};

StructuredBuffer<InstanceBounds> g_Bounds;
RWStructuredBuffer<uint> g_VisibleOut; // [0] = count, [1..] = compact instance indices.

bool IsOutsidePlane(float4 plane, float3 center, float radius)
{
  // XII frustum normals point out of the volume. Positive distance beyond the radius is outside.
  return dot(plane.xyz, center) + plane.w > radius;
}

[numthreads(64, 1, 1)]
void main(uint3 dispatchThreadId : SV_DispatchThreadID)
{
  const uint instanceIndex = dispatchThreadId.x;
  if (instanceIndex >= InstanceCount)
    return;

  const InstanceBounds bounds = g_Bounds[instanceIndex];
  const float3 center = bounds.CenterRadius.xyz;
  const float radius = bounds.CenterRadius.w;
  if (IsOutsidePlane(FrustumPlane0, center, radius) ||
      IsOutsidePlane(FrustumPlane1, center, radius) ||
      IsOutsidePlane(FrustumPlane2, center, radius) ||
      IsOutsidePlane(FrustumPlane3, center, radius) ||
      IsOutsidePlane(FrustumPlane4, center, radius) ||
      IsOutsidePlane(FrustumPlane5, center, radius))
    return;

  uint destination;
  InterlockedAdd(g_VisibleOut[0], 1u, destination);
  g_VisibleOut[destination + 1u] = instanceIndex;
}
