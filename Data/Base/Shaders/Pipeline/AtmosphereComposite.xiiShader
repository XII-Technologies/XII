// XII Engine - AtmosphereComposite.xiiShader  [NEW]
// Pass 50: Apply sky radiance to HDRI scene - Bruneton atmosphere at sky pixels, aerial perspective on geometry.
// Dispatch: ceil(W/8) × ceil(H/8) × 1

#include "PipelineCommon.xiiShader"
#include <Shaders/Pipeline/Passes/Atmosphere/AtmosphereConstants.h>

Texture2D<float>  g_SceneDepth     : register(t0);
Texture2D<float4> g_Transmittance  : register(t1); // precomputed LUT
Texture2D<float4> g_MultiScatter   : register(t2); // 32×32 fms LUT
RWTexture2D<float4> g_DirectLight  : register(u0); // additive write into direct lighting buffer

// Sample the transmittance LUT for a given camera height and sun zenith.
float3 SampleTransmittance(float heightKm, float cosZenith)
{
    float2 uv = float2(
        saturate((heightKm - PlanetAtmosphereRadiiScaleHeights.x) / (PlanetAtmosphereRadiiScaleHeights.y - PlanetAtmosphereRadiiScaleHeights.x)),
        saturate(cosZenith * 0.5f + 0.5f));
    return g_Transmittance.SampleLevel(g_sLinearClamp, uv, 0).rgb;
}

// Rayleigh phase.
float RayleighPhase(float cosTheta) { return (3.0f / (16.0f * 3.14159265f)) * (1.0f + cosTheta * cosTheta); }

float MiePhase(float cosTheta, float g)
{
    float g2 = g * g;
    return (3.0f / (8.0f * 3.14159265f)) * ((1.0f - g2) * (1.0f + cosTheta * cosTheta))
         / max((2.0f + g2) * pow(max(1.0f + g2 - 2.0f * g * cosTheta, 1e-4f), 1.5f), 1e-4f);
}

float DistanceToAtmosphereExit(float heightKm, float cosViewZenith)
{
    float radius = PlanetAtmosphereRadiiScaleHeights.y;
    float b = heightKm * cosViewZenith;
    float c = heightKm * heightKm - radius * radius;
    return max(-b + sqrt(max(b * b - c, 0.0f)), 0.0f);
}

[numthreads(8, 8, 1)]
void CS_AtmosphereComposite(uint3 tid : SV_DispatchThreadID)
{
    uint2 dims; g_DirectLight.GetDimensions(dims.x, dims.y);
    if (any(tid.xy >= dims)) return;

    float2 uv    = (float2(tid.xy) + 0.5f) / float2(dims);
    float  depth = g_SceneDepth.SampleLevel(g_sPointClamp, uv, 0);

    // Only render sky for background pixels (depth == 0 in reversed-Z far plane).
    if (depth > 0.0f) return;

    float3 V = normalize(ReconstructWorldPos(uv, 0.001f) - g_CameraPositionAndNearPlane.xyz);
    float3 sunDirection = normalize(-g_MainLightDirectionAndIntensity.xyz);
    float cosTheta = dot(V, sunDirection);

    float3 planetUp = normalize(PlanetUpAndGroundAltitudeMeters.xyz);
    float cameraAltitudeMeters = dot(g_CameraPositionAndNearPlane.xyz, planetUp) - PlanetUpAndGroundAltitudeMeters.w;
    float cameraHeightKm = PlanetAtmosphereRadiiScaleHeights.x + max(cameraAltitudeMeters / 1000.0f, 0.0f);
    float cosViewZenith  = dot(V, planetUp);
    float cosSunZenith   = dot(sunDirection, planetUp);

    float altitudeKm = max(cameraHeightKm - PlanetAtmosphereRadiiScaleHeights.x, 0.0f);
    float rayleighDensity = exp(-altitudeKm / PlanetAtmosphereRadiiScaleHeights.z);
    float mieDensity = exp(-altitudeKm / PlanetAtmosphereRadiiScaleHeights.w);
    float3 scattering = RayleighScattering.xyz * rayleighDensity * RayleighPhase(cosTheta)
                      + MieScatteringAndPhase.xyz * mieDensity * MiePhase(cosTheta, MieScatteringAndPhase.w);

    float3 viewTransmittance = SampleTransmittance(cameraHeightKm, cosViewZenith);
    float3 sunTransmittance  = SampleTransmittance(cameraHeightKm, cosSunZenith);
    float pathLengthKm = DistanceToAtmosphereExit(cameraHeightKm, cosViewZenith);
    float3 solarIlluminance = max(g_MainLightColor.rgb * g_MainLightDirectionAndIntensity.w, 0.0f);
    float3 sky = solarIlluminance * scattering * pathLengthKm * viewTransmittance * sunTransmittance;

    // A uniform emitter disc converts authored illuminance (lux) to radiance.
    float sourceRadius = saturate(g_DirectionalShadowSourceRadius);
    if (sourceRadius > 1e-5f && cosTheta > sqrt(max(1.0f - sourceRadius * sourceRadius, 0.0f)))
    {
        float projectedSolidAngle = 3.14159265f * sourceRadius * sourceRadius;
        sky += solarIlluminance * viewTransmittance / max(projectedSolidAngle, 1e-6f);
    }

    // Sample multi-scatter LUT for approximate higher-order scatter.
    float2 msUV   = float2(saturate(cosSunZenith * 0.5f + 0.5f),
                           saturate((cameraHeightKm - PlanetAtmosphereRadiiScaleHeights.x) / (PlanetAtmosphereRadiiScaleHeights.y - PlanetAtmosphereRadiiScaleHeights.x)));
    float3 ms     = g_MultiScatter.SampleLevel(g_sLinearClamp, msUV, 0).rgb;
    sky          += ms * solarIlluminance * pathLengthKm * viewTransmittance;

    float4 existing = g_DirectLight[tid.xy];
    g_DirectLight[tid.xy] = float4(existing.rgb + sky, 1.0f);
}
