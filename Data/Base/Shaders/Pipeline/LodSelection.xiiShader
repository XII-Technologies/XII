// Resolves extracted mesh LOD metadata for the compact visible packet list.
[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTE_SHADER]

#include <Shaders/Pipeline/Passes/Visibility/LODSelectionConstants.h>

StructuredBuffer<uint> g_VisibleCandidates; // [0] = count, [1..] = packet indices.
StructuredBuffer<uint> g_PreferredLOD;       // Packed LOD and extraction flags per packet.
RWStructuredBuffer<uint> g_InstanceLODOut;

[numthreads(64, 1, 1)]
void main(uint3 dispatchThreadId : SV_DispatchThreadID)
{
  const uint visibleIndex = dispatchThreadId.x;
  const uint visibleCount = min(g_VisibleCandidates[0], InstanceCount);
  if (visibleIndex >= visibleCount)
    return;

  const uint instanceIndex = g_VisibleCandidates[visibleIndex + 1u];
  if (instanceIndex >= InstanceCount)
    return;

  g_InstanceLODOut[instanceIndex] = g_PreferredLOD[instanceIndex];
}
