[PLATFORMS]
ALL

[COMPUTE_SHADER]

#include <Shaders/Common/StorageImageFormat.h>

// Soft-knee extraction, normalized reduction, and energy-preserving multiscale reconstruction.

#include <Shaders/Common/Common.h>
#include <Shaders/Pipeline/Passes/Output/BloomConstants.h>

Texture2D<float4>   g_HDRIn;
Texture2D<float4>   g_LowBloom;
XII_STORAGE_IMAGE_FORMAT("rgba16f") RWTexture2D<float4> g_BloomOut;

float3 ExtractBloom(float3 color)
{
  const float luminance = max(GetLuminance(color), 0.0f);
  const float threshold = BloomParameters.x;
  const float knee = BloomParameters.y;
  const float soft = clamp(luminance - threshold + knee, 0.0f, 2.0f * knee);
  const float softContribution = soft * soft / max(4.0f * knee, 1.0e-5f);
  const float contribution = max(luminance - threshold, softContribution) / max(luminance, 1.0e-5f);
  return max(color, 0.0f) * contribution;
}

float3 ReadBloom(float2 uv)
{
  const float3 color = g_HDRIn.SampleLevel(LinearClampSampler, uv, 0).rgb;
  return BloomParameters.w < 0.5f ? ExtractBloom(all(isfinite(color)) ? max(color, 0) : 0) : max(color, 0);
}

[numthreads(8, 8, 1)]
void main(uint3 tid : SV_DispatchThreadID)
{
  uint2 dimensions;
  g_BloomOut.GetDimensions(dimensions.x, dimensions.y);
  if (any(tid.xy >= dimensions))
    return;
  const float2 uv = (float2(tid.xy) + 0.5f) / float2(dimensions);
  uint2 sourceSize;
  g_HDRIn.GetDimensions(sourceSize.x, sourceSize.y);
  const float2 texel = BloomParameters.z / float2(sourceSize);
  float3 bloom = 0;
  [unroll] for (int y = -1; y <= 1; ++y)
    [unroll] for (int x = -1; x <= 1; ++x)
  {
    const float weight = (x == 0 ? 2.0f : 1.0f) * (y == 0 ? 2.0f : 1.0f) / 16.0f;
    bloom += ReadBloom(uv + float2(x, y) * texel) * weight;
  }
  // A convex combination preserves a uniform field across level counts instead
  // of amplifying its energy each time another scale is available.
  if (BloomParameters.w > 1.5f)
    bloom = lerp(bloom, max(g_LowBloom.SampleLevel(LinearClampSampler, uv, 0).rgb, 0), 0.5f);
  g_BloomOut[tid.xy] = float4(all(isfinite(bloom)) ? clamp(bloom, 0, 65504.0f) : 0, 1);
}
