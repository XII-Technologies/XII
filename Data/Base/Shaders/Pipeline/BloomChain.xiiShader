[PLATFORMS]
ALL

[COMPUTE_SHADER]

// Full-resolution soft-knee bloom extraction with a tent filter.

#include <Shaders/Common/Common.h>
#include <Shaders/Pipeline/Passes/Output/BloomConstants.h>

Texture2D<float4>   g_HDRIn;
RWTexture2D<float4> g_BloomOut;

float3 ExtractBloom(float3 color)
{
  const float luminance = max(GetLuminance(color), 0.0f);
  const float threshold = BloomParameters.x;
  const float knee = BloomParameters.y;
  const float soft = clamp(luminance - threshold + knee, 0.0f, 2.0f * knee);
  const float softContribution = soft * soft / max(4.0f * knee, 1.0e-5f);
  const float contribution = max(luminance - threshold, softContribution) / max(luminance, 1.0e-5f);
  return max(color, 0.0f) * contribution;
}

[numthreads(8, 8, 1)]
void main(uint3 dispatchThreadId : SV_DispatchThreadID)
{
  uint2 dimensions;
  g_BloomOut.GetDimensions(dimensions.x, dimensions.y);
  if (any(dispatchThreadId.xy >= dimensions))
    return;

  const float2 uv = (float2(dispatchThreadId.xy) + 0.5f) / float2(dimensions);
  const float2 texel = rcp(float2(dimensions)) * BloomParameters.z;

  float3 bloom = ExtractBloom(g_HDRIn.SampleLevel(LinearClampSampler, uv, 0.0f).rgb) * 0.25f;
  bloom += ExtractBloom(g_HDRIn.SampleLevel(LinearClampSampler, uv + float2(-texel.x, 0.0f), 0.0f).rgb) * 0.125f;
  bloom += ExtractBloom(g_HDRIn.SampleLevel(LinearClampSampler, uv + float2(texel.x, 0.0f), 0.0f).rgb) * 0.125f;
  bloom += ExtractBloom(g_HDRIn.SampleLevel(LinearClampSampler, uv + float2(0.0f, -texel.y), 0.0f).rgb) * 0.125f;
  bloom += ExtractBloom(g_HDRIn.SampleLevel(LinearClampSampler, uv + float2(0.0f, texel.y), 0.0f).rgb) * 0.125f;
  bloom += ExtractBloom(g_HDRIn.SampleLevel(LinearClampSampler, uv + float2(-texel.x, -texel.y), 0.0f).rgb) * 0.0625f;
  bloom += ExtractBloom(g_HDRIn.SampleLevel(LinearClampSampler, uv + float2(texel.x, -texel.y), 0.0f).rgb) * 0.0625f;
  bloom += ExtractBloom(g_HDRIn.SampleLevel(LinearClampSampler, uv + float2(-texel.x, texel.y), 0.0f).rgb) * 0.0625f;
  bloom += ExtractBloom(g_HDRIn.SampleLevel(LinearClampSampler, uv + float2(texel.x, texel.y), 0.0f).rgb) * 0.0625f;

  g_BloomOut[dispatchThreadId.xy] = float4(bloom, 1.0f);
}
