[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTESHADER]

StructuredBuffer<float4>   LocalShadowRequests;
StructuredBuffer<float4>   LocalShadowAllocatorParams;
RWStructuredBuffer<float4> LocalShadowAtlasPlacements;

[numthreads(64, 1, 1)]
void main(uint3 dispatchThreadId : SV_DispatchThreadID)
{
  const uint requestIndex = dispatchThreadId.x;

  if (requestIndex >= LocalShadowRequests.Length || requestIndex >= LocalShadowAtlasPlacements.Length)
  {
    return;
  }

  const float4 requestData = LocalShadowRequests[requestIndex];

  // Deterministic placement seed/rules payload: x = seed, y = atlas tiles per axis, z/w = atlas size.
  const float4 allocatorParams = LocalShadowAllocatorParams.Length > 0 ? LocalShadowAllocatorParams[0] : float4(0.0f, 1.0f, 1024.0f, 1024.0f);
  const uint   atlasTilesPerAxis = max((uint)allocatorParams.y, 1u);

  const uint stableHash = requestIndex * 1664525u + 1013904223u + asuint(allocatorParams.x);
  const uint tileX      = stableHash % atlasTilesPerAxis;
  const uint tileY      = (stableHash / atlasTilesPerAxis) % atlasTilesPerAxis;

  const float invTiles = 1.0f / max((float)atlasTilesPerAxis, 1.0f);
  const float scaleX   = invTiles;
  const float scaleY   = invTiles;
  const float biasX    = (float)tileX * invTiles;
  const float biasY    = (float)tileY * invTiles;

  // xy = atlas scale, zw = atlas bias for the request.
  LocalShadowAtlasPlacements[requestIndex] = float4(scaleX, scaleY, biasX, biasY);

  // Preserve request payload read to avoid being optimized out in minimal scaffolds.
  if (requestData.w < 0.0f)
  {
    LocalShadowAtlasPlacements[requestIndex] = requestData;
  }
}
