// XII Engine - SSGI.xiiShader
// Stage 9: Screen-Space Global Illumination.
// Cosine-weighted hemisphere ray marching using the depth buffer for occlusion
// and the current HDR scene as a one-bounce indirect-radiance source.
// Dispatch: ceil(W/8) × ceil(H/8) × 1.

[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTE_SHADER]

#include <Shaders/Common/Common.h>
#include <Shaders/Pipeline/PipelineCommon.xiiShader>
#include <Shaders/Pipeline/Passes/GlobalIllumination/SSGIConstants.h>

Texture2D<float>    g_SceneDepth;  // reversed-Z depth
Texture2D<float2>   g_GBufNormal;  // oct-encoded normals
Texture2D<float4>   g_GBufAlbedo;  // linear albedo + material AO
Texture2D<float4>   g_GBufMaterial; // roughness, metallic, specular, material ID
Texture2D<float4>   g_HDRScene;    // completed opaque scene before SSGI
RWTexture2D<float4> g_SSGIOut;     // indirect diffuse contribution

// Build an orthonormal basis around the surface normal.
void BuildONB(float3 n, out float3 T, out float3 B)
{
    float3 up = abs(n.z) < 0.999f ? float3(0, 0, 1) : float3(1, 0, 0);
    T = normalize(cross(up, n));
    B = cross(n, T);
}

// Cosine-weighted hemisphere sample.
float3 CosineSampleHemisphere(float2 xi)
{
    float phi    = 2.0f * 3.14159265f * xi.x;
    float cosT   = sqrt(xi.y);
    float sinT   = sqrt(1.0f - xi.y);
    return float3(sinT * cos(phi), sinT * sin(phi), cosT);
}

[numthreads(8, 8, 1)]
void main(uint3 tid : SV_DispatchThreadID)
{
    uint2 dims;
    g_SSGIOut.GetDimensions(dims.x, dims.y);
    if (any(tid.xy >= dims)) return;

    float2 uv = (float2(tid.xy) + 0.5f) / float2(dims);

    // Reconstruct world-space position and normal.
    float  depth = g_SceneDepth.SampleLevel(PointClampSampler, uv, 0);
    if (depth <= 0.0f)
    {
        g_SSGIOut[tid.xy] = 0.0f;
        return;
    }

    float3 worldPos = ReconstructWorldPos(uv, depth);
    float2 octEnc   = g_GBufNormal.SampleLevel(PointClampSampler, uv, 0);
    float3 normal   = DecodeOctNormal(octEnc);
    const float4 albedoAO = g_GBufAlbedo.SampleLevel(PointClampSampler, uv, 0);
    const float metallic = saturate(g_GBufMaterial.SampleLevel(PointClampSampler, uv, 0).g);

    // Build tangent frame.
    float3 T, B;
    BuildONB(normal, T, B);

    float3 incidentRadiance = 0.0f;
    const uint sampleCount = clamp(SampleCount, 1u, 32u);

    [loop]
    for (uint i = 0u; i < sampleCount; ++i)
    {
        // Halton quasi-random with temporal offset.
        float2 xi = float2(
            HaltonSample(i + g_FrameIndex * sampleCount, 2u),
            HaltonSample(i + g_FrameIndex * sampleCount, 3u));

        // Cosine-weighted sample in hemisphere.
        float3 localDir = CosineSampleHemisphere(xi);
        float3 rayDir   = T * localDir.x + B * localDir.y + normal * localDir.z;
        [unroll]
        for (uint stepIndex = 1u; stepIndex <= 6u; ++stepIndex)
        {
            const float traceDistance = RayLength * ((float)stepIndex / 6.0f);
            const float3 samplePos = worldPos + rayDir * traceDistance;
            float4 sampleClip = mul(g_ViewProjectionMatrix, float4(samplePos, 1.0f));
            if (sampleClip.w <= 0.0f)
                break;

            sampleClip.xyz /= sampleClip.w;
            float2 sampleUV = sampleClip.xy * float2(0.5f, -0.5f) + 0.5f;
            if (any(sampleUV < 0.0f) || any(sampleUV > 1.0f))
                break;

            const float hitDepth = g_SceneDepth.SampleLevel(LinearClampSampler, sampleUV, 0);
            if (hitDepth <= 0.0f)
                continue;

            const float hitLinear = LinearizeDepth(hitDepth);
            const float rayLinear = LinearizeDepth(saturate(sampleClip.z));
            if (hitLinear <= rayLinear && rayLinear - hitLinear <= Thickness)
            {
                incidentRadiance += max(g_HDRScene.SampleLevel(LinearClampSampler, sampleUV, 0).rgb, 0.0f);
                break;
            }
        }
    }

    // Cosine-weighted sampling already accounts for the Lambertian cosine/PDF
    // ratio. Misses remain black, naturally preserving screen-space occlusion.
    const float3 indirectDiffuse = (incidentRadiance / (float)sampleCount) * albedoAO.rgb * albedoAO.a * (1.0f - metallic) * Intensity;
    g_SSGIOut[tid.xy] = float4(indirectDiffuse, 1.0f);
}
