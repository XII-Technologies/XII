// XII Engine - SSGI.xiiShader
// Stage 9: Screen-Space Global Illumination.
// Uniform hemisphere ray-march in view space using the Hi-Z depth pyramid for
// occlusion, reading the current HDR scene as a one-bounce indirect radiance source.
// Dispatch: ceil(W/8) × ceil(H/8) × 1.

#include "PipelineCommon.xiiShader"

cbuffer SSGIConstants : register(b3)
{
    float  g_RayLength;      // max trace distance in view-space units (default 2.0)
    uint   g_SampleCount;    // hemisphere samples per pixel (default 8)
    float  g_Thickness;      // depth acceptance threshold (default 0.15)
    float  g_Intensity;      // output multiplier
};

Texture2D<float>  g_SceneDepth  : register(t0); // reversed-Z depth
Texture2D<float4> g_GBufNormal  : register(t1); // oct-encoded normals in GBuffer
Texture2D<float4> g_HDRScene    : register(t2);  // current frame HDR scene color
RWTexture2D<float4> g_SSGIOut   : register(u0);

// Build an orthonormal basis around the surface normal.
void BuildONB(float3 n, out float3 T, out float3 B)
{
    float3 up = abs(n.z) < 0.999f ? float3(0, 0, 1) : float3(1, 0, 0);
    T = normalize(cross(up, n));
    B = cross(n, T);
}

// Cosine-weighted hemisphere sample.
float3 CosineSampleHemisphere(float2 xi)
{
    float phi    = 2.0f * 3.14159265f * xi.x;
    float cosT   = sqrt(xi.y);
    float sinT   = sqrt(1.0f - xi.y);
    return float3(sinT * cos(phi), sinT * sin(phi), cosT);
}

[numthreads(8, 8, 1)]
void CS_SSGI(uint3 tid : SV_DispatchThreadID)
{
    uint2 dims;
    g_SSGIOut.GetDimensions(dims.x, dims.y);
    if (any(tid.xy >= dims)) return;

    float2 uv = (float2(tid.xy) + 0.5f) / float2(dims);

    // Reconstruct world-space position and normal.
    float  depth = g_SceneDepth.SampleLevel(g_sPointClamp, uv, 0);
    if (depth <= 0.0f)
    {
        g_SSGIOut[tid.xy] = float4(0, 0, 0, 0);
        return;
    }

    float3 worldPos = ReconstructWorldPos(uv, depth);
    float2 octEnc   = g_GBufNormal.SampleLevel(g_sPointClamp, uv, 0).rg;
    float3 normal   = DecodeOctNormal(octEnc);

    // Build tangent frame.
    float3 T, B;
    BuildONB(normal, T, B);

    float3 irradiance = float3(0, 0, 0);
    float  totalWeight = 0.0f;

    [loop]
    for (uint i = 0u; i < g_SampleCount; ++i)
    {
        // Halton quasi-random with temporal offset.
        float2 xi = float2(
            HaltonSample(i + g_FrameIndex * g_SampleCount, 2u),
            HaltonSample(i + g_FrameIndex * g_SampleCount, 3u));

        // Cosine-weighted sample in hemisphere.
        float3 localDir = CosineSampleHemisphere(xi);
        float3 rayDir   = T * localDir.x + B * localDir.y + normal * localDir.z;
        float  NdotL    = localDir.z; // = dot(normal, rayDir) in tangent space

        if (NdotL <= 0.0f) continue;

        // March in screen space: map world ray to NDC step.
        float3 samplePos = worldPos + rayDir * g_RayLength;
        float4 sampleClip = mul(g_ViewProjectionMatrix, float4(samplePos, 1.0f));
        sampleClip.xyz /= sampleClip.w;

        float2 sampleUV = sampleClip.xy * 0.5f + 0.5f;
        sampleUV.y = 1.0f - sampleUV.y;

        if (any(sampleUV < 0.0f) || any(sampleUV > 1.0f)) continue;

        // Depth comparison: accept hit only if scene depth roughly matches.
        float hitDepth    = g_SceneDepth.SampleLevel(g_sLinearClamp, sampleUV, 0);
        float hitLinear   = LinearizeDepth(hitDepth);
        float rayLinear   = LinearizeDepth(saturate(sampleClip.z));

        bool hit = (hitLinear < rayLinear) && (rayLinear - hitLinear < g_Thickness * hitLinear);
        if (!hit) continue;

        // Sample scene radiance at hit point.
        float3 radiance = g_HDRScene.SampleLevel(g_sLinearClamp, sampleUV, 0).rgb;
        irradiance     += radiance * NdotL;
        totalWeight    += NdotL;
    }

    if (totalWeight > 0.0f)
        irradiance /= totalWeight;

    g_SSGIOut[tid.xy] = float4(irradiance * g_Intensity, 1.0f);
}
