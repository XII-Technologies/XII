[PLATFORMS]
ALL
[COMPUTE_SHADER]
#include <Shaders/Common/StorageImageFormat.h>
Texture2D<float4> g_Signal;
XII_STORAGE_IMAGE_FORMAT("rgba32f") RWTexture2D<float4> g_Radiance;
[numthreads(8,8,1)]
void main(uint3 tid:SV_DispatchThreadID)
{
  uint2 extent; g_Radiance.GetDimensions(extent.x,extent.y);
  if(any(tid.xy>=extent)) return;
  const float4 signal=g_Signal.Load(int3(tid.xy,0));
  const float3 radiance=max(signal.rgb,0)*saturate(signal.a);
  g_Radiance[tid.xy]=float4(all(isfinite(radiance)) ? radiance:0,1);
}
