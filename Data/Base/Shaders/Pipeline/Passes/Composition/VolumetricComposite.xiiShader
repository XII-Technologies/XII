[PLATFORMS]
ALL
[COMPUTE_SHADER]
#include <Shaders/Common/StorageImageFormat.h>
Texture2D<float4> g_SceneRadiance;
Texture2D<float4> g_ScatteringOpacity;
XII_STORAGE_IMAGE_FORMAT("rgba16f") RWTexture2D<float4> g_Radiance;
[numthreads(8,8,1)]
void main(uint3 tid:SV_DispatchThreadID)
{
  uint2 extent; g_Radiance.GetDimensions(extent.x,extent.y);
  if(any(tid.xy>=extent)) return;
  const float4 fog=g_ScatteringOpacity.Load(int3(tid.xy,0));
  const float3 radiance=max(g_SceneRadiance.Load(int3(tid.xy,0)).rgb,0)*(1-saturate(fog.a))+max(fog.rgb,0);
  g_Radiance[tid.xy]=float4(all(isfinite(radiance)) ? clamp(radiance,0,65504.0f):0,1);
}
