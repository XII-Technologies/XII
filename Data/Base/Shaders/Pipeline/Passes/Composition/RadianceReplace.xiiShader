[PLATFORMS]
ALL
[COMPUTE_SHADER]
#include <Shaders/Common/StorageImageFormat.h>
Texture2D<float4> g_Scene;
Texture2D<float4> g_PreviousContribution;
Texture2D<float4> g_Replacement;
XII_STORAGE_IMAGE_FORMAT("rgba32f") RWTexture2D<float4> g_Radiance;
[numthreads(8,8,1)]
void main(uint3 tid:SV_DispatchThreadID)
{
  uint2 extent;g_Radiance.GetDimensions(extent.x,extent.y);if(any(tid.xy>=extent))return;
  const float4 scene=g_Scene.Load(int3(tid.xy,0));
  const float3 previous=g_PreviousContribution.Load(int3(tid.xy,0)).rgb,replacement=g_Replacement.Load(int3(tid.xy,0)).rgb;
  const float3 base=all(isfinite(scene.rgb))?scene.rgb:0;
  const float3 oldValue=all(isfinite(previous))?max(previous,0):0;
  const float3 newValue=all(isfinite(replacement))?max(replacement,0):0;
  const float3 radiance=max(base-oldValue+newValue,0);
  g_Radiance[tid.xy]=float4(all(isfinite(radiance))?radiance:0,isfinite(scene.a)?scene.a:0);
}
