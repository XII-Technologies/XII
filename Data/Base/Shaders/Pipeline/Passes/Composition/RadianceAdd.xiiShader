[PLATFORMS]
ALL
[COMPUTE_SHADER]
#include <Shaders/Common/StorageImageFormat.h>
#include <Shaders/Pipeline/Passes/Composition/RadianceAddConstants.h>
Texture2D<float4> g_A;
Texture2D<float4> g_B;
XII_STORAGE_IMAGE_FORMAT("rgba32f") RWTexture2D<float4> g_Radiance;
[numthreads(8,8,1)]
void main(uint3 tid:SV_DispatchThreadID)
{
  uint2 extent; g_Radiance.GetDimensions(extent.x,extent.y);
  if(any(tid.xy>=extent)) return;
  const float3 radiance=max(g_A.Load(int3(tid.xy,0)).rgb,0)*RadianceScales.x+max(g_B.Load(int3(tid.xy,0)).rgb,0)*RadianceScales.y;
  g_Radiance[tid.xy]=float4(all(isfinite(radiance)) ? radiance:0,1);
}
