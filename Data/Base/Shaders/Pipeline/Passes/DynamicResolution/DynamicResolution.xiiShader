[PLATFORMS]
ALL

[COMPUTE_SHADER]

#include <Shaders/Pipeline/Passes/DynamicResolution/DynamicResolutionConstants.h>

// PID state buffer (read/write).
// [0] = CurrentScale
// [1] = ErrorIntegral
// [2] = PreviousError
// [3] = SmoothedScale
RWStructuredBuffer<float> g_DynamicResolutionData;

// PID tunables (tuned for stability + responsiveness).
static const float kP = 0.35f;
static const float kI = 0.05f;
static const float kD = 0.15f;

// Anti-windup clamp.
static const float kIntegralLimit = 1.0f;

// Max per-frame scale change.
static const float kMaxScaleStep = 0.10f;

// EMA smoothing for final scale.
static const float kSmoothingAlpha = 0.20f;

// Step clamp helper.
float ClampStep(float fDesired, float fCurrent, float fMaxStep)
{
  float fDelta = fDesired - fCurrent;
  fDelta       = clamp(fDelta, -fMaxStep, fMaxStep);
  return fCurrent + fDelta;
}

[numthreads(1, 1, 1)]
void main(uint3 vThreadID : SV_DispatchThreadID)
{
  // Read PID state.
  float fCurrentScale  = g_DynamicResolutionData[0];
  float fIntegral      = g_DynamicResolutionData[1];
  float fPreviousError = g_DynamicResolutionData[2];
  float fSmoothedScale = g_DynamicResolutionData[3];
  
  // Time step (ms). Gains assume ms units.
  float fDeltaTime = max(FrameDeltaTimeMs, 0.001f);
  
  // Error: positive means we are faster than target (can increase scale).
  float fError = (TargetFrameTimeMs - SmoothedGpuTimeMs) / TargetFrameTimeMs;
  
  // Integral term with anti-windup.
  fIntegral += fError * fDeltaTime;
  fIntegral = clamp(fIntegral, -kIntegralLimit, kIntegralLimit);
  
  // Derivative term.
  float fDerivative = (fError - fPreviousError) / fDeltaTime;
  
  // PID output.
  float fControl = kP * fError + kI * fIntegral + kD * fDerivative;
  
  // Apply control additively.
  float fDesiredScale = fCurrentScale + fControl;
  
  // Clamp to allowed range.
  fDesiredScale = clamp(fDesiredScale, MininimumRenderScale, MaximumRenderScale);
  
  // Limit per-frame change.
  float fLimitedScale = ClampStep(fDesiredScale, fCurrentScale, kMaxScaleStep);
  
  // Smooth final scale.
  float fNewSmoothedScale = lerp(fSmoothedScale, fLimitedScale, kSmoothingAlpha);
  
  // Write back state.
  g_DynamicResolutionData[0] = fLimitedScale;     // CurrentScale
  g_DynamicResolutionData[1] = fIntegral;         // ErrorIntegral
  g_DynamicResolutionData[2] = fError;            // PreviousError
  g_DynamicResolutionData[3] = fNewSmoothedScale; // SmoothedScale
}
