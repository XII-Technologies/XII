[PLATFORMS]
ALL
[COMPUTE_SHADER]
#include <Shaders/Pipeline/Passes/Lighting/LightClusterConstants.h>
#include <Shaders/Pipeline/LightingData.h>
StructuredBuffer<xiiGpuLightData> g_Lights;
StructuredBuffer<uint2> g_LightGrid;
StructuredBuffer<uint> g_LightIndex;
RWStructuredBuffer<uint> g_PackedIndices;
RWStructuredBuffer<float> g_LightSamplingTotals;
#include <Shaders/Pipeline/LightPower.h>

[numthreads(64,1,1)]
void main(uint3 tid:SV_DispatchThreadID)
{
  const uint cluster=tid.x+tid.y*Work.z;
  if(cluster>=ClusterCounts.w) return;
  const uint2 range=g_LightGrid[cluster];
  const uint count=min(range.y,Viewport.w);
  float power=0;
  [loop] for(uint slot=0;slot<count;++slot)
  {
    const uint address=range.x+slot;
    if(address>=Work.y) continue;
    const uint light=g_LightIndex[address];
    if(light<Work.x) power+=GetLightPowerWeight(g_Lights[light]);
  }
  if(!isfinite(power)) power=0;
  g_LightSamplingTotals[cluster]=power;
  float cumulative=0;
  [loop] for(uint slot=0;slot<Viewport.w;++slot)
  {
    const uint address=range.x+slot;
    if(address>=Work.y) continue;
    uint packed=0xFFFFFFFFu;
    if(slot<count)
    {
      const uint light=g_LightIndex[address];
      if(light<Work.x)
      {
        cumulative+=GetLightPowerWeight(g_Lights[light]);
        const uint cdf=power>0 ? (uint)round(saturate(cumulative/power)*XII_CLUSTER_LIGHT_CDF_MAX) : 0;
        packed=PackClusterLightEntry(light,cdf);
      }
    }
    g_PackedIndices[address]=packed;
  }
}
