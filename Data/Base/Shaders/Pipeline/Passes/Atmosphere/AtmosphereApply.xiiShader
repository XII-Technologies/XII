[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTE_SHADER]

#include <Shaders/Common/StorageImageFormat.h>

#include <Shaders/Pipeline/Passes/ScreenSpaceGeometry.h>
#include <Shaders/Pipeline/Passes/Lighting/EnvironmentLightConstants.h>
#include <Shaders/Pipeline/Passes/Atmosphere/AtmosphereConstants.h>
#include <Shaders/Pipeline/Passes/Atmosphere/SunDisk.h>

Texture2D<float>    g_SceneDepth;
Texture2D<float4>   g_Transmittance; // precomputed LUT
Texture2D<float4>   g_MultiScatter;  // 32x32 fms LUT
Texture2D<float4> g_SceneRadiance;
SamplerState PointClampSampler;
SamplerState LinearClampSampler;
XII_STORAGE_IMAGE_FORMAT("rgba32f") RWTexture2D<float4> g_AtmosphereOutput;

// Sample the transmittance LUT for a given camera height and sun zenith.
float3 SampleTransmittance(float heightKm, float cosZenith)
{
    float2 uv = float2(
        saturate((heightKm - PlanetAtmosphereRadiiScaleHeights.x) / (PlanetAtmosphereRadiiScaleHeights.y - PlanetAtmosphereRadiiScaleHeights.x)),
        saturate(cosZenith * 0.5f + 0.5f));
    return g_Transmittance.SampleLevel(LinearClampSampler, uv, 0).rgb;
}

// Rayleigh phase.
float RayleighPhase(float cosTheta) { return (3.0f / (16.0f * 3.14159265f)) * (1.0f + cosTheta * cosTheta); }

float MiePhase(float cosTheta, float g)
{
    float g2 = g * g;
    return (3.0f / (8.0f * 3.14159265f)) * ((1.0f - g2) * (1.0f + cosTheta * cosTheta))
         / max((2.0f + g2) * pow(max(1.0f + g2 - 2.0f * g * cosTheta, 1e-4f), 1.5f), 1e-4f);
}

float DistanceToSphereExit(float3 origin, float3 direction, float radius)
{
    float b = dot(origin, direction);
    float c = dot(origin, origin) - radius * radius;
    return max(-b + sqrt(max(b * b - c, 0.0f)), 0.0f);
}

float DistanceToGround(float3 origin, float3 direction, float groundRadius)
{
    if (length(origin) <= groundRadius + 1e-4f)
        return dot(origin, direction) < 0.0f ? 0.0f : -1.0f;

    const float b = dot(origin, direction);
    const float c = dot(origin, origin) - groundRadius * groundRadius;
    const float d = b * b - c;
    if (d < 0.0f)
        return -1.0f;

    const float nearDistance = -b - sqrt(d);
    return nearDistance >= 0.0f ? nearDistance : -1.0f;
}

void IntegrateAtmosphereSegment(float3 rayOrigin, float3 rayDirection, float rayLengthKm, float3 sunDirection,
                                float cosTheta, float3 solarIlluminance, uint stepCount,
                                out float3 transmittance, out float3 radiance)
{
    transmittance = 1.0f;
    radiance = 0.0f;
    if (rayLengthKm <= 0.0f || stepCount == 0u)
        return;

    const float dt = rayLengthKm / float(stepCount);
    const float rayleighPhase = RayleighPhase(cosTheta);
    const float miePhase = MiePhase(cosTheta, MieScatteringAndPhase.w);

    [loop]
    for (uint step = 0u; step < stepCount; ++step)
    {
        const float3 samplePosition = rayOrigin + rayDirection * ((float(step) + 0.5f) * dt);
        const float sampleRadius = max(length(samplePosition), PlanetAtmosphereRadiiScaleHeights.x);
        const float altitudeKm = max(sampleRadius - PlanetAtmosphereRadiiScaleHeights.x, 0.0f);
        const float3 sampleUp = samplePosition / sampleRadius;
        const float rayleighDensity = exp(-altitudeKm / PlanetAtmosphereRadiiScaleHeights.z);
        const float mieDensity = exp(-altitudeKm / PlanetAtmosphereRadiiScaleHeights.w);
        const float ozoneDensity = saturate(1.0f - abs(altitudeKm - 25.0f) / 15.0f);

        const float3 rayleigh = RayleighScattering.xyz * rayleighDensity;
        const float3 mieScatter = MieScatteringAndPhase.xyz * mieDensity;
        const float3 extinction = rayleigh + mieScatter + MieAbsorption.xyz * mieDensity + OzoneAbsorption.xyz * ozoneDensity;
        const float3 stepTransmittance = exp(-extinction * dt);
        const float3 integratedDistance = (1.0f - stepTransmittance) / max(extinction, 1e-6f);

        const float cosSunZenith = dot(sunDirection, sampleUp);
        const float3 sunTransmittance = SampleTransmittance(sampleRadius, cosSunZenith);
        const float2 msUV = float2(saturate(cosSunZenith * 0.5f + 0.5f),
                                   saturate((sampleRadius - PlanetAtmosphereRadiiScaleHeights.x) /
                                            (PlanetAtmosphereRadiiScaleHeights.y - PlanetAtmosphereRadiiScaleHeights.x)));
        const float3 multiScatter = g_MultiScatter.SampleLevel(LinearClampSampler, msUV, 0).rgb;
        const float3 singleScatter = (rayleigh * rayleighPhase + mieScatter * miePhase) * sunTransmittance;
        const float3 source = solarIlluminance * (singleScatter + multiScatter);

        radiance += transmittance * source * integratedDistance;
        transmittance *= stepTransmittance;
    }
}

[numthreads(8, 8, 1)]
void main(uint3 tid : SV_DispatchThreadID)
{
    uint2 dims; g_AtmosphereOutput.GetDimensions(dims.x, dims.y);
    if (any(tid.xy >= dims)) return;

    float2 uv    = (float2(tid.xy) + 0.5f) / float2(dims);
    float  depth = g_SceneDepth.SampleLevel(PointClampSampler, uv, 0);

    const bool isSky = depth <= 1e-7f;
    const float3 cameraPosition = SurfaceCameraPositionNear.xyz;
    float3 worldPosition;
    if(!isfinite(depth) || depth>1 || !xiiScreenWorldPosition(uv,isSky?0.001f:depth,worldPosition))
    {g_AtmosphereOutput[tid.xy]=g_SceneRadiance.Load(int3(tid.xy,0));return;}
    float3 V = normalize(worldPosition - cameraPosition);
    float3 sunDirection = normalize(-EnvironmentDirectionAndIlluminance.xyz);
    float cosTheta = dot(V, sunDirection);

    float3 planetUp = normalize(PlanetUpAndGroundAltitudeMeters.xyz);
    float cameraAltitudeMeters = dot(SurfaceCameraPositionNear.xyz, planetUp) - PlanetUpAndGroundAltitudeMeters.w;
    float cameraHeightKm = PlanetAtmosphereRadiiScaleHeights.x + max(cameraAltitudeMeters / 1000.0f, 0.0f);
    float cosSunZenith   = dot(sunDirection, planetUp);

    const float3 atmosphereRayOrigin = planetUp * cameraHeightKm;
    const float atmosphereDistance = DistanceToSphereExit(atmosphereRayOrigin, V, PlanetAtmosphereRadiiScaleHeights.y);
    const float groundDistance = DistanceToGround(atmosphereRayOrigin, V, PlanetAtmosphereRadiiScaleHeights.x);
    float pathLengthKm = isSky ? atmosphereDistance : min(length(worldPosition - cameraPosition) * 0.001f, atmosphereDistance);
    if (isSky && groundDistance >= 0.0f)
        pathLengthKm = min(pathLengthKm, groundDistance);

    float3 solarIlluminance = max(EnvironmentColorAndAngularRadius.rgb * EnvironmentDirectionAndIlluminance.w, 0.0f);
    float3 viewTransmittance;
    float3 sky;
    IntegrateAtmosphereSegment(atmosphereRayOrigin, V, pathLengthKm, sunDirection, cosTheta, solarIlluminance,
                               isSky ? clamp(SampleCounts.z, 1u, 64u) : clamp(SampleCounts.w, 1u, 64u), viewTransmittance, sky);

    if (isSky)
    {
        const float3 sunTransmittance = SampleTransmittance(cameraHeightKm, cosSunZenith);
        sky += xiiEvaluateSunDiskRadiance(V, sunDirection, EnvironmentColorAndAngularRadius.w,
                                         SunDiskParameters.x, solarIlluminance, sunTransmittance);
    }

    float4 existing = g_SceneRadiance.Load(int3(tid.xy,0));
    if (isSky)
    {
        g_AtmosphereOutput[tid.xy] = float4(existing.rgb + sky, 1.0f);
        return;
    }

    g_AtmosphereOutput[tid.xy] = float4(existing.rgb * viewTransmittance + sky, existing.a);
}
