[PLATFORMS]
ALL
[COMPUTE_SHADER]
#include <Shaders/Common/StorageImageFormat.h>
#include <Shaders/Pipeline/Passes/ScreenSpaceGeometry.h>
#include <Shaders/Pipeline/Passes/GlobalIllumination/ScreenIrradianceConstants.h>
Texture2D<float> g_Depth;
Texture2D<float2> g_Normal;
Texture2D<float4> g_Radiance;
XII_STORAGE_IMAGE_FORMAT("rgba32f") RWTexture2D<float4> g_Irradiance;

float Halton(uint index, uint base)
{
  float weight=1, result=0;
  while(index>0){weight/=float(base);result+=weight*float(index%base);index/=base;}
  return result;
}

bool ProjectIrradiance(float3 world, out float2 uv)
{
  uv=0;
  const float4 clip=mul(SurfaceViewProjection,float4(world,1));
  if(!all(isfinite(clip)) || clip.w<=1e-7f) return false;
  const float3 ndc=clip.xyz/clip.w;
  uv=ndc.xy*float2(0.5f,-0.5f)+0.5f;
  return all(uv>=0) && all(uv<1) && ndc.z>0 && ndc.z<=1;
}

bool IrradianceGap(float3 rayPoint, out uint2 pixel, out float3 scenePoint, out float gap)
{
  pixel=0;scenePoint=0;gap=0;
  float2 uv;
  if(!ProjectIrradiance(rayPoint,uv)) return false;
  uint width,height;
  g_Depth.GetDimensions(width,height);
  pixel=min(uint2(uv*float2(width,height)),uint2(width-1,height-1));
  const float depth=g_Depth.Load(int3(pixel,0));
  if(!isfinite(depth) || depth<=0 || depth>1 || !xiiScreenWorldPosition((float2(pixel)+0.5f)/float2(width,height),depth,scenePoint)) return false;
  // This comparison uses actual world coordinates for both camera projections.
  gap=dot(rayPoint-scenePoint,SurfaceCameraForwardFar.xyz);
  return isfinite(gap);
}

float3 TraceIncident(float3 origin, float3 normal, float3 direction)
{
  const float3 start=origin+normal*TraceDistances.z;
  float previousDistance=0;
  const uint steps=TraceCounts.y;
  [loop] for(uint step=1;step<=steps;++step)
  {
    const float fraction=float(step)/float(steps);
    const float distance=fraction*fraction*TraceDistances.x;
    const float3 rayPoint=start+direction*distance;
    float2 uv;
    if(!ProjectIrradiance(rayPoint,uv)) break;
    uint2 pixel;
    float3 hit;
    float gap;
    if(IrradianceGap(rayPoint,pixel,hit,gap) && gap>=0)
    {
      float nearDistance=previousDistance,farDistance=distance;
      [unroll] for(uint refine=0;refine<8;++refine)
      {
        const float middle=(nearDistance+farDistance)*0.5f;
        if(IrradianceGap(start+direction*middle,pixel,hit,gap) && gap>=0) farDistance=middle;
        else nearDistance=middle;
      }
      if(!IrradianceGap(start+direction*farDistance,pixel,hit,gap) || gap>TraceDistances.y) return 0;
      const float3 toHit=hit-origin;
      const float3 hitNormal=xiiScreenNormal(g_Normal.Load(int3(pixel,0)));
      if(dot(toHit,normal)<=TraceDistances.z || dot(toHit,direction)<=TraceDistances.z ||
         dot(toHit,toHit)>TraceDistances.x*TraceDistances.x || !all(isfinite(hitNormal)) || dot(hitNormal,direction)>=-1e-4f) return 0;
      // Match depth/normal footprints. Filtering radiance across their discontinuity
      // would leak an occluded neighbour through a visible edge.
      const float3 radiance=g_Radiance.Load(int3(pixel,0)).rgb;
      return all(isfinite(radiance)) ? max(radiance,0):0;
    }
    previousDistance=distance;
  }
  return 0;
}

[numthreads(8,8,1)]
void main(uint3 tid:SV_DispatchThreadID)
{
  uint2 extent;g_Irradiance.GetDimensions(extent.x,extent.y);
  if(any(tid.xy>=extent)) return;
  g_Irradiance[tid.xy]=0;
  const float2 uv=(float2(tid.xy)+0.5f)/float2(extent);
  const float depth=g_Depth.Load(int3(tid.xy,0));
  float3 position;
  if(!isfinite(depth) || depth<=0 || depth>1 || !xiiScreenWorldPosition(uv,depth,position)) return;
  const float3 normal=xiiScreenNormal(g_Normal.Load(int3(tid.xy,0)));
  if(!all(isfinite(normal))) return;
  const float3 up=abs(normal.z)<0.999f ? float3(0,0,1):float3(1,0,0);
  const float3 tangent=normalize(cross(up,normal)),bitangent=cross(normal,tangent);
  float3 incident=0;
  const uint samples=TraceCounts.x;
  if(TraceDistances.x>0)
  {
    [loop] for(uint sampleIndex=0;sampleIndex<samples;++sampleIndex)
    {
      // Fixed authored sequence: independent views do not advance one another.
      const uint index=(TraceCounts.z+sampleIndex)%1048576u+1u;
      const float2 xi=float2(Halton(index,2u),Halton(index,3u));
      const float phi=6.28318530718f*xi.x,cosine=sqrt(xi.y),sine=sqrt(1-xi.y);
      const float3 direction=tangent*(sine*cos(phi))+bitangent*(sine*sin(phi))+normal*cosine;
      incident+=TraceIncident(position,normal,direction);
    }
  }
  // E = pi * average incident radiance for p(direction) = cos(theta)/pi.
  // Screen misses contribute zero bounce; the consumer retains environment light.
  const float3 irradiance=incident*(3.14159265359f/float(samples));
  g_Irradiance[tid.xy]=float4(all(isfinite(irradiance)) ? max(irradiance,0):0,1);
}
