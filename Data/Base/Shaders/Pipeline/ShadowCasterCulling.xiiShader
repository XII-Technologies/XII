// Builds a global local-light caster stream and four cascade-culled command streams.
[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTE_SHADER]

#include <Shaders/Pipeline/Passes/ShadowCascade/ShadowCascadeConstants.h>
#include <Shaders/Pipeline/Passes/Visibility/ShadowCasterCullingConstants.h>

struct DrawIndexedIndirectCommand
{
  uint IndexCountPerInstance;
  uint InstanceCount;
  uint StartIndexLocation;
  int BaseVertexLocation;
  uint StartInstanceLocation;
};

struct InstanceBounds
{
  float4 CenterRadius;
  float4 Extents;
};

StructuredBuffer<DrawIndexedIndirectCommand> g_SourceCommands;
StructuredBuffer<InstanceBounds> g_InstanceBounds;
RWStructuredBuffer<DrawIndexedIndirectCommand> g_ShadowDrawArgs;
RWStructuredBuffer<uint> g_ShadowDrawCounts; // Global block, then four cascade blocks.

bool IntersectsCascade(InstanceBounds bounds, uint cascadeIndex)
{
  const float4x4 viewProjection = CascadeViewProjection[cascadeIndex];
  const float4 clipCenter = mul(viewProjection, float4(bounds.CenterRadius.xyz, 1.0f));
  const float radius = max(bounds.CenterRadius.w, 0.0f);

  const float radiusX = radius * length(float3(viewProjection[0][0], viewProjection[0][1], viewProjection[0][2]));
  const float radiusY = radius * length(float3(viewProjection[1][0], viewProjection[1][1], viewProjection[1][2]));
  const float radiusZ = radius * length(float3(viewProjection[2][0], viewProjection[2][1], viewProjection[2][2]));

  return clipCenter.x + radiusX >= -clipCenter.w &&
         clipCenter.x - radiusX <= clipCenter.w &&
         clipCenter.y + radiusY >= -clipCenter.w &&
         clipCenter.y - radiusY <= clipCenter.w &&
         clipCenter.z + radiusZ >= 0.0f &&
         clipCenter.z - radiusZ <= clipCenter.w;
}

void AppendCommand(uint blockIndex, DrawIndexedIndirectCommand command)
{
  uint destination;
  InterlockedAdd(g_ShadowDrawCounts[blockIndex], 1u, destination);
  if (destination < MaxCommandCount)
    g_ShadowDrawArgs[blockIndex * MaxCommandCount + destination] = command;
}

[numthreads(64, 1, 1)]
void main(uint3 dispatchThreadId : SV_DispatchThreadID)
{
  const uint instanceIndex = dispatchThreadId.x;
  if (instanceIndex >= InstanceCount || MaxCommandCount == 0u)
    return;

  const DrawIndexedIndirectCommand command = g_SourceCommands[instanceIndex];
  if (command.IndexCountPerInstance == 0u || command.InstanceCount == 0u)
    return;

  AppendCommand(0u, command);

  const InstanceBounds bounds = g_InstanceBounds[instanceIndex];
  [unroll]
  for (uint cascadeIndex = 0u; cascadeIndex < 4u; ++cascadeIndex)
  {
    if (cascadeIndex < CullingActiveCascadeCount && IntersectsCascade(bounds, cascadeIndex))
      AppendCommand(cascadeIndex + 1u, command);
  }
}
