// Compacts extracted transforms and bounds into GPU rendering streams.
[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTE_SHADER]

#include <Shaders/Pipeline/Passes/Visibility/InstanceUpdateConstants.h>

struct InstanceUpdateSource
{
  Transform GlobalTransform;
  float4 CenterRadius;
  float4 Extents;
};

struct InstanceBounds
{
  float4 CenterRadius;
  float4 Extents;
};

StructuredBuffer<uint> g_VisibleIn; // [0] = count, [1..] = packet indices.
StructuredBuffer<InstanceUpdateSource> g_InstanceSource;
RWStructuredBuffer<Transform> g_MatricesOut;
RWStructuredBuffer<InstanceBounds> g_BoundsOut;

[numthreads(64, 1, 1)]
void main(uint3 dispatchThreadId : SV_DispatchThreadID)
{
  const uint visibleIndex = dispatchThreadId.x;
  const uint visibleCount = min(g_VisibleIn[0], InstanceCount);
  if (visibleIndex >= visibleCount)
    return;

  const uint instanceIndex = g_VisibleIn[visibleIndex + 1u];
  if (instanceIndex >= InstanceCount)
    return;

  const InstanceUpdateSource source = g_InstanceSource[instanceIndex];
  InstanceBounds bounds;
  bounds.CenterRadius = source.CenterRadius;
  bounds.Extents = source.Extents;

  g_MatricesOut[instanceIndex] = source.GlobalTransform;
  g_BoundsOut[instanceIndex] = bounds;
}
