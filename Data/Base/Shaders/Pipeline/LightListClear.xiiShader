// XII Engine - Initializes fixed-offset clustered light-list metadata.

cbuffer xiiLightClusteringConstants : register(b3)
{
    uint  ClusterCountX;
    uint  ClusterCountY;
    uint  ClusterCountZ;
    uint  TotalClusters;
    float NearPlane;
    float FarPlane;
    float LogFarOverNear;
    float Padding1;
    uint  TilePixelsX;
    uint  TilePixelsY;
    uint  MaxLightsPerCluster;
    uint  ActiveLightCount;
};

RWStructuredBuffer<uint2> g_LightGrid : register(u0);

[numthreads(64, 1, 1)]
void CS_LightListClear(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    const uint clusterIndex = dispatchThreadId.x;
    if (clusterIndex >= TotalClusters)
        return;

    g_LightGrid[clusterIndex] = uint2(clusterIndex * MaxLightsPerCluster, 0u);
}

