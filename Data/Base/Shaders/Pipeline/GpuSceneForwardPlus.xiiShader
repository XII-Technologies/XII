// XII Engine - clustered Forward+ direct lighting from compact GPU-scene meshlets.

[PLATFORMS]
ALL

[RENDERSTATE]

DepthEnable = true
DepthWriteEnable = false
ComparisonDepthFunction = ComparisonFunction_GreaterEqual
CullMode = CullMode_None

[SHADER]

#include <Shaders/Materials/GpuSurfaceMaterial.h>
#include <Shaders/Common/Common.h>
#include <Shaders/Pipeline/PipelineCommon.xiiShader>
#include <Shaders/Pipeline/Passes/Geometry/GpuSceneGBufferConstants.h>
#include <Shaders/Pipeline/SurfaceLighting.h>

StructuredBuffer<xiiGpuLightData> g_Lights;

#include <Shaders/Pipeline/ReSTIRDICommon.h>
#include <Shaders/Pipeline/Passes/Atmosphere/CloudShadowConstants.h>
#include <Shaders/Pipeline/Passes/Atmosphere/CloudShadowSampling.h>
#include <Shaders/Pipeline/Passes/ShadowCascade/ShadowCascadeConstants.h>
#include <Shaders/Pipeline/Passes/VirtualShadowMap/VirtualShadowSampling.h>
#include <Shaders/Visibility/GpuSceneCommon.h>

Texture2DArray<float> g_ShadowAtlas;
Texture2D<float> g_ContactShadow;
Texture2D<float> g_RTShadow;
Texture2D<float> g_LocalShadowAtlas;
StructuredBuffer<xiiLocalShadowAtlasData> g_LocalShadowAtlasDescs;

#include <Shaders/Pipeline/SurfaceShadowLighting.h>

struct ForwardVertex
{
  float4 Position : SV_Position;
  float3 WorldPosition : TEXCOORD0;
  float3 WorldNormal : TEXCOORD1;
  float3 WorldTangent : TEXCOORD2;
  float TangentSign : TEXCOORD3;
  float2 TexCoord : TEXCOORD4;
  nointerpolation uint MaterialIndex : TEXCOORD5;
};

uint LoadByte(ByteAddressBuffer source, uint byteOffset)
{
  const uint word = source.Load(byteOffset & ~3u);
  return (word >> ((byteOffset & 3u) * 8u)) & 0xFFu;
}

[MESH_SHADER]

StructuredBuffer<GpuSceneInstance> g_SceneInstances;
StructuredBuffer<GpuGeometryRecord> g_Geometry;
StructuredBuffer<GpuMeshlet> g_Meshlets;
StructuredBuffer<uint2> g_VisibleMeshlets;
StructuredBuffer<uint> g_VisibleMeshletCount;
ByteAddressBuffer g_Buffers[];

[outputtopology("triangle")]
[numthreads(64, 1, 1)]
void main(uint threadIndex : SV_GroupThreadID,
          uint3 groupIndex : SV_GroupID,
          out vertices ForwardVertex vertices[64],
          out indices uint3 triangles[126])
{
  uint visibleCountCapacity, visibleCountStride;
  uint visibleCapacity, visibleStride;
  uint sceneCapacity, sceneStride;
  uint geometryCapacity, geometryStride;
  uint meshletCapacity, meshletStride;
  g_VisibleMeshletCount.GetDimensions(visibleCountCapacity, visibleCountStride);
  g_VisibleMeshlets.GetDimensions(visibleCapacity, visibleStride);
  g_SceneInstances.GetDimensions(sceneCapacity, sceneStride);
  g_Geometry.GetDimensions(geometryCapacity, geometryStride);
  g_Meshlets.GetDimensions(meshletCapacity, meshletStride);

  const uint visibleMeshletIndex = groupIndex.x +
    groupIndex.y * MeshDispatchGroupCountX +
    groupIndex.z * MeshDispatchGroupCountX * MeshDispatchGroupCountY;
  if (visibleCountCapacity == 0u || visibleMeshletIndex >= min(g_VisibleMeshletCount[0], visibleCapacity))
  {
    SetMeshOutputCounts(0u, 0u);
    return;
  }

  const uint2 visible = g_VisibleMeshlets[visibleMeshletIndex];
  if (visible.x >= sceneCapacity || visible.y >= meshletCapacity)
  {
    SetMeshOutputCounts(0u, 0u);
    return;
  }

  const GpuSceneInstance instance = g_SceneInstances[visible.x];
  if (GeometryBaseIndex >= geometryCapacity || instance.GeometryIndex >= geometryCapacity - GeometryBaseIndex)
  {
    SetMeshOutputCounts(0u, 0u);
    return;
  }

  const GpuGeometryRecord geometry = g_Geometry[GeometryBaseIndex + instance.GeometryIndex];
  const GpuMeshlet meshlet = g_Meshlets[visible.y];
  const uint lodIndex = meshlet.PackedLodSection & 0xFFFFu;
  if (lodIndex >= min(geometry.LodCount, 8u))
  {
    SetMeshOutputCounts(0u, 0u);
    return;
  }

  const GpuGeometryLod lod = geometry.Lods[lodIndex];
  const uint primitiveCount = meshlet.PackedPrimitiveVertexCount & 0xFFFFu;
  const uint vertexCount = meshlet.PackedPrimitiveVertexCount >> 16u;
  if (instance.PrimitiveCount != 0u)
  {
    const uint selectedEnd = instance.FirstPrimitive + instance.PrimitiveCount;
    const uint meshletEnd = meshlet.Header.x + primitiveCount;
    if (meshlet.Header.x >= selectedEnd || meshletEnd <= instance.FirstPrimitive)
    {
      SetMeshOutputCounts(0u, 0u);
      return;
    }
  }
  if (vertexCount > 64u || primitiveCount > 126u || (primitiveCount > 0u && vertexCount == 0u) ||
      lod.VertexBufferIndex == 0xFFFFFFFFu || lod.MeshletRemapBufferIndex == 0xFFFFFFFFu || lod.MeshletPrimitiveBufferIndex == 0xFFFFFFFFu)
  {
    SetMeshOutputCounts(0u, 0u);
    return;
  }

  uint vertexBufferBytes;
  uint remapBufferBytes;
  uint primitiveBufferBytes;
  g_Buffers[lod.VertexBufferIndex].GetDimensions(vertexBufferBytes);
  g_Buffers[lod.MeshletRemapBufferIndex].GetDimensions(remapBufferBytes);
  g_Buffers[lod.MeshletPrimitiveBufferIndex].GetDimensions(primitiveBufferBytes);
  const uint lastAttributeEnd = max(max(12u, NormalOffset + 12u), max(TangentOffset + 16u, TexCoordOffset + 8u));
  if (VertexStride < lastAttributeEnd || meshlet.Header.y > remapBufferBytes / 4u || vertexCount > remapBufferBytes / 4u - meshlet.Header.y ||
      meshlet.Header.z > primitiveBufferBytes || primitiveCount * 3u > primitiveBufferBytes - meshlet.Header.z)
  {
    SetMeshOutputCounts(0u, 0u);
    return;
  }

  SetMeshOutputCounts(vertexCount, primitiveCount);

  if (threadIndex < vertexCount)
  {
    const uint sourceVertex = g_Buffers[lod.MeshletRemapBufferIndex].Load((meshlet.Header.y + threadIndex) * 4u);
    const uint vertexOffset = sourceVertex * VertexStride;
    const bool vertexIsValid = vertexOffset <= vertexBufferBytes && lastAttributeEnd <= vertexBufferBytes - vertexOffset;
    const float3 localPosition = vertexIsValid ? asfloat(g_Buffers[lod.VertexBufferIndex].Load3(vertexOffset)) : 0.0f;
    const float3 localNormal = vertexIsValid ? asfloat(g_Buffers[lod.VertexBufferIndex].Load3(vertexOffset + NormalOffset)) : float3(0.0f, 0.0f, 1.0f);
    const float4 localTangent = vertexIsValid ? asfloat(g_Buffers[lod.VertexBufferIndex].Load4(vertexOffset + TangentOffset)) : float4(1.0f, 0.0f, 0.0f, 1.0f);
    const float2 texCoord = vertexIsValid ? asfloat(g_Buffers[lod.VertexBufferIndex].Load2(vertexOffset + TexCoordOffset)) : 0.0f;

    const float3 worldPosition = mul(instance.GlobalTransform, float4(localPosition, 1.0f)).xyz;
    float3 worldNormal = normalize(float3(dot(instance.NormalTransformRow0.xyz, localNormal), dot(instance.NormalTransformRow1.xyz, localNormal), dot(instance.NormalTransformRow2.xyz, localNormal)));
    float3 worldTangent = normalize(mul((float3x3)instance.GlobalTransform, localTangent.xyz));
    worldTangent = normalize(worldTangent - worldNormal * dot(worldTangent, worldNormal));

    ForwardVertex output;
    output.Position = mul(ViewProjectionMatrix, float4(worldPosition, 1.0f));
    output.WorldPosition = worldPosition;
    output.WorldNormal = worldNormal;
    output.WorldTangent = worldTangent;
    output.TangentSign = localTangent.w;
    output.TexCoord = texCoord;
    output.MaterialIndex = instance.MaterialIndex;
    vertices[threadIndex] = output;
  }

  if (threadIndex < primitiveCount)
  {
    const uint sourcePrimitive = meshlet.Header.x + threadIndex;
    const uint primitiveOffset = meshlet.Header.z + threadIndex * 3u;
    const uint3 primitiveIndices = uint3(
      LoadByte(g_Buffers[lod.MeshletPrimitiveBufferIndex], primitiveOffset + 0u),
      LoadByte(g_Buffers[lod.MeshletPrimitiveBufferIndex], primitiveOffset + 1u),
      LoadByte(g_Buffers[lod.MeshletPrimitiveBufferIndex], primitiveOffset + 2u));
    const bool primitiveSelected = instance.PrimitiveCount == 0u ||
      (sourcePrimitive >= instance.FirstPrimitive && sourcePrimitive - instance.FirstPrimitive < instance.PrimitiveCount);
    triangles[threadIndex] = primitiveSelected && all(primitiveIndices < vertexCount) ? primitiveIndices : uint3(0u, 0u, 0u);
  }
}

[PIXEL_SHADER]

StructuredBuffer<xiiGpuSurfaceMaterial> g_SurfaceMaterials;
StructuredBuffer<uint2> g_LightGrid;
StructuredBuffer<uint> g_LightIndex;
Texture2D<float4> g_Textures[];
Texture2D<uint4> g_DirectLightReservoir;

float4 main(ForwardVertex input, bool isFrontFace : SV_IsFrontFace) : SV_Target0
{
  uint materialCount, materialStride;
  g_SurfaceMaterials.GetDimensions(materialCount, materialStride);
  const bool materialIsValid = input.MaterialIndex != 0xFFFFFFFFu && MaterialBaseIndex < materialCount && input.MaterialIndex < materialCount - MaterialBaseIndex;

  xiiGpuSurfaceMaterial material = (xiiGpuSurfaceMaterial)0;
  material.BaseColorOpacity = 1.0f;
  material.EmissiveColorAndRoughness.w = 0.5f;
  material.SurfaceParameters = float4(0.0f, 0.5f, 0.0f, 1.0f);
  material.LayerParameters = float4(0.5f, 1.0f, 0.0f, 0.1f);
  material.TextureIndices0 = 0xFFFFFFFFu;
  material.TextureIndices1 = 0xFFFFFFFFu;
  material.Metadata.y = 0xF000u;
  if (materialIsValid)
    material = g_SurfaceMaterials[MaterialBaseIndex + input.MaterialIndex];

  const bool isTwoSided = (material.Metadata.y & (1u << 10u)) != 0u;
  if (!isFrontFace && !isTwoSided)
    clip(-1.0f);

  float4 baseColor = max(material.BaseColorOpacity, 0.0f);
  float roughness = saturate(material.EmissiveColorAndRoughness.w);
  float metallic = saturate(material.SurfaceParameters.x);

  if (material.TextureIndices0.x != 0xFFFFFFFFu)
    baseColor *= max(g_Textures[NonUniformResourceIndex(material.TextureIndices0.x)].Sample(LinearSampler, input.TexCoord), 0.0f);
  if (material.TextureIndices0.z != 0xFFFFFFFFu)
  {
    const float4 metallicRoughness = g_Textures[NonUniformResourceIndex(material.TextureIndices0.z)].Sample(LinearSampler, input.TexCoord);
    roughness *= metallicRoughness.g;
    metallic *= metallicRoughness.b;
  }
  if (material.Metadata.z == 1u)
    clip(baseColor.a - material.LayerParameters.x);

  float3 N = normalize(input.WorldNormal) * (isFrontFace ? 1.0f : -1.0f);
  if (material.TextureIndices0.y != 0xFFFFFFFFu)
  {
    float3 tangentNormal = g_Textures[NonUniformResourceIndex(material.TextureIndices0.y)].Sample(LinearSampler, input.TexCoord).xyz * 2.0f - 1.0f;
    tangentNormal.xy *= material.LayerParameters.y;
    tangentNormal.z = sqrt(saturate(1.0f - dot(tangentNormal.xy, tangentNormal.xy)));
    const float3 T = normalize(input.WorldTangent);
    const float3 B = cross(N, T) * (input.TangentSign < 0.0f ? -1.0f : 1.0f);
    N = normalize(T * tangentNormal.x + B * tangentNormal.y + N * tangentNormal.z);
  }

  const float2 uv = input.Position.xy * InvRenderSize;
  const uint2 pixel = uint2(input.Position.xy);
  const float3 V = normalize(g_CameraPositionAndNearPlane.xyz - input.WorldPosition);
  const float3 mainL = normalize(-g_MainLightDirectionAndIntensity.xyz);
  const float cascadeShadow = EvaluateDirectionalShadow(input.WorldPosition, N, mainL, LinearizeDepth(input.Position.z));
  const float cloudShadow = EvaluateCloudShadow(input.WorldPosition, mainL);
  const float screenShadow = saturate(1.0f - max(g_RTShadow.SampleLevel(PointClampSampler, uv, 0), g_ContactShadow.SampleLevel(PointClampSampler, uv, 0)));
  const float primaryShadow = cascadeShadow * cloudShadow * screenShadow;
  float3 direct = BRDF(baseColor.rgb, max(roughness, 0.01f), metallic, saturate(material.SurfaceParameters.y), N, mainL, V) *
                  g_MainLightColor.rgb * g_MainLightDirectionAndIntensity.w * primaryShadow;

  const uint directionalLightCount = min((uint)(g_MainLightColor.w + 0.5f), g_ActiveLightCount);
  [loop] for (uint directionalIndex = 1u; directionalIndex < directionalLightCount; ++directionalIndex)
  {
    const xiiGpuLightData lightData = g_Lights[directionalIndex];
    if (GetLightType(lightData) != XII_LIGHT_TYPE_DIRECTIONAL)
      break;
    const float3 L = normalize(-lightData.DirectionAndType.xyz);
    direct += BRDF(baseColor.rgb, max(roughness, 0.01f), metallic, saturate(material.SurfaceParameters.y), N, L, V) *
              lightData.ColorAndIntensity.rgb * lightData.ColorAndIntensity.w;
  }

  const xiiReSTIRDIReservoir reservoir = ReSTIRUnpackReservoir(g_DirectLightReservoir.Load(int3(pixel, 0)));
  if (ReSTIRValidateReservoir(reservoir))
  {
    const xiiGpuLightData lightData = g_Lights[reservoir.LightIndex];
    const float localShadow = EvaluateLocalShadow(reservoir.LightIndex, lightData, input.WorldPosition, N);
    direct += EvaluateLocalLight(lightData, input.WorldPosition, N, V, baseColor.rgb,
                                 max(roughness, 0.01f), metallic, saturate(material.SurfaceParameters.y)) * localShadow * reservoir.WeightSum;
  }
  else
  {
    const uint clusterIndex = ComputeClusterIndex(uv, input.Position.z);
    const uint2 lightRange = g_LightGrid[clusterIndex];
    const uint lightCount = min(lightRange.y, g_MaxLightsPerCluster);
    [loop] for (uint listIndex = 0u; listIndex < lightCount; ++listIndex)
    {
      const uint lightIndex = g_LightIndex[lightRange.x + listIndex];
      if (lightIndex >= g_ActiveLightCount)
        continue;
      const xiiGpuLightData lightData = g_Lights[lightIndex];
      if (GetLightType(lightData) != XII_LIGHT_TYPE_DIRECTIONAL)
      {
        const float localShadow = EvaluateLocalShadow(lightIndex, lightData, input.WorldPosition, N);
        direct += EvaluateLocalLight(lightData, input.WorldPosition, N, V, baseColor.rgb,
                                     max(roughness, 0.01f), metallic, saturate(material.SurfaceParameters.y)) * localShadow;
      }
    }
  }

  // Material and screen-space AO belong to the indirect-lighting path. Keeping
  // them out of this result preserves photometric direct-light energy.
  return float4(direct, 1.0f);
}
