[PLATFORMS]
ALL

[COMPUTE_SHADER]

// Motion-aware temporal accumulation of the integrated volumetric signal. History is kept at
// render resolution because integration has already collapsed the froxel depth axis.

#include "PipelineCommon.xiiShader"
#include "Passes/Volumetrics/VolumetricTemporalConstants.h"

Texture2D<float4>   g_FroxelCurrent  : register(t4);
Texture2D<float4>   g_FroxelHistory  : register(t5);
Texture2D<float>    g_SceneDepth     : register(t6);
Texture2D<float2>   g_GBufferNormal  : register(t7);
Texture2D<float2>   g_Velocity       : register(t8);
Texture2D<float4>   g_PreviousSurface : register(t9);
RWTexture2D<float4> g_FroxelBlended  : register(u10);

float4 LoadCurrent(int2 pixel, uint2 dimensions)
{
  return g_FroxelCurrent.Load(int3(clamp(pixel, int2(0, 0), int2(dimensions) - 1), 0));
}

[numthreads(8, 8, 1)]
void main(uint3 dispatchThreadId : SV_DispatchThreadID)
{
  uint2 dimensions;
  g_FroxelBlended.GetDimensions(dimensions.x, dimensions.y);
  if (any(dispatchThreadId.xy >= dimensions))
    return;

  const uint2 pixel = dispatchThreadId.xy;
  const float depth = g_SceneDepth.Load(int3(pixel, 0));
  float4 current = LoadCurrent(int2(pixel), dimensions);

  float4 localMinimum = current;
  float4 localMaximum = current;
  float4 spatialSum = current;
  float spatialSamples = 1.0f;
  const float3 normal = depth > 0.0f ? DecodeOctNormal(g_GBufferNormal.Load(int3(pixel, 0))) : float3(0.0f, 0.0f, 1.0f);
  const float linearDepth = depth > 0.0f ? LinearizeDepth(depth) : 0.0f;

  [unroll]
  for (int y = -1; y <= 1; ++y)
  {
    [unroll]
    for (int x = -1; x <= 1; ++x)
    {
      if (x == 0 && y == 0)
        continue;

      const int2 samplePixel = clamp(int2(pixel) + int2(x, y), int2(0, 0), int2(dimensions) - 1);
      const float sampleDepth = g_SceneDepth.Load(int3(samplePixel, 0));
      if ((depth > 0.0f) != (sampleDepth > 0.0f))
        continue;

      if (depth > 0.0f)
      {
        const float sampleLinearDepth = LinearizeDepth(sampleDepth);
        const float3 sampleNormal = DecodeOctNormal(g_GBufferNormal.Load(int3(samplePixel, 0)));
        if (abs(sampleLinearDepth - linearDepth) > max(linearDepth * DepthThreshold, 0.01f) || dot(sampleNormal, normal) < NormalThreshold)
          continue;
      }

      const float4 sample = LoadCurrent(samplePixel, dimensions);
      localMinimum = min(localMinimum, sample);
      localMaximum = max(localMaximum, sample);
      spatialSum += sample;
      spatialSamples += 1.0f;
    }
  }

  current = lerp(current, spatialSum / spatialSamples, saturate(SpatialWeight));
  if (HistoryValid == 0U)
  {
    g_FroxelBlended[pixel] = current;
    return;
  }

  const float2 uv = (float2(pixel) + 0.5f) / float2(dimensions);
  float2 previousUV;
  if (depth > 0.0f)
  {
    const float2 velocity = g_Velocity.Load(int3(pixel, 0));
    previousUV = uv - velocity * float2(0.5f, -0.5f);
  }
  else
  {
    const float farDeviceDepth = g_CameraPositionAndNearPlane.w / max(g_CameraForwardAndFarPlane.w, g_CameraPositionAndNearPlane.w);
    const float3 farWorldPosition = ReconstructWorldPos(uv, farDeviceDepth);
    const float4 previousClip = mul(PreviousViewProjectionMatrix, float4(farWorldPosition, 1.0f));
    if (previousClip.w <= 1e-5f)
    {
      g_FroxelBlended[pixel] = current;
      return;
    }

    const float2 previousNDC = previousClip.xy / previousClip.w;
    previousUV = float2(previousNDC.x * 0.5f + 0.5f, -previousNDC.y * 0.5f + 0.5f);
  }

  if (any(previousUV <= 0.0f) || any(previousUV >= 1.0f))
  {
    g_FroxelBlended[pixel] = current;
    return;
  }

  const uint2 previousPixel = min((uint2)(previousUV * float2(dimensions)), dimensions - 1U);
  const float4 previousSurface = g_PreviousSurface.Load(int3(previousPixel, 0));
  const float3 previousNormal = DecodeOctNormal(previousSurface.xy);
  const bool surfaceMatches = depth <= 0.0f ? previousSurface.w <= 0.0f :
    previousSurface.w > 0.0f &&
      abs(previousSurface.z - linearDepth) <= max(linearDepth * DepthThreshold, 0.01f) &&
      dot(previousNormal, normal) >= NormalThreshold;
  if (!surfaceMatches)
  {
    g_FroxelBlended[pixel] = current;
    return;
  }

  const float4 history = clamp(g_FroxelHistory.Load(int3(previousPixel, 0)), localMinimum, localMaximum);
  g_FroxelBlended[pixel] = lerp(current, history, saturate(HistoryWeight));
}
