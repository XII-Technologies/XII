[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTESHADER]

#include "PipelineCommon.xiiShader"
#include "LightingData.h"

cbuffer xiiLightClusteringConstants : register(b3)
{
    uint  ClusterCountX;
    uint  ClusterCountY;
    uint  ClusterCountZ;
    uint  TotalClusters;
    float NearPlane;
    float FarPlane;
    float LogFarOverNear;
    float Padding1;
    uint  TilePixelsX;
    uint  TilePixelsY;
    uint  MaxLightsPerCluster;
    uint  ActiveLightCount;
};

StructuredBuffer<xiiClusterDescriptor> g_Clusters   : register(t0);
StructuredBuffer<xiiGpuLightData>      g_Lights     : register(t1);
RWStructuredBuffer<uint>               g_LightIndex : register(u0);
RWStructuredBuffer<uint2>              g_LightGrid  : register(u1);

bool SphereIntersectsAabb(float4 sphere, float3 aabbMin, float3 aabbMax)
{
    const float3 closest = clamp(sphere.xyz, aabbMin, aabbMax);
    const float3 delta = closest - sphere.xyz;
    return dot(delta, delta) <= sphere.w * sphere.w;
}

[numthreads(64, 1, 1)]
void CS_LightListBuild(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    const uint clusterIndex = dispatchThreadId.x;
    if (clusterIndex >= TotalClusters)
        return;

    const xiiClusterDescriptor cluster = g_Clusters[clusterIndex];
    const uint listOffset = clusterIndex * MaxLightsPerCluster;
    uint localCount = 0u;

    [loop]
    for (uint lightIndex = 0u; lightIndex < ActiveLightCount; ++lightIndex)
    {
        const xiiGpuLightData lightData = g_Lights[lightIndex];
        const uint lightType = GetLightType(lightData);

        if (lightType == XII_LIGHT_TYPE_DIRECTIONAL)
            continue;

        if (!SphereIntersectsAabb(lightData.BoundsCenterAndRadius, cluster.MinBounds.xyz, cluster.MaxBounds.xyz))
            continue;

        if (localCount < MaxLightsPerCluster)
        {
            g_LightIndex[listOffset + localCount] = lightIndex;
            ++localCount;
        }
    }

    g_LightGrid[clusterIndex] = uint2(listOffset, localCount);
}
