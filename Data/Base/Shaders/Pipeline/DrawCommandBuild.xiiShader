// Compacts extracted indexed draw ranges for packets that survived visibility culling.
[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTE_SHADER]

#include <Shaders/Pipeline/Passes/Visibility/DrawCommandBuildConstants.h>

struct DrawIndexedIndirectCommand
{
  uint IndexCountPerInstance;
  uint InstanceCount;
  uint StartIndexLocation;
  int BaseVertexLocation;
  uint StartInstanceLocation;
};

StructuredBuffer<uint> g_Survivors; // [0] = count, [1..] = packet indices.
StructuredBuffer<uint> g_InstanceLOD;
StructuredBuffer<DrawIndexedIndirectCommand> g_SourceCommands;
RWStructuredBuffer<DrawIndexedIndirectCommand> g_DrawArgs;
RWStructuredBuffer<uint> g_DrawCounts;

[numthreads(64, 1, 1)]
void main(uint3 dispatchThreadId : SV_DispatchThreadID)
{
  const uint visibleIndex = dispatchThreadId.x;
  const uint visibleCount = min(g_Survivors[0], InstanceCount);
  if (visibleIndex >= visibleCount)
    return;

  const uint instanceIndex = g_Survivors[visibleIndex + 1u];
  if (instanceIndex >= InstanceCount)
    return;

  const uint lodLevel = g_InstanceLOD[instanceIndex] & 0xFFu;
  if (lodLevel == 0xFFu)
    return;

  uint destination;
  InterlockedAdd(g_DrawCounts[0], 1u, destination);
  if (destination >= MaxCommandCount)
    return;

  g_DrawArgs[destination] = g_SourceCommands[instanceIndex];
}
