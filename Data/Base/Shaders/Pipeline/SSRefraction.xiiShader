// XII Engine - SSRefraction.xiiShader
// Stage 9: Screen-Space Refraction.
// Computes a perturbed screen-space UV from the GBuffer normal and IOR, then
// samples the opaque scene color behind the refractive surface and blends it in.
// Dispatch: ceil(W/8) × ceil(H/8) × 1.

[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTE_SHADER]

#include <Shaders/Pipeline/PipelineCommon.xiiShader>
#include <Shaders/Pipeline/Passes/Refraction/SSRefractionConstants.h>

Texture2D<float>    g_SceneDepth;   // reversed-Z surface depth
Texture2D<float2>   g_GBufNormal;   // oct-encoded world normals
Texture2D<float4>   g_GBufMaterial; // alpha stores the normalized material-feature byte
Texture2D<float4>   g_HDRIn;        // immutable scene snapshot sampled behind the surface
RWTexture2D<float4> g_HDROut;       // authoritative scene output

static const uint MATERIAL_FEATURE_TRANSMISSION = 1u << 6u;

[numthreads(8, 8, 1)]
void main(uint3 tid : SV_DispatchThreadID)
{
    uint2 dims;
    g_HDROut.GetDimensions(dims.x, dims.y);
    if (any(tid.xy >= dims)) return;

    const float2 uv    = (float2(tid.xy) + 0.5f) / float2(dims);
    const float  depth = g_SceneDepth.Load(int3(tid.xy, 0));

    // The material target is RGBA8 UNORM. Alpha contains the material-feature
    // byte normalized to [0, 1], matching xiiMaterialFeatureFlags.
    const uint materialFlags = (uint)round(saturate(g_GBufMaterial.Load(int3(tid.xy, 0)).a) * 255.0f);
    if (depth <= 0.0f || (materialFlags & MATERIAL_FEATURE_TRANSMISSION) == 0u)
    {
        g_HDROut[tid.xy] = g_HDRIn.Load(int3(tid.xy, 0));
        return;
    }

    // Decode world-space normal.
    const float3 worldNormal = DecodeOctNormal(g_GBufNormal.Load(int3(tid.xy, 0)));

    // Project an offset world-space point instead of treating a direction as a
    // position. This remains correct for arbitrary camera orientation.
    const float3 worldPosition = ReconstructWorldPos(uv, depth);
    const float4 surfaceClip   = mul(g_ViewProjectionMatrix, float4(worldPosition, 1.0f));
    const float4 normalClip    = mul(g_ViewProjectionMatrix, float4(worldPosition + worldNormal, 1.0f));
    const float2 surfaceNDC    = surfaceClip.xy / max(surfaceClip.w, 1e-6f);
    const float2 normalNDC     = normalClip.xy / max(normalClip.w, 1e-6f);
    const float2 projectedNormal = float2(normalNDC.x - surfaceNDC.x, surfaceNDC.y - normalNDC.y);
    const float projectedLengthSq = dot(projectedNormal, projectedNormal);
    const float2 perturbDir = projectedLengthSq > 1e-8f ? projectedNormal * rsqrt(projectedLengthSq) : 0.0f;

    // Scale offset by depth so deeper water refracts less (underwater bending).
    float linearDepth = LinearizeDepth(depth);
    float strength    = PerturbScale / (1.0f + linearDepth * 0.5f);

    float2 offset = perturbDir * strength;
    offset = clamp(offset, float2(-MaxDistance, -MaxDistance),
                            float2( MaxDistance,  MaxDistance));

    float2 refractUV = uv + offset;

    // Reject if refracted UV lands on a forepground surface closer than the refractor.
    float backDepth = g_SceneDepth.SampleLevel(g_sLinearClamp, refractUV, 0);
    if (backDepth > depth)
    {
        // Refracted sample is in front of the refractive surface - fall back to un-perturbed UV.
        refractUV = uv;
    }

    // Chromatic aberration: sample RGB channels at slightly different offsets.
    float2 rUV = refractUV + offset * Chromatic;
    float2 gUV = refractUV;
    float2 bUV = refractUV - offset * Chromatic;

    rUV = clamp(rUV, 0.0f, 1.0f);
    gUV = clamp(gUV, 0.0f, 1.0f);
    bUV = clamp(bUV, 0.0f, 1.0f);

    float3 refractColor;
    refractColor.r = g_HDRIn.SampleLevel(g_sLinearClamp, rUV, 0).r;
    refractColor.g = g_HDRIn.SampleLevel(g_sLinearClamp, gUV, 0).g;
    refractColor.b = g_HDRIn.SampleLevel(g_sLinearClamp, bUV, 0).b;

    // Write refracted colour back (the surface's forward pass will blend specular on top).
    g_HDROut[tid.xy] = float4(refractColor, 1.0f);
}
