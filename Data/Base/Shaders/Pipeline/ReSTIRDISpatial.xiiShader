// XII Engine - ReSTIR DI edge-aware spatial reservoir reuse.

[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTE_SHADER]

#include <Shaders/Common/StorageImageFormat.h>

#include <Shaders/Pipeline/PipelineCommon.xiiShader>
#include <Shaders/Pipeline/LightingData.h>
#include <Shaders/Pipeline/GBufferMaterial.h>

StructuredBuffer<xiiGpuLightData> g_Lights;

#include <Shaders/Pipeline/ReSTIRDICommon.h>

Texture2D<float>       g_SceneDepth;
Texture2D<float4>      g_GBufferAlbedo;
Texture2D<float2>      g_GBufferNormal;
Texture2D<float4>      g_GBufferMaterial;
Texture2D<float4>      g_GBufferEmissive;
Texture2D<uint4>       g_TemporalReservoir;
RWTexture2D<uint4>     g_ReservoirOut;
XII_STORAGE_IMAGE_FORMAT("rgba16f") RWTexture2D<float4>    g_SurfaceOut;

static const int2 XII_RESTIR_NEIGHBOR_OFFSETS[8] =
{
  int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1),
  int2(-1, -1), int2(1, 1), int2(-1, 1), int2(1, -1)
};

[numthreads(8, 8, 1)]
void main(uint3 dispatchThreadId : SV_DispatchThreadID)
{
  uint2 dimensions;
  g_ReservoirOut.GetDimensions(dimensions.x, dimensions.y);
  if (any(dispatchThreadId.xy >= dimensions))
    return;

  const uint2 pixel = dispatchThreadId.xy;
  const float2 uv = (float2(pixel) + 0.5f) / float2(dimensions);
  const float depth = g_SceneDepth.Load(int3(pixel, 0));
  if (depth <= 0.0f)
  {
    g_ReservoirOut[pixel] = ReSTIRPackReservoir(ReSTIREmptyReservoir());
    g_SurfaceOut[pixel] = 0.0f;
    return;
  }

  const float2 encodedNormal = g_GBufferNormal.Load(int3(pixel, 0));
  const float3 normal = DecodeOctNormal(encodedNormal);
  const float4 albedo = g_GBufferAlbedo.Load(int3(pixel, 0));
  const float4 material = g_GBufferMaterial.Load(int3(pixel, 0));
  if (!xiiGBufferReceivesLighting(material))
  {
    g_ReservoirOut[pixel] = ReSTIRPackReservoir(ReSTIREmptyReservoir());
    g_SurfaceOut[pixel] = 0.0f;
    return;
  }
  const uint materialFlags = xiiGBufferMaterialFlags(material.a);
  const float transmission = (materialFlags & (1u << 6u)) != 0u ? saturate(g_GBufferEmissive.Load(int3(pixel, 0)).a) : 0.0f;
  const xiiReSTIRDISurface surface = ReSTIRMakeSurface(albedo.rgb, material.r, material.g, material.b, transmission);
  const float3 worldPosition = ReconstructWorldPos(uv, depth);
  const float linearDepth = LinearizeDepth(depth);
  uint randomState = ReSTIRHash(pixel.x + pixel.y * dimensions.x + g_FrameIndex * 0x85EBCA6Bu);

  xiiReSTIRDIReservoir source = ReSTIRUnpackReservoir(g_TemporalReservoir.Load(int3(pixel, 0)));
  xiiReSTIRDIReservoir reservoir = ReSTIREmptyReservoir();
  if (ReSTIRValidateReservoir(source))
  {
    // Keep part of the bounded reservoir budget available for neighbours even
    // after temporal history has reached its maximum effective age.
    const uint sourceM = min(source.M, 16u);
    const float target = ReSTIREstimateSampleTarget(source.SampleIndex, worldPosition, normal, surface);
    ReSTIRUpdateReservoir(reservoir, source.SampleIndex, source.StableLightId, source.SampleRevision,
                          source.Visibility, source.VisibilityValid,
                          target * source.WeightSum * (float)sourceM, sourceM, randomState);
  }

  const uint rotation = ReSTIRHash(randomState) & 7u;
  const uint neighborCount = clamp(g_ReSTIRDIReuseSettings.z, 1u, 8u);
  const uint spatialRadius = clamp(g_ReSTIRDIReuseSettings.w, 1u, 8u);
  [loop]
  for (uint tap = 0u; tap < neighborCount; ++tap)
  {
    const uint tapRadius = 1u + (ReSTIRHash(randomState ^ (tap * 0x9E3779B9u)) % spatialRadius);
    const int2 neighborPixel = int2(pixel) + XII_RESTIR_NEIGHBOR_OFFSETS[(rotation + tap) & 7u] * (int)tapRadius;
    if (any(neighborPixel < 0) || any(neighborPixel >= int2(dimensions)))
      continue;

    const float neighborDepth = g_SceneDepth.Load(int3(neighborPixel, 0));
    if (neighborDepth <= 0.0f)
      continue;

    const float3 neighborNormal = DecodeOctNormal(g_GBufferNormal.Load(int3(neighborPixel, 0)));
    const float neighborRoughness = g_GBufferMaterial.Load(int3(neighborPixel, 0)).r;
    const float neighborLinearDepth = LinearizeDepth(neighborDepth);
    if (abs(neighborLinearDepth - linearDepth) > max(linearDepth * 0.08f, 0.02f) || dot(neighborNormal, normal) < 0.85f ||
        abs(neighborRoughness - surface.Roughness) > 0.2f)
      continue;

    xiiReSTIRDIReservoir neighbor = ReSTIRUnpackReservoir(g_TemporalReservoir.Load(int3(neighborPixel, 0)));
    if (!ReSTIRValidateReservoir(neighbor))
      continue;

    const uint neighborM = min(neighbor.M, 8u);
    const float target = ReSTIREstimateSampleTarget(neighbor.SampleIndex, worldPosition, normal, surface);
    ReSTIRUpdateReservoir(reservoir, neighbor.SampleIndex, neighbor.StableLightId, neighbor.SampleRevision,
      1.0f, 0u, target * neighbor.WeightSum * (float)neighborM, neighborM, randomState);
  }

  const float selectedTarget = ReSTIREstimateSampleTarget(reservoir.SampleIndex, worldPosition, normal, surface);
  ReSTIRFinalizeReservoir(reservoir, selectedTarget);
  g_ReservoirOut[pixel] = ReSTIRPackReservoir(reservoir);
  g_SurfaceOut[pixel] = float4(encodedNormal, linearDepth, surface.Roughness);
}
