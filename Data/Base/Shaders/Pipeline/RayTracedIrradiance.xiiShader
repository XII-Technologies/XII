[PLATFORMS]
ALL
[SHADER]
#include <Shaders/Pipeline/Passes/ScreenSpaceGeometry.h>
#include <Shaders/Pipeline/Passes/GlobalIllumination/RayTracedIrradianceConstants.h>
#include <Shaders/Pipeline/Passes/RayTracing/RayTracingMaterialData.h>
struct IrradiancePayload
{
  float3 Radiance;
  uint Depth;
  float ConeWidth, ConeSpread;
  uint Random, Flags;
};
static const uint XII_IRRADIANCE_VISIBILITY_RAY = 1u;
uint IrradianceHash(uint value)
{
  value ^= value >> 16; value *= 0x7feb352du;
  value ^= value >> 15; value *= 0x846ca68bu;
  return value ^ (value >> 16);
}
float IrradianceRandom(inout uint state)
{
  state = IrradianceHash(state);
  return float(state & 0x00ffffffu) / 16777216.0f;
}
float3 IrradianceDirection(float3 normal, float2 xi)
{
  const float3 up = abs(normal.z) < 0.999f ? float3(0,0,1) : float3(1,0,0);
  const float3 tangent = normalize(cross(up,normal)), bitangent = cross(normal,tangent);
  const float radius = sqrt(xi.x), phi = 6.28318530718f * xi.y;
  return tangent * (radius * cos(phi)) + bitangent * (radius * sin(phi)) + normal * sqrt(1-xi.x);
}
[RAY_GENERATION_SHADER]
#include <Shaders/Common/StorageImageFormat.h>
RaytracingAccelerationStructure g_Scene;
Texture2D<float> g_Depth;
Texture2D<float2> g_Normal;
XII_STORAGE_IMAGE_FORMAT("rgba32f") RWTexture2D<float4> g_Irradiance;
[shader("raygeneration")]
void main()
{
  const uint2 pixel = DispatchRaysIndex().xy, extent = DispatchRaysDimensions().xy;
  const float depth = g_Depth.Load(int3(pixel,0));
  float3 position;
  const float2 uv = (float2(pixel)+0.5f)/float2(extent);
  if (!isfinite(depth) || depth <= 0 || depth > 1 || !xiiScreenWorldPosition(uv,depth,position))
  { g_Irradiance[pixel] = 0; return; }
  const float3 normal = xiiScreenNormal(g_Normal.Load(int3(pixel,0)));
  if (!all(isfinite(normal)) || dot(normal,normal)<0.5f)
  { g_Irradiance[pixel] = 0; return; }
  const float2 neighbourUV = uv + float2(pixel.x+1<extent.x ? 1.0f : -1.0f,0)/float2(extent);
  float3 neighbour;
  const float footprint = xiiScreenWorldPosition(neighbourUV,depth,neighbour) ? length(neighbour-position) : 0;
  float3 radiance = 0;
  [loop] for (uint sampleIndex=0; sampleIndex<PathSamples.x; ++sampleIndex)
  {
    IrradiancePayload payload;
    payload.Radiance=0; payload.Depth=0; payload.Flags=0;
    payload.Random=IrradianceHash(pixel.x+pixel.y*extent.x+(PathSamples.z+sampleIndex+1)*0x9e3779b9u);
    payload.ConeWidth=footprint;
    payload.ConeSpread=footprint/max(length(position-SurfaceCameraPositionNear.xyz),1e-3f);
    const float first=IrradianceRandom(payload.Random);
    const float2 xi=float2(first,IrradianceRandom(payload.Random));
    RayDesc ray;
    ray.Origin=position+normal*RayDistances.y;
    ray.Direction=IrradianceDirection(normal,xi);
    ray.TMin=0.001f; ray.TMax=RayDistances.x;
    TraceRay(g_Scene,0,0xff,0,1,0,ray,payload);
    radiance+=payload.Radiance;
  }
  // Cosine-weighted incident irradiance, before the primary receiver's BRDF.
  const float3 result=radiance*(3.14159265359f/float(PathSamples.x));
  g_Irradiance[pixel]=float4(all(isfinite(result)) ? max(result,0) : 0,1);
}
[RAY_MISS_SHADER]
[shader("miss")]
void main(inout IrradiancePayload payload)
{
  // The ordinary environment consumer owns sky illumination. Scene-only transport
  // must not count that boundary condition again on an escaped path.
  payload.Radiance=(payload.Flags & XII_IRRADIANCE_VISIBILITY_RAY)!=0 ? 1.0f : 0.0f;
}
[RAY_CLOSEST_HIT_SHADER]
RaytracingAccelerationStructure g_Scene;
StructuredBuffer<xiiRayTracingMaterialData> g_RayTracingMaterials;
StructuredBuffer<xiiRayTracingGeometryData> g_RayTracingGeometry;
ByteAddressBuffer g_RayTracingBuffers[];
Texture2D<float4> g_RayTracingTextures[];
SamplerState g_sAnisotropicWrap;
#include <Shaders/Pipeline/Passes/RayTracing/RayTracingSurface.h>
#define XII_BRDF_VIEW_MODE ViewRenderMode_DiffuseOnly
#include <Shaders/Pipeline/SurfaceLocalLight.h>
#include <Shaders/Pipeline/Passes/RayTracing/RayTracingEmitterSampling.h>
StructuredBuffer<xiiGpuLightData> g_Lights;
StructuredBuffer<uint4> g_LightCounts;
StructuredBuffer<uint> g_LightCandidates;
#include <Shaders/Pipeline/Passes/GlobalIllumination/LightPowerSampling.h>

float IrradianceVisibility(float3 position, float3 normal, float3 direction, float maximumDistance, float coneWidth)
{
  if (maximumDistance<=0.001f) return 1;
  RayDesc ray;
  ray.Origin=position+normal*RayDistances.y;
  ray.Direction=direction;
  ray.TMin=0.001f; ray.TMax=maximumDistance;
  IrradiancePayload visibility;
  visibility.Radiance=0; visibility.Depth=0; visibility.Random=0;
  visibility.Flags=XII_IRRADIANCE_VISIBILITY_RAY;
  visibility.ConeWidth=coneWidth; visibility.ConeSpread=0;
  // Force any-hit for ordinary opaque meshes too: shadow-casting policy and
  // alpha cutouts are evaluated independently of diffuse path intersections.
  TraceRay(g_Scene,RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH | RAY_FLAG_SKIP_CLOSEST_HIT_SHADER | RAY_FLAG_FORCE_NON_OPAQUE,
    0xff,0,1,0,ray,visibility);
  return visibility.Radiance.x;
}

float3 IrradianceAnalyticLighting(xiiRayTracingSurface surface, xiiRayTracingMaterialData material,
  float3 position, float3 viewDirection, float coneWidth, inout uint randomState)
{
  uint recordCount, recordStride, candidateCount, candidateStride;
  g_Lights.GetDimensions(recordCount,recordStride);
  g_LightCandidates.GetDimensions(candidateCount,candidateStride);
  const uint activeCount=min(g_LightCounts[0].x,recordCount);
  if (activeCount==0 || PathSamples.w==0) return 0;
  const uint sampleCount=min(PathSamples.w,candidateCount);
  float3 result=0;
  // Use the complete view-eligible domain, not a primary receiver's screen
  // cluster. The GPU power distribution retains a uniform support component.
  [loop] for(uint sampleIndex=0;sampleIndex<sampleCount;++sampleIndex)
  {
    const float sample=(float(sampleIndex)+IrradianceRandom(randomState))/float(sampleCount);
    float probability;
    const uint candidate=IrradianceSelectLight(sample,candidateCount,randomState,probability);
    const uint index=g_LightCandidates[candidate];
    if(index>=activeCount) continue;
    const xiiGpuLightData light=g_Lights[index];
    const uint type=GetLightType(light);
    float3 direction, contribution;
    float maximumDistance=RayDistances.x;
    if(type==XII_LIGHT_TYPE_DIRECTIONAL)
    {
      direction=normalize(-light.DirectionAndType.xyz);
      contribution=BRDFLayered(saturate(surface.BaseColor),surface.Roughness,surface.Metallic,saturate(material.SurfaceParameters.y),
        surface.Transmission,surface.ClearCoat,surface.ClearCoatRoughness,surface.Normal,direction,viewDirection)*
        max(light.ColorAndIntensity.rgb*light.ColorAndIntensity.w,0);
    }
    else if(type>=XII_LIGHT_TYPE_POINT && type<=XII_LIGHT_TYPE_TUBE)
    {
      const float first=IrradianceRandom(randomState);
      const float2 xi=float2(first,IrradianceRandom(randomState));
      float3 emitter; float projectedArea;
      xiiSampleRayTracingLocalEmitter(light,position,xi,emitter,projectedArea);
      const float3 toEmitter=emitter-position;
      const float distance=length(toEmitter);
      if(distance<=0.001f) continue;
      direction=toEmitter/distance;
      maximumDistance=max(distance-2*RayDistances.y,0.001f);
      if(type>=XII_LIGHT_TYPE_RECTANGLE)
        contribution=EvaluateAreaLightSample(light,emitter,projectedArea,position,surface.Normal,viewDirection,
          saturate(surface.BaseColor),surface.Roughness,surface.Metallic,saturate(material.SurfaceParameters.y),
          surface.Transmission,surface.ClearCoat,surface.ClearCoatRoughness);
      else
      {
        xiiGpuLightData sampled=light;
        sampled.PositionAndInvRange.xyz=emitter;
        contribution=EvaluateLocalLightLayered(sampled,position,surface.Normal,viewDirection,saturate(surface.BaseColor),
          surface.Roughness,surface.Metallic,saturate(material.SurfaceParameters.y),surface.Transmission,surface.ClearCoat,surface.ClearCoatRoughness);
      }
    }
    else continue;
    if(dot(surface.Normal,direction)<=0 || !any(contribution>0)) continue;
    const float visibility=light.ShadowData.x>0.5f ? IrradianceVisibility(position,surface.Normal,direction,maximumDistance,coneWidth) : 1;
    result+=contribution*visibility/(float(sampleCount)*probability);
  }
  return result*surface.Occlusion;
}
[shader("closesthit")]
void main(inout IrradiancePayload payload, in BuiltInTriangleIntersectionAttributes attributes)
{
  const xiiRayTracingMaterialData material=g_RayTracingMaterials[InstanceIndex()];
  const xiiRayTracingSurface surface=xiiLoadRayTracingSurface(InstanceIndex(),PrimitiveIndex(),attributes.barycentrics,payload.ConeWidth,payload.ConeSpread);
  payload.Radiance=surface.Emission;
  // Emission is independent of receiving illumination. Unlit/nonreceiving hits
  // terminate the diffuse path without inventing reflected light.
  if (material.Metadata.z==6u || (material.Metadata.w & 4096u)==0 || !all(isfinite(surface.Normal)) || dot(surface.Normal,surface.Normal)<0.5f) return;
  const float3 position=WorldRayOrigin()+WorldRayDirection()*RayTCurrent();
  const float coneWidth=max(payload.ConeWidth+RayTCurrent()*payload.ConeSpread,1e-6f);
  payload.Radiance+=IrradianceAnalyticLighting(surface,material,position,normalize(-WorldRayDirection()),coneWidth,payload.Random);
  if(payload.Depth+1>=PathSamples.y) return;
  IrradiancePayload child=payload;
  child.Radiance=0; child.Depth++;
  child.ConeWidth=max(payload.ConeWidth+RayTCurrent()*payload.ConeSpread,1e-6f);
  child.ConeSpread=max(payload.ConeSpread,0.25f);
  const float first=IrradianceRandom(child.Random);
  const float2 xi=float2(first,IrradianceRandom(child.Random));
  RayDesc ray;
  ray.Origin=position+surface.Normal*RayDistances.y;
  ray.Direction=IrradianceDirection(surface.Normal,xi);
  ray.TMin=0.001f; ray.TMax=RayDistances.x;
  const float cosine=max(dot(surface.Normal,ray.Direction),1e-6f);
  const float3 response=BRDFLayered(saturate(surface.BaseColor),surface.Roughness,surface.Metallic,saturate(material.SurfaceParameters.y),
    surface.Transmission,surface.ClearCoat,surface.ClearCoatRoughness,surface.Normal,ray.Direction,normalize(-WorldRayDirection()));
  TraceRay(g_Scene,0,0xff,0,1,0,ray,child);
  payload.Radiance+=response*(3.14159265359f/cosine)*surface.Occlusion*child.Radiance;
}
[RAY_ANY_HIT_SHADER]
StructuredBuffer<xiiRayTracingMaterialData> g_RayTracingMaterials;
StructuredBuffer<xiiRayTracingGeometryData> g_RayTracingGeometry;
ByteAddressBuffer g_RayTracingBuffers[];
Texture2D<float4> g_RayTracingTextures[];
SamplerState g_sAnisotropicWrap;
#include <Shaders/Pipeline/Passes/RayTracing/RayTracingAlphaTest.h>
[shader("anyhit")]
void main(inout IrradiancePayload payload, in BuiltInTriangleIntersectionAttributes attributes)
{
  if((payload.Flags & XII_IRRADIANCE_VISIBILITY_RAY)!=0 && (g_RayTracingMaterials[InstanceIndex()].Metadata.w & 8192u)==0)
  { IgnoreHit(); return; }
  if(xiiShouldIgnoreRayTracingHitWithRayCone(InstanceIndex(),PrimitiveIndex(),attributes.barycentrics,payload.ConeWidth+RayTCurrent()*payload.ConeSpread)) IgnoreHit();
}
