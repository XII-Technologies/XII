[PLATFORMS]
ALL

[SHADER]

// Hardware ray-traced reflection visibility. The first production slice deliberately keeps
// closest-hit shading compact: it proves the TLAS/SBT/dispatch path and returns a validity mask
// that the hybrid reflection composite can blend with SSR and reflection probes.

#include "PipelineCommon.xiiShader"

struct xiiReflectionPayload
{
  float3 Radiance;
  float  Confidence;
};

[RAY_GENERATION_SHADER]

RaytracingAccelerationStructure g_RayTracingScene : register(t4);
Texture2D<float>                 g_SceneDepth      : register(t5);
Texture2D<float2>                g_GBufNormal      : register(t6);
Texture2D<float4>                g_GBufMaterial    : register(t7);
RWTexture2D<float4>              g_RTReflRaw       : register(u8);

[shader("raygeneration")]
void main()
{
  const uint2 pixel      = DispatchRaysIndex().xy;
  const uint2 dimensions = DispatchRaysDimensions().xy;
  const float  depth     = g_SceneDepth.Load(int3(pixel, 0));
  const float  roughness = saturate(g_GBufMaterial.Load(int3(pixel, 0)).r);

  float4 reflection = 0.0f;
  if (depth > 0.0f && roughness <= 0.65f)
  {
    const float2 uv       = (float2(pixel) + 0.5f) / float2(dimensions);
    const float3 worldPos = ReconstructWorldPos(uv, depth);
    const float3 normal   = DecodeOctNormal(g_GBufNormal.Load(int3(pixel, 0)));
    const float3 view     = normalize(g_CameraPositionAndNearPlane.xyz - worldPos);
    const float3 rayDir   = normalize(reflect(-view, normal));

    RayDesc ray;
    ray.Origin    = worldPos + normal * 0.01f;
    ray.Direction = rayDir;
    ray.TMin      = 0.001f;
    ray.TMax      = 500.0f;

    xiiReflectionPayload payload;
    payload.Radiance   = 0.0f;
    payload.Confidence = 0.0f;
    TraceRay(g_RayTracingScene, 0U, 0xFFU, 0U, 1U, 0U, ray, payload);

    // Rough surfaces smoothly hand back to probes/SSR rather than terminating abruptly.
    payload.Confidence *= saturate(1.0f - roughness / 0.65f);
    reflection = float4(max(payload.Radiance, 0.0f), payload.Confidence);
  }

  g_RTReflRaw[pixel] = reflection;
}

[RAY_MISS_SHADER]

[shader("miss")]
void main(inout xiiReflectionPayload payload)
{
  // A miss remains invalid so the hybrid composite resolves from SSR or the local/sky probe.
  payload.Radiance   = 0.0f;
  payload.Confidence = 0.0f;
}

[RAY_CLOSEST_HIT_SHADER]

[shader("closesthit")]
void main(inout xiiReflectionPayload payload, in BuiltInTriangleIntersectionAttributes attributes)
{
  // Material-aware hit shading is layered on top of this visibility path by the GPU material
  // records. Until those records are addressable from the SBT, return conservative scene-linear
  // radiance and a valid-hit mask rather than fabricating environment contribution on misses.
  const float barycentricEdge = min(attributes.barycentrics.x, attributes.barycentrics.y);
  payload.Radiance   = lerp(0.025f.xxx, 0.08f.xxx, saturate(barycentricEdge * 8.0f));
  payload.Confidence = 1.0f;
}
