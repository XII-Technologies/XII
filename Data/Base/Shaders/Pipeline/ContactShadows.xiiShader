// XII Engine - ContactShadows.xiiShader
// Screen-space contact shadows for the dominant directional light.

#include "PipelineCommon.xiiShader"

Texture2D<float>   g_SceneDepth       : register(t0);
RWTexture2D<float> g_ContactShadowOut : register(u0);

[numthreads(8, 8, 1)]
void CS_ContactShadow(uint3 tid : SV_DispatchThreadID)
{
    uint2 dims;
    g_ContactShadowOut.GetDimensions(dims.x, dims.y);
    if (any(tid.xy >= dims))
        return;

    const float2 uv = (float2(tid.xy) + 0.5f) / float2(dims);
    const float depth = g_SceneDepth.SampleLevel(g_sPointClamp, uv, 0);

    float shadow = 0.0f;
    if (depth > 0.0f && depth < 1.0f && g_MainLightDirectionAndIntensity.w > 0.0f)
    {
        const float3 worldPos = ReconstructWorldPos(uv, depth);
        const float3 lightDir = normalize(-g_MainLightDirectionAndIntensity.xyz);
        const uint stepCount = clamp(g_ContactShadowSteps, 4u, 64u);
        const float stepSize = g_ContactShadowLength / (float)stepCount;
        const float jitter = InterleavedGradientNoise((float2)tid.xy, g_FrameIndex);

        [loop]
        for (uint stepIndex = 0u; stepIndex < stepCount; ++stepIndex)
        {
            const float rayDistance = (float(stepIndex) + jitter + 1.0f) * stepSize;
            const float3 sampleWorldPos = worldPos + lightDir * rayDistance;
            const float4 clipPos = mul(g_ViewProjectionMatrix, float4(sampleWorldPos, 1.0f));

            if (clipPos.w <= 0.0f)
                break;

            const float2 sampleNdc = clipPos.xy / clipPos.w;
            const float2 sampleUv = sampleNdc * float2(0.5f, -0.5f) + 0.5f;
            if (any(sampleUv < 0.0f) || any(sampleUv > 1.0f))
                break;

            const float sampleDepth = g_SceneDepth.SampleLevel(g_sPointClamp, sampleUv, 0);
            const float rayDepth = clipPos.z / clipPos.w;

            if (sampleDepth > rayDepth + g_ContactShadowThickness)
            {
                const float fade = 1.0f - (float)stepIndex / (float)stepCount;
                shadow = saturate(fade);
                break;
            }
        }
    }

    g_ContactShadowOut[tid.xy] = shadow;
}
