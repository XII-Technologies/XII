[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTE_SHADER]

#include <Shaders/Pipeline/Passes/HiZPyramid/HiZBuildConstants.h>

Texture2D<float>   g_DepthSrc;
RWTexture2D<float> g_HiZOut;

[numthreads(8, 8, 1)]
void main(uint3 dispatchThreadId : SV_DispatchThreadID)
{
  if (any(dispatchThreadId.xy >= DstSize))
    return;

  if (Reduce == 0u)
  {
    g_HiZOut[dispatchThreadId.xy] = g_DepthSrc.Load(int3(dispatchThreadId.xy, 0));
    return;
  }

  const uint2 maximumSource = max(SrcSize, 1u) - 1u;
  const uint2 sourceBase = dispatchThreadId.xy * 2u;
  const uint2 p00 = min(sourceBase, maximumSource);
  const uint2 p10 = min(sourceBase + uint2(1u, 0u), maximumSource);
  const uint2 p01 = min(sourceBase + uint2(0u, 1u), maximumSource);
  const uint2 p11 = min(sourceBase + uint2(1u, 1u), maximumSource);

  const float depth00 = g_DepthSrc.Load(int3(p00, 0));
  const float depth10 = g_DepthSrc.Load(int3(p10, 0));
  const float depth01 = g_DepthSrc.Load(int3(p01, 0));
  const float depth11 = g_DepthSrc.Load(int3(p11, 0));

  // Scene depth is reversed-Z and clears to zero. Occlusion rejection needs
  // the farthest value in a footprint (min), while screen-space ray traversal
  // needs the closest surface (max). Both products share this kernel.
  g_HiZOut[dispatchThreadId.xy] = Reduce == 1u ?
    min(min(depth00, depth10), min(depth01, depth11)) :
    max(max(depth00, depth10), max(depth01, depth11));
}
