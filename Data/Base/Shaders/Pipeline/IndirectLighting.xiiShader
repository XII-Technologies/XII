// XII Engine - deferred DDGI and sky indirect lighting.

#include "PipelineCommon.xiiShader"

Texture2D<float2> g_GBufNormal : register(t0);
Texture2D<float4> g_GBufMaterial : register(t1);
Texture2D<float4> g_GBufAlbedo : register(t2);
Texture2D<float> g_SceneDepth : register(t3);
Texture2D<float> g_AOTerm : register(t4);
Texture2D<float2> g_BRDFLut : register(t5);
Texture2D<float4> g_DDGIIr : register(t6);
Texture2D<float4> g_SkyRadiance : register(t7);
RWTexture2D<float4> g_IndirectOut : register(u0);

float3 FresnelSchlickRoughness(float NoV, float3 f0, float roughness)
{
    const float3 grazing = max(1.0f - roughness, f0);
    return f0 + (grazing - f0) * pow(saturate(1.0f - NoV), 5.0f);
}
[numthreads(8, 8, 1)]
void CS_IndirectLighting(uint3 tid : SV_DispatchThreadID)
{
    uint2 dimensions;
    g_IndirectOut.GetDimensions(dimensions.x, dimensions.y);
    if (any(tid.xy >= dimensions))
        return;

    const float2 uv = (float2(tid.xy) + 0.5f) / float2(dimensions);
    const float depth = g_SceneDepth.SampleLevel(g_sPointClamp, uv, 0.0f);
    if (depth <= 0.0f)
    {
        g_IndirectOut[tid.xy] = 0.0f;
        return;
    }

    const float3 albedo = g_GBufAlbedo.SampleLevel(g_sPointClamp, uv, 0.0f).rgb;
    const float4 material = g_GBufMaterial.SampleLevel(g_sPointClamp, uv, 0.0f);
    const float roughness = clamp(material.r, 0.02f, 1.0f);
    const float metallic = saturate(material.g);
    const float ao = g_AOTerm.SampleLevel(g_sPointClamp, uv, 0.0f);
    const float3 normal = DecodeOctNormal(g_GBufNormal.SampleLevel(g_sPointClamp, uv, 0.0f));
    const float3 worldPosition = ReconstructWorldPos(uv, depth);
    const float3 viewDirection = normalize(g_CameraPositionAndNearPlane.xyz - worldPosition);
    const float NoV = saturate(dot(normal, viewDirection));

    // DDGI stores incident diffuse irradiance. Lambertian surfaces convert it
    // to outgoing radiance with albedo / pi; metals have no diffuse lobe.
    const float3 probeIrradiance = max(g_DDGIIr.SampleLevel(g_sLinearClamp, uv, 0.0f).rgb, 0.0f);
    const float3 diffuse = probeIrradiance * albedo * (1.0f - metallic) * (1.0f / 3.14159265f);

    // The atmosphere buffer is the low-frequency specular fallback until a
    // reflection probe or traced hit replaces it in the later reflection tier.
    const float3 f0 = lerp(0.04f.xxx, albedo, metallic);
    const float3 fresnel = FresnelSchlickRoughness(NoV, f0, roughness);
    const float2 brdf = g_BRDFLut.SampleLevel(g_sLinearClamp, float2(NoV, roughness), 0.0f);
    const float3 skyRadiance = max(g_SkyRadiance.SampleLevel(g_sLinearClamp, uv, 0.0f).rgb, 0.0f);
    const float3 specular = skyRadiance * (fresnel * brdf.x + brdf.y);

    g_IndirectOut[tid.xy] = float4((diffuse + specular) * ao * g_IBLIntensity, 1.0f);
}
