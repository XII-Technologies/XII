// XII Engine - deferred DDGI and sky indirect lighting.

[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTE_SHADER]

#include <Shaders/Common/Common.h>
#include <Shaders/Pipeline/PipelineCommon.xiiShader>
#include <Shaders/Pipeline/ReflectionProbeData.h>

Texture2D<float2> g_GBufNormal;
Texture2D<float4> g_GBufMaterial;
Texture2D<float4> g_GBufAlbedo;
Texture2D<float>  g_SceneDepth;
Texture2D<float>  g_AOTerm;
Texture2D<float2> g_BRDFLut;
Texture2D<float4> g_DDGIIr;
Texture2D<float4> g_SkyRadiance;
Texture2D<float4> g_SparseVoxelIrradiance;
StructuredBuffer<xiiGPUReflectionProbe> g_ReflectionProbeData;
StructuredBuffer<uint2>                 g_ReflectionProbeClusters;
TextureCube<float4>                     g_ReflectionProbeTextures[XII_MAX_REFLECTION_PROBES];
RWTexture2D<float4>                     g_IndirectOut;
RWTexture2D<float4>                     g_EnvironmentSpecularOut;

float3 FresnelSchlickRoughness(float NoV, float3 f0, float roughness)
{
    const float3 grazing = max(1.0f - roughness, f0);
    return f0 + (grazing - f0) * pow(saturate(1.0f - NoV), 5.0f);
}

float3 ReflectionProbeCubeDirection(float3 direction)
{
    return float3(direction.x, direction.z, -direction.y);
}

uint GetReflectionProbeClusterIndex(float2 uv, float depth)
{
    const uint clusterCountX = max(g_ClusterCountX, 1u);
    const uint clusterCountY = max(g_ClusterCountY, 1u);
    const uint clusterCountZ = max(g_ClusterCountZ, 1u);
    const uint2 tile = min((uint2)(saturate(uv) * float2(clusterCountX, clusterCountY)), uint2(clusterCountX - 1u, clusterCountY - 1u));
    const float linearDepth = LinearizeDepth(depth);
    const float normalizedDepth = log2(max(linearDepth, g_ClusterNearPlane) / max(g_ClusterNearPlane, 1e-4f)) / max(g_ClusterLogFarOverNear, 1e-4f);
    const uint slice = min((uint)max(normalizedDepth * (float)clusterCountZ, 0.0f), clusterCountZ - 1u);
    return (slice * clusterCountY + tile.y) * clusterCountX + tile.x;
}

float EvaluateReflectionProbeWeight(xiiGPUReflectionProbe probe, float3 worldPosition, out float3 localPosition)
{
    localPosition = mul(probe.WorldToProbe, float4(worldPosition, 1.0f)).xyz;
    const float blendDistance = probe.HalfExtentsAndBlend.w;

    if ((uint)(probe.ProbeParameters.w + 0.5f) == XII_REFLECTION_PROBE_SHAPE_SPHERE)
    {
        const float distanceToBoundary = probe.ProbeParameters.x - length(localPosition);
        if (distanceToBoundary < 0.0f)
            return 0.0f;
        return blendDistance > 1e-4f ? saturate(distanceToBoundary / blendDistance) : 1.0f;
    }

    const float3 distanceToPlanes = probe.HalfExtentsAndBlend.xyz - abs(localPosition);
    const float distanceToBoundary = min(distanceToPlanes.x, min(distanceToPlanes.y, distanceToPlanes.z));
    if (distanceToBoundary < 0.0f)
        return 0.0f;
    return blendDistance > 1e-4f ? saturate(distanceToBoundary / blendDistance) : 1.0f;
}

float3 SampleReflectionProbe(uint probeIndexPlusOne, float3 worldPosition, float3 reflectionDirection, float roughness, out float weight)
{
    weight = 0.0f;
    if (probeIndexPlusOne == 0u)
        return 0.0f;

    const xiiGPUReflectionProbe probe = g_ReflectionProbeData[probeIndexPlusOne - 1u];
    float3 localPosition;
    weight = EvaluateReflectionProbeWeight(probe, worldPosition, localPosition);
    if (weight <= 0.0f)
        return 0.0f;

    float3 localDirection = normalize(mul((float3x3)probe.WorldToProbe, reflectionDirection));
    if (probe.Metadata.w != 0u && (uint)(probe.ProbeParameters.w + 0.5f) == XII_REFLECTION_PROBE_SHAPE_BOX)
    {
        const float3 halfExtents = probe.HalfExtentsAndBlend.xyz;
        const float3 directionSign = step(0.0f, localDirection) * 2.0f - 1.0f;
        const float3 safeDirection = directionSign * max(abs(localDirection), 1e-5f);
        const float3 positivePlane = (halfExtents - localPosition) / safeDirection;
        const float3 negativePlane = (-halfExtents - localPosition) / safeDirection;
        const float3 forwardPlane = max(positivePlane, negativePlane);
        const float intersectionDistance = max(min(forwardPlane.x, min(forwardPlane.y, forwardPlane.z)), 0.0f);
        localDirection = normalize(localPosition + localDirection * intersectionDistance);
    }

    const uint textureIndex = NonUniformResourceIndex(probe.Metadata.y);
    float3 radiance = max(g_ReflectionProbeTextures[textureIndex].SampleLevel(LinearClampSampler, ReflectionProbeCubeDirection(localDirection), roughness * 8.0f).rgb, 0.0f);
    const float luminance = dot(radiance, float3(0.2126f, 0.7152f, 0.0722f));
    radiance = lerp(luminance.xxx, radiance, probe.ProbeParameters.z) * probe.ProbeParameters.y;
    return radiance;
}

[numthreads(8, 8, 1)]
void main(uint3 tid : SV_DispatchThreadID)
{
    uint2 dimensions;
    g_IndirectOut.GetDimensions(dimensions.x, dimensions.y);
    if (any(tid.xy >= dimensions))
        return;

    const float2 uv = (float2(tid.xy) + 0.5f) / float2(dimensions);
    const float depth = g_SceneDepth.SampleLevel(PointClampSampler, uv, 0.0f);
    if (depth <= 0.0f)
    {
        g_IndirectOut[tid.xy] = 0.0f;
        g_EnvironmentSpecularOut[tid.xy] = 0.0f;
        return;
    }

    const float3 albedo = g_GBufAlbedo.SampleLevel(PointClampSampler, uv, 0.0f).rgb;
    const float4 material = g_GBufMaterial.SampleLevel(PointClampSampler, uv, 0.0f);
    const float roughness = clamp(material.r, 0.02f, 1.0f);
    const float metallic = saturate(material.g);
    const float ao = g_AOTerm.SampleLevel(PointClampSampler, uv, 0.0f);
    const float3 normal = DecodeOctNormal(g_GBufNormal.SampleLevel(PointClampSampler, uv, 0.0f));
    const float3 worldPosition = ReconstructWorldPos(uv, depth);
    const float3 viewDirection = normalize(g_CameraPositionAndNearPlane.xyz - worldPosition);
    const float NoV = saturate(dot(normal, viewDirection));

    // DDGI stores incident diffuse irradiance. Lambertian surfaces convert it
    // to outgoing radiance with albedo / pi; metals have no diffuse lobe.
    const float4 ddgiSample = g_DDGIIr.SampleLevel(LinearClampSampler, uv, 0.0f);
    const float4 sparseVoxelSample = g_SparseVoxelIrradiance.SampleLevel(LinearClampSampler, uv, 0.0f);
    const float3 farFieldIrradiance = lerp(max(g_AmbientLightColor.rgb, 0.0f), max(sparseVoxelSample.rgb, 0.0f), saturate(sparseVoxelSample.a));
    const float3 probeIrradiance = lerp(farFieldIrradiance, max(ddgiSample.rgb, 0.0f), saturate(ddgiSample.a));
    const float3 diffuse = probeIrradiance * albedo * (1.0f - metallic) * (1.0f / 3.14159265f);

    // Local captures form reflection Tier 2. Their influence fades into the
    // atmosphere fallback; SSR and traced reflections are composited later.
    const float3 f0 = lerp(0.04f.xxx, albedo, metallic);
    const float3 fresnel = FresnelSchlickRoughness(NoV, f0, roughness);
    const float2 brdf = g_BRDFLut.SampleLevel(LinearClampSampler, float2(NoV, roughness), 0.0f);
    const float3 skyRadiance = max(g_SkyRadiance.SampleLevel(LinearClampSampler, uv, 0.0f).rgb, 0.0f);
    const float3 reflectionDirection = reflect(-viewDirection, normal);
    const uint2 selectedProbes = g_ReflectionProbeClusters[GetReflectionProbeClusterIndex(uv, depth)];
    float firstWeight;
    float secondWeight;
    const float3 firstProbeRadiance = SampleReflectionProbe(selectedProbes.x, worldPosition, reflectionDirection, roughness, firstWeight);
    const float3 secondProbeRadiance = SampleReflectionProbe(selectedProbes.y, worldPosition, reflectionDirection, roughness, secondWeight);
    const float totalProbeWeight = firstWeight + secondWeight;
    const float3 probeRadiance = totalProbeWeight > 1e-4f ? (firstProbeRadiance * firstWeight + secondProbeRadiance * secondWeight) / totalProbeWeight : skyRadiance;
    const float3 environmentRadiance = lerp(skyRadiance, probeRadiance, saturate(totalProbeWeight));
    const float3 specular = environmentRadiance * (fresnel * brdf.x + brdf.y);

    const float3 environmentSpecular = specular * ao * g_IBLIntensity;
    g_EnvironmentSpecularOut[tid.xy] = float4(environmentSpecular, 1.0f);
    g_IndirectOut[tid.xy] = float4(diffuse * ao * g_IBLIntensity + environmentSpecular, 1.0f);
}
