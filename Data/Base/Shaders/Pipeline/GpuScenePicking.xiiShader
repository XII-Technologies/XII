// XII Engine - native surface queries from compact GPU-scene meshlets.

[PLATFORMS]
ALL

[RENDERSTATE]
DepthEnable = true
DepthWriteEnable = true
ComparisonDepthFunction = ComparisonFunction_GreaterEqual
CullMode = CullMode_None

[SHADER]
#include <Shaders/Pipeline/GpuSceneSurfaceVertex.h>

[MESH_SHADER]
#include <Shaders/Pipeline/GpuSceneSurfaceMesh.h>

[PIXEL_SHADER]
#include <Shaders/Pipeline/GpuScenePickingPixel.h>
