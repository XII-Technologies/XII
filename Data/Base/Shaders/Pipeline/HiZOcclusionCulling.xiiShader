[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTE_SHADER]

#include <Shaders/Pipeline/Passes/HiZPyramid/HiZOcclusionConstants.h>

struct InstanceBounds
{
  float4 CenterRadius;
  float4 Extents;
};

StructuredBuffer<InstanceBounds> g_Bounds;
StructuredBuffer<uint>           g_Candidates;   // [0] = count, [1..] = packet indices.
Texture2D<float>                 g_HiZPyramid;
RWStructuredBuffer<uint>         g_SurvivingOut; // [0] = count, [1..] = packet indices.

// Returns false when a bound crosses the projection plane. Such packets stay visible because
// no finite screen-space rectangle can conservatively represent them.
bool ProjectBounds(InstanceBounds bounds, out float4 screenRect, out float nearestDepth)
{
  float2 minimumUV = float2(1.0f, 1.0f);
  float2 maximumUV = float2(0.0f, 0.0f);
  nearestDepth = 0.0f;

  [unroll]
  for (uint cornerIndex = 0u; cornerIndex < 8u; ++cornerIndex)
  {
    const float3 cornerSign = float3((cornerIndex & 1u) != 0u ? 1.0f : -1.0f,
                                     (cornerIndex & 2u) != 0u ? 1.0f : -1.0f,
                                     (cornerIndex & 4u) != 0u ? 1.0f : -1.0f);
    const float3 corner = bounds.CenterRadius.xyz + bounds.Extents.xyz * cornerSign;
    const float4 clip = mul(ViewProjectionMatrix, float4(corner, 1.0f));
    if (clip.w <= 0.0001f)
    {
      screenRect = float4(0.0f, 0.0f, 1.0f, 1.0f);
      return false;
    }

    const float3 ndc = clip.xyz / clip.w;
    const float2 uv = ndc.xy * float2(0.5f, -0.5f) + 0.5f;
    minimumUV = min(minimumUV, uv);
    maximumUV = max(maximumUV, uv);
    nearestDepth = max(nearestDepth, saturate(ndc.z));
  }

  screenRect = saturate(float4(minimumUV, maximumUV));
  return true;
}
[numthreads(64, 1, 1)]
void main(uint3 dispatchThreadId : SV_DispatchThreadID)
{
  const uint candidateCount = min(g_Candidates[0], CandidateCapacity);
  if (dispatchThreadId.x >= candidateCount)
    return;

  const uint instanceIndex = g_Candidates[dispatchThreadId.x + 1u];
  float4 screenRect;
  float nearestDepth;
  bool visible = true;
  if (ProjectBounds(g_Bounds[instanceIndex], screenRect, nearestDepth))
  {
    const float2 footprint = (screenRect.zw - screenRect.xy) * float2(HiZSize);
    const uint mip = min((uint)max(0.0f, floor(log2(max(max(footprint.x, footprint.y), 1.0f)))), max(HiZMipCount, 1u) - 1u);
    const uint2 mipSize = max(HiZSize >> mip, 1u);
    const int2 maximumPixel = int2(mipSize - 1u);
    const int2 p0 = clamp(int2(screenRect.xy * float2(mipSize)), int2(0, 0), maximumPixel);
    const int2 p1 = clamp(int2(screenRect.zw * float2(mipSize)), int2(0, 0), maximumPixel);

    const float occluderDepth = min(min(g_HiZPyramid.Load(int3(p0, mip)), g_HiZPyramid.Load(int3(p1.x, p0.y, mip))),
                                    min(g_HiZPyramid.Load(int3(p0.x, p1.y, mip)), g_HiZPyramid.Load(int3(p1, mip))));
    visible = nearestDepth >= occluderDepth - DepthBias;
  }

  if (visible)
  {
    uint destination;
    InterlockedAdd(g_SurvivingOut[0], 1u, destination);
    g_SurvivingOut[destination + 1u] = instanceIndex;
  }
}
