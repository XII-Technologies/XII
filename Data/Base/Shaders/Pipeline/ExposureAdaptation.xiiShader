// XII Engine - ExposureAdaptation.xiiShader  [NEW]
// Pass 54: Eye adaptation - reads histogram, emits adapted exposure value.
// Dispatch: 1 × 1 × 1

#include "PipelineCommon.xiiShader"
#include "Passes/Exposure/ExposureConstants.h"

StructuredBuffer<uint>     g_Histogram  : register(t0);
RWStructuredBuffer<float>  g_Exposure   : register(u0); // [0]=exposure, [1]=avgLum

[numthreads(1, 1, 1)]
void CS_ExposureAdaptation(uint3 tid : SV_DispatchThreadID)
{
    float manualExposure = GET_CONSTANT(xiiExposureAdaptationConstants, ManualExposure) * exp2(GET_CONSTANT(xiiExposureAdaptationConstants, Exposure).w);
    if (GET_CONSTANT(xiiExposureAdaptationConstants, AutomaticExposure) == 0u)
    {
        g_Exposure[0] = manualExposure;
        g_Exposure[1] = 0.0f;
        return;
    }

    // Count total pixels (sum histogram).
    uint totalPixels = 0u;
    for (uint i = 0u; i < 256u; ++i) totalPixels += g_Histogram[i];
    if (totalPixels == 0u) return;

    // Weighted average of log-luminance (clip low/high percentiles).
    float lowCount  = float(totalPixels) * GET_CONSTANT(xiiExposureAdaptationConstants, Metering).x;
    float highCount = float(totalPixels) * GET_CONSTANT(xiiExposureAdaptationConstants, Metering).y;
    float count     = 0.0f;
    float weightedAvg = 0.0f;

    for (uint b = 0u; b < 256u; ++b)
    {
        float bCount = float(g_Histogram[b]);
        float minCount = max(0.0f, lowCount - count);
        float maxCount = min(bCount, highCount - count);
        float contribution = max(0.0f, maxCount - minCount);
        float logLum = GET_CONSTANT(xiiExposureAdaptationConstants, LogLuminanceRange).x + (float(b) / 255.0f) * GET_CONSTANT(xiiExposureAdaptationConstants, LogLuminanceRange).z;
        weightedAvg += logLum * contribution;
        count += bCount;
        if (count >= highCount) break;
    }

    float clampedRange = max(highCount - lowCount, 1.0f);
    float avgLogLum    = weightedAvg / clampedRange;
    float avgLum       = exp2(avgLogLum);

    float ev100        = log2(avgLum * 100.0f / 12.5f);
    ev100              = clamp(ev100, GET_CONSTANT(xiiExposureAdaptationConstants, Exposure).y, GET_CONSTANT(xiiExposureAdaptationConstants, Exposure).z);
    float targetExp    = exp2(GET_CONSTANT(xiiExposureAdaptationConstants, Exposure).w) / (1.2f * exp2(ev100));

    // Exponential temporal adaptation is stable across variable frame rates.
    float prevExp      = g_Exposure[0];
    if (GET_CONSTANT(xiiExposureAdaptationConstants, HistoryValid) == 0u || prevExp <= 0.0f) prevExp = targetExp;
    float speed        = targetExp > prevExp ? GET_CONSTANT(xiiExposureAdaptationConstants, Metering).z : GET_CONSTANT(xiiExposureAdaptationConstants, Metering).w;
    float blend        = 1.0f - exp2(-max(speed, 0.0f) * GET_CONSTANT(xiiExposureAdaptationConstants, Exposure).x);
    float newExp       = lerp(prevExp, targetExp, saturate(blend));

    g_Exposure[0] = newExp;
    g_Exposure[1] = avgLum;
}
