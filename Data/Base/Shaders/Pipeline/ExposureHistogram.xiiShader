// XII Engine - ExposureHistogram.xiiShader  [NEW]
// Pass 53: Build a 256-bucket log2-luminance histogram via LDS atomics.
// Dispatch: ceil(W/16) × ceil(H/16) × 1  (each thread handles one pixel tile)

#include "PipelineCommon.xiiShader"
#include "Passes/Exposure/ExposureConstants.h"

Texture2D<float4>          g_HDRInput   : register(t0);
RWStructuredBuffer<uint>   g_Histogram  : register(u0); // 256 uint counters

groupshared uint gs_LocalHistogram[256];

float Luminance(float3 color)
{
    return dot(color, float3(0.2126f, 0.7152f, 0.0722f));
}

uint LuminanceToBucket(float lum)
{
    if (lum < 0.0001f) return 0u;
    float logLum = log2(lum);
    float t      = saturate((logLum - GET_CONSTANT(xiiExposureHistogramConstants, LogLuminanceRange).x) * GET_CONSTANT(xiiExposureHistogramConstants, LogLuminanceRange).z);
    return uint(t * 254.0f + 1.0f); // reserve bucket 0 for very dark pixels
}

[numthreads(16, 16, 1)]
void CS_ExposureHistogram(uint3 tid   : SV_DispatchThreadID,
                          uint3 gtid  : SV_GroupThreadID,
                          uint3 gid   : SV_GroupID)
{
    // Initialise LDS.
    if (gtid.x == 0u && gtid.y == 0u)
        for (uint i = 0u; i < 256u; ++i) gs_LocalHistogram[i] = 0u;
    GroupMemoryBarrierWithGroupSync();

    // Each thread accumulates its pixel into LDS.
    uint2 pixelCoord = tid.xy;
    uint2 resolution = GET_CONSTANT(xiiExposureHistogramConstants, InputResolution);
    if (all(pixelCoord < resolution))
    {
        float3 hdr = g_HDRInput.Load(uint3(pixelCoord, 0u)).rgb;
        float  lum = Luminance(hdr);
        uint   bin = LuminanceToBucket(lum);
        InterlockedAdd(gs_LocalHistogram[bin], 1u);
    }
    GroupMemoryBarrierWithGroupSync();

    // Merge LDS into global histogram (each thread handles 16 buckets for 256/16=16 threads).
    uint laneIdx = gtid.x + gtid.y * 16u;
    if (laneIdx < 256u)
        InterlockedAdd(g_Histogram[laneIdx], gs_LocalHistogram[laneIdx]);
}
