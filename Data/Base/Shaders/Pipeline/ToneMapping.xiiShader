[PLATFORMS]
ALL

[COMPUTE_SHADER]

#include <Shaders/Common/StorageImageFormat.h>

// HDR to display-linear tone mapping with multiple operator support and bloom composite.
// Dispatch: ceil(W/8) x ceil(H/8) x 1.

#include <Shaders/Common/Common.h>
#include <Shaders/Pipeline/Passes/Output/ToneMappingConstants.h>

Texture2D<float4>          g_HDRInput;
Texture2D<float4>          g_BloomTex;
StructuredBuffer<float>    g_Exposure; // [0]=exposure scalar
XII_STORAGE_IMAGE_FORMAT("rgba16f") RWTexture2D<float4>        g_LDROut;

// 
// ACES fitted (Krzysztof Narkowicz approximation)
// 
float3 ACES_Narkowicz(float3 x)
{
    const float a = 2.51f, b = 0.03f, c = 2.43f, d = 0.59f, e = 0.14f;
    return saturate((x * (a * x + b)) / (x * (c * x + d) + e));
}

// Reinhard
float3 Reinhard(float3 x) { return x / (x + 1.0f); }

// Uncharted 2 (Hable)
float3 Hable(float3 x)
{
    float A=0.15f,B=0.50f,C=0.10f,D=0.20f,E=0.02f,F=0.30f;
    return ((x*(A*x+C*B)+D*E)/(x*(A*x+B)+D*F))-E/F;
}
float3 Uncharted2(float3 x)
{
    float3 curr = Hable(x * 2.0f);
    float3 whiteScale = 1.0f / Hable(float3(11.2f,11.2f,11.2f));
    return curr * whiteScale;
}

float3 ToneMapSDR(float3 color)
{
    uint op = Operator;
    if (op == 1u) return Reinhard(color);
    if (op == 2u) return Uncharted2(color);
    return ACES_Narkowicz(color);
}

// Preserve highlight energy for HDR displays while asymptotically limiting the
// signal to the calibrated display peak. One unit represents paper white.
float3 ToneMapHDR(float3 color)
{
    float peakRelative = max(MaximumDisplayNits / PaperWhiteNits, 1.0f);
    float luminance = max(dot(color, float3(0.2126f, 0.7152f, 0.0722f)), 0.0f);
    float mappedLuminance = luminance / (1.0f + luminance / peakRelative);
    return max(color, 0.0f) * (mappedLuminance / max(luminance, 1.0e-6f));
}

[numthreads(8, 8, 1)]
void main(uint3 tid : SV_DispatchThreadID)
{
    uint2 dims; g_LDROut.GetDimensions(dims.x, dims.y);
    if (any(tid.xy >= dims)) return;

    float2 uv    = (float2(tid.xy) + 0.5f) / float2(dims);
    if (VisualizeCurve != 0u)
    {
        // Horizontal axis is scene luminance in stops [-10,+10]. Vertical axis
        // is output relative to paper white (SDR) or calibrated peak (HDR).
        const float3 input = exp2(uv.x * 20.0f - 10.0f) * g_Exposure[0];
        const float peak = OutputMode == 0u ? 1.0f : max(MaximumDisplayNits / PaperWhiteNits, 1.0f);
        const float curve = (OutputMode == 0u ? ToneMapSDR(input).r : ToneMapHDR(input).r) / peak;
        const float coverage = saturate(1.5f - abs((1.0f - uv.y - curve) * dims.y));
        g_LDROut[tid.xy] = float4(lerp(float3(0.015f, 0.015f, 0.015f), float3(0.2f, 1.0f, 0.4f), coverage), 1.0f);
        return;
    }
    float3 hdr   = g_HDRInput.SampleLevel(LinearClampSampler, uv, 0).rgb;
    float3 bloom = 0;
    if (BloomStrength > 0.0f)
        bloom = g_BloomTex.SampleLevel(LinearClampSampler, uv, 0).rgb;
    float  exp   = g_Exposure[0];

    hdr = (hdr + bloom * BloomStrength) * exp;

    float3 displayLinear = OutputMode == 0u ? ToneMapSDR(hdr) : ToneMapHDR(hdr);
    g_LDROut[tid.xy] = float4(displayLinear, 1.0f);
}
