// XII Engine - ToneMapping.xiiShader  [NEW]
// Pass 60: HDR → LDR tone mapping with multiple operator support + bloom composite.
// Dispatch: ceil(W/8) × ceil(H/8) × 1

#include "PipelineCommon.xiiShader"
#include "Passes/Output/DisplayOutputConstants.h"

Texture2D<float4>          g_HDRInput  : register(t0);
Texture2D<float4>          g_BloomTex  : register(t1);
StructuredBuffer<float>    g_Exposure  : register(t2); // [0]=exposure scalar
RWTexture2D<float4>        g_LDROut    : register(u0);

// 
// ACES fitted (Krzysztof Narkowicz approximation)
// 
float3 ACES_Narkowicz(float3 x)
{
    const float a = 2.51f, b = 0.03f, c = 2.43f, d = 0.59f, e = 0.14f;
    return saturate((x * (a * x + b)) / (x * (c * x + d) + e));
}

// Reinhard
float3 Reinhard(float3 x) { return x / (x + 1.0f); }

// Uncharted 2 (Hable)
float3 Hable(float3 x)
{
    float A=0.15f,B=0.50f,C=0.10f,D=0.20f,E=0.02f,F=0.30f;
    return ((x*(A*x+C*B)+D*E)/(x*(A*x+B)+D*F))-E/F;
}
float3 Uncharted2(float3 x)
{
    float3 curr = Hable(x * 2.0f);
    float3 whiteScale = 1.0f / Hable(float3(11.2f,11.2f,11.2f));
    return curr * whiteScale;
}

float3 ToneMapSDR(float3 color)
{
    uint op = GET_CONSTANT(xiiToneMappingConstants, Operator);
    if (op == 1u) return Reinhard(color);
    if (op == 2u) return Uncharted2(color);
    return ACES_Narkowicz(color);
}

// Preserve highlight energy for HDR displays while asymptotically limiting the
// signal to the calibrated display peak. One unit represents paper white.
float3 ToneMapHDR(float3 color)
{
    float peakRelative = max(GET_CONSTANT(xiiToneMappingConstants, MaximumDisplayNits) / GET_CONSTANT(xiiToneMappingConstants, PaperWhiteNits), 1.0f);
    float luminance = max(dot(color, float3(0.2126f, 0.7152f, 0.0722f)), 0.0f);
    float mappedLuminance = luminance / (1.0f + luminance / peakRelative);
    return max(color, 0.0f) * (mappedLuminance / max(luminance, 1.0e-6f));
}

[numthreads(8, 8, 1)]
void CS_ToneMapping(uint3 tid : SV_DispatchThreadID)
{
    uint2 dims; g_LDROut.GetDimensions(dims.x, dims.y);
    if (any(tid.xy >= dims)) return;

    float2 uv    = (float2(tid.xy) + 0.5f) / float2(dims);
    float3 hdr   = g_HDRInput.SampleLevel(g_sLinearClamp, uv, 0).rgb;
    float3 bloom = g_BloomTex.SampleLevel(g_sLinearClamp, uv, 0).rgb;
    float  exp   = g_Exposure[0];

    hdr = (hdr + bloom * GET_CONSTANT(xiiToneMappingConstants, BloomStrength)) * exp;

    float3 displayLinear = GET_CONSTANT(xiiToneMappingConstants, OutputMode) == 0u ? ToneMapSDR(hdr) : ToneMapHDR(hdr);
    g_LDROut[tid.xy] = float4(displayLinear, 1.0f);
}
