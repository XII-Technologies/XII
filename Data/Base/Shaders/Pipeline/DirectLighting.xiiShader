// XII Engine — DirectLighting.xiiShader  [NEW]
// Pass 46: Deferred direct lighting — GGX BRDF + cluster lights + cascade shadow sample.
// Dispatch: ceil(W/8) × ceil(H/8) × 1

#include "PipelineCommon.xiiShader"

cbuffer DirectLightingConstants : register(b3)
{
    uint   g_ClusterCountX, g_ClusterCountY, g_ClusterCountZ;
    uint   g_MaxLightsPerCluster;
    float  g_ClusterNearPlane;
    float  g_ClusterLogFarOverNear; // log(far/near) for packed cluster Z
    float2 _pad;
};

// ──────────────────────────────────────────────────────────────────────────────
// GBuffer inputs
// ──────────────────────────────────────────────────────────────────────────────
Texture2D<float4> g_GBufAlbedo   : register(t0);
Texture2D<float2> g_GBufNormal   : register(t1);
Texture2D<float4> g_GBufMaterial : register(t2);  // r=rough, g=metal, b=AO
Texture2D<float>  g_SceneDepth   : register(t3);
Texture2D<float>  g_AOTerm       : register(t4);
Texture2D<float>  g_ShadowAtlas  : register(t5);  // directional CSM atlas (D16)
Texture2D<float>  g_ContactShadow: register(t6);
Texture2D<float>  g_RTShadow     : register(t7);  // optionally bound

StructuredBuffer<uint>    g_LightGrid  : register(t8);  // (offset, count) per cluster
StructuredBuffer<uint>    g_LightIndex : register(t9);  // light index list
RWTexture2D<float4>       g_DirectOut  : register(u0);

// ──────────────────────────────────────────────────────────────────────────────
// GGX BRDF terms
// ──────────────────────────────────────────────────────────────────────────────
float D_GGX(float NoH, float roughness)
{
    float a  = roughness * roughness;
    float a2 = a * a;
    float d  = max(NoH * NoH * (a2 - 1.0f) + 1.0f, 1e-7f);
    return a2 / (3.14159265f * d * d);
}

float G_SmithGGX(float NoV, float NoL, float roughness)
{
    float r = roughness + 1.0f;
    float k = (r * r) / 8.0f;
    float gv = NoV / (NoV * (1.0f - k) + k);
    float gl = NoL / (NoL * (1.0f - k) + k);
    return gv * gl;
}

float3 F_Schlick(float3 f0, float VoH)
{
    return f0 + (1.0f - f0) * pow(saturate(1.0f - VoH), 5.0f);
}

float3 BRDF(float3 albedo, float roughness, float metallic, float3 N, float3 L, float3 V)
{
    float3 f0   = lerp(float3(0.04f, 0.04f, 0.04f), albedo, metallic);
    float3 H    = normalize(V + L);
    float NoH   = saturate(dot(N, H));
    float NoV   = max(dot(N, V), 1e-4f);
    float NoL   = saturate(dot(N, L));
    float VoH   = saturate(dot(V, H));
    float3 F    = F_Schlick(f0, VoH);
    float  D    = D_GGX(NoH, roughness);
    float  G    = G_SmithGGX(NoV, NoL, roughness);
    float3 spec = (D * G * F) / max(4.0f * NoV * NoL, 1e-7f);
    float3 diff = (1.0f - F) * (1.0f - metallic) * albedo / 3.14159265f;
    return (diff + spec) * NoL;
}

// ──────────────────────────────────────────────────────────────────────────────
[numthreads(8, 8, 1)]
void CS_DirectLighting(uint3 tid : SV_DispatchThreadID)
{
    uint2 dims; g_DirectOut.GetDimensions(dims.x, dims.y);
    if (any(tid.xy >= dims)) return;

    float2 uv    = (float2(tid.xy) + 0.5f) / float2(dims);
    float  depth = g_SceneDepth.SampleLevel(g_sPointClamp, uv, 0);
    if (depth <= 0.0f) { g_DirectOut[tid.xy] = float4(0,0,0,1); return; }

    float4 albedoA  = g_GBufAlbedo  .SampleLevel(g_sPointClamp, uv, 0);
    float2 octNorm  = g_GBufNormal  .SampleLevel(g_sPointClamp, uv, 0);
    float4 material = g_GBufMaterial.SampleLevel(g_sPointClamp, uv, 0);
    float  ao       = g_AOTerm      .SampleLevel(g_sPointClamp, uv, 0);
    float  rtSh     = g_RTShadow    .SampleLevel(g_sPointClamp, uv, 0);
    float  ctSh     = g_ContactShadow.SampleLevel(g_sPointClamp, uv, 0);

    float3 albedo    = albedoA.rgb;
    float  roughness = max(material.r, 0.01f);
    float  metallic  = material.g;
    float3 N         = DecodeOctNormal(octNorm);
    float3 worldPos  = ReconstructWorldPos(uv, depth);
    float3 V         = normalize(g_CameraPositionAndNearPlane.xyz - worldPos);

    // Main directional light.
    float3 L         = normalize(-g_MainLightDirectionAndIntensity.xyz);
    float  shadow    = saturate(1.0f - max(rtSh, ctSh));
    float3 direct    = BRDF(albedo, roughness, metallic, N, L, V)
                       * g_MainLightColor.rgb * g_MainLightDirectionAndIntensity.w
                       * shadow * ao;

    // Cluster local lights (no shadow for this example, shadows via atlas for nearby lights).
    // Cluster index from clip-space Z.
    float linZ   = LinearizeDepth(depth);
    float zSlice = max(0.0f, log(linZ / g_ClusterNearPlane) / g_ClusterLogFarOverNear
                        * float(g_ClusterCountZ));
    uint cZ = min(uint(zSlice), g_ClusterCountZ - 1u);
    uint cX = min(uint(uv.x * float(g_ClusterCountX)), g_ClusterCountX - 1u);
    uint cY = min(uint(uv.y * float(g_ClusterCountY)), g_ClusterCountY - 1u);
    uint clusterIdx = (cZ * g_ClusterCountY + cY) * g_ClusterCountX + cX;
    uint offset = g_LightGrid[clusterIdx * 2u + 0u];
    uint count  = g_LightGrid[clusterIdx * 2u + 1u];

    // (Local light evaluation elided here — would read per-light struct and evaluate BRDF.)

    g_DirectOut[tid.xy] = float4(direct, 1.0f);
}
