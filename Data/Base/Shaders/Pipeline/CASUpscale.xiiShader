[PLATFORMS]
ALL

[COMPUTE_SHADER]

// Contrast-adaptive sharpening. Sampling in normalized coordinates also supports spatial upscaling.

#include <Shaders/Common/Common.h>

Texture2D<float4>   g_TAAIn;
RWTexture2D<float4> g_Upscaled;

[numthreads(8, 8, 1)]
void main(uint3 dispatchThreadId : SV_DispatchThreadID)
{
  uint2 destinationDimensions;
  g_Upscaled.GetDimensions(destinationDimensions.x, destinationDimensions.y);
  if (any(dispatchThreadId.xy >= destinationDimensions))
    return;

  uint2 sourceDimensions;
  g_TAAIn.GetDimensions(sourceDimensions.x, sourceDimensions.y);

  const float2 uv = (float2(dispatchThreadId.xy) + 0.5f) / float2(destinationDimensions);
  const float2 sourceTexelSize = rcp(float2(sourceDimensions));
  const float3 north = g_TAAIn.SampleLevel(LinearClampSampler, uv + float2(0.0f, -sourceTexelSize.y), 0.0f).rgb;
  const float3 west = g_TAAIn.SampleLevel(LinearClampSampler, uv + float2(-sourceTexelSize.x, 0.0f), 0.0f).rgb;
  const float3 center = g_TAAIn.SampleLevel(LinearClampSampler, uv, 0.0f).rgb;
  const float3 east = g_TAAIn.SampleLevel(LinearClampSampler, uv + float2(sourceTexelSize.x, 0.0f), 0.0f).rgb;
  const float3 south = g_TAAIn.SampleLevel(LinearClampSampler, uv + float2(0.0f, sourceTexelSize.y), 0.0f).rgb;

  const float3 minimumColor = min(center, min(min(north, south), min(west, east)));
  const float3 maximumColor = max(center, max(max(north, south), max(west, east)));
  const float3 amplification = sqrt(saturate(min(minimumColor, 1.0f - maximumColor) / max(maximumColor, 1.0e-4f)));
  const float3 weight = -0.125f * amplification;
  const float3 sharpened = (center + weight * (north + west + east + south)) / max(1.0f + 4.0f * weight, 1.0e-4f);

  g_Upscaled[dispatchThreadId.xy] = float4(max(sharpened, 0.0f), 1.0f);
}
