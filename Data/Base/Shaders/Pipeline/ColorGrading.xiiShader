[PLATFORMS]
ALL

[COMPUTE_SHADER]

// Optional display-linear grading. Identity defaults preserve calibrated simulation output.

#include <Shaders/Common/Common.h>
#include <Shaders/Pipeline/Passes/Output/ColorGradingConstants.h>

Texture2D<float4>   g_DisplayLinear;
RWTexture2D<float4> g_GradedOut;

float HashNoise(uint2 pixel, uint frameIndex)
{
  uint hash = pixel.x * 0x9E3779B9U ^ pixel.y * 0x85EBCA6BU ^ frameIndex * 0xC2B2AE35U;
  hash ^= hash >> 16U;
  hash *= 0x7FEB352DU;
  hash ^= hash >> 15U;
  hash *= 0x846CA68BU;
  hash ^= hash >> 16U;
  return (float(hash) + 0.5f) * (1.0f / 4294967296.0f);
}

[numthreads(8, 8, 1)]
void main(uint3 dispatchThreadId : SV_DispatchThreadID)
{
  uint2 dimensions;
  g_GradedOut.GetDimensions(dimensions.x, dimensions.y);
  if (any(dispatchThreadId.xy >= dimensions))
    return;

  const float2 uv = (float2(dispatchThreadId.xy) + 0.5f) / float2(dimensions);
  float3 color = max(g_DisplayLinear.Load(int3(dispatchThreadId.xy, 0)).rgb, 0.0f);

  const float luminance = GetLuminance(color);
  color = lerp(luminance.xxx, color, ColorAdjustments.x);
  color = max((color - 0.18f) * ColorAdjustments.y + 0.18f, 0.0f);

  const float2 centered = abs(uv - 0.5f) * 2.0f;
  const float2 vignetteShape = float2(centered.x * ColorAdjustments.w, centered.y);
  const float vignette = saturate(1.0f - dot(vignetteShape, vignetteShape));
  color *= lerp(1.0f, vignette * vignette, ColorAdjustments.z);

  const uint frameIndex = (uint)FilmGrain.y;
  const float grain = (HashNoise(dispatchThreadId.xy, frameIndex) - 0.5f) * FilmGrain.x;
  color = max(color + grain * sqrt(max(color, 0.0f) + 0.01f), 0.0f);

  g_GradedOut[dispatchThreadId.xy] = float4(color, 1.0f);
}
