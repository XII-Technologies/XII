// XII Engine - VolumetricFogResolve.xiiShader
// Resolves the froxel prefix volume to the opaque surface depth for each pixel.

[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTE_SHADER]

#include <Shaders/Common/Common.h>
#include <Shaders/Pipeline/PipelineCommon.xiiShader>

Texture3D<float4>   g_FroxelIntegrated;
Texture2D<float>    g_SceneDepth;
RWTexture2D<float4> g_VolumetricOut;

static const float XII_FROXEL_SLICE_COUNT = 64.0f;

[numthreads(8, 8, 1)]
void main(uint3 dispatchThreadId : SV_DispatchThreadID)
{
  uint2 dimensions;
  g_VolumetricOut.GetDimensions(dimensions.x, dimensions.y);
  if (any(dispatchThreadId.xy >= dimensions))
    return;

  const float2 uv = (float2(dispatchThreadId.xy) + 0.5f) / float2(dimensions);
  const float deviceDepth = g_SceneDepth.Load(int3(dispatchThreadId.xy, 0));
  const float nearPlane = max(g_CameraPositionAndNearPlane.w, 1e-3f);
  const float farPlane = max(g_CameraForwardAndFarPlane.w, nearPlane + 1e-3f);
  const float linearDepth = deviceDepth <= 1e-7f ? farPlane : min(LinearizeDepth(deviceDepth), farPlane);
  const float depthFraction = saturate(log(max(linearDepth, nearPlane) / nearPlane) / log(farPlane / nearPlane));

  // Prefix values are stored at the far boundary of each slice. Shifting the
  // normalized coordinate by half a cell interpolates adjacent boundaries.
  // The first slice has no stored zero boundary, so fade it in explicitly.
  const float firstSliceFraction = rcp(XII_FROXEL_SLICE_COUNT);
  const float sampleDepth = max(depthFraction - firstSliceFraction * 0.5f, firstSliceFraction * 0.5f);
  float4 integrated = g_FroxelIntegrated.SampleLevel(LinearClampSampler, float3(uv, sampleDepth), 0.0f);
  if (depthFraction < firstSliceFraction)
    integrated *= depthFraction / firstSliceFraction;

  g_VolumetricOut[dispatchThreadId.xy] = integrated;
}
