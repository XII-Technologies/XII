// XII Engine - MotionVectors.xiiShader
// Fullscreen triangle - reconstruct world position, reproject with previous VP matrix.
// Produces screen-space velocity in normalised device coordinates [-1,1].

[PLATFORMS]
ALL

[PERMUTATIONS]

CAMERA_MODE = CAMERA_MODE_PERSPECTIVE

[RENDERSTATE]

DepthEnable = false
DepthWriteEnable = false
CullMode = CullMode_None

[VERTEX_SHADER]

#include <Shaders/Pipeline/FullscreenTriangleVertexShader.h>

[PIXEL_SHADER]

#include <Shaders/Pipeline/PipelineCommon.xiiShader>
#include <Shaders/Pipeline/FullscreenTriangleInterpolator.h>
#include <Shaders/Pipeline/Passes/MotionVectors/MotionVectorConstants.h>

Texture2D<float> g_SceneDepth;

struct PS_Out { float2 Velocity : SV_Target0; };

PS_Out main(PS_IN In)
{
    float2 uv = In.TexCoord0;
    float  rawDepth = g_SceneDepth.Sample(g_sPointClamp, uv);

    // Reconstruct world position.
    float4 clipPos   = float4(uv * 2.0f - 1.0f, rawDepth, 1.0f);
    clipPos.y        = -clipPos.y;
    float4 worldPos4 = mul(g_InverseViewProjectionMatrix, clipPos);
    float3 worldPos  = worldPos4.xyz / worldPos4.w;

    // Reproject to previous frame clip space.
    float4 prevClip = mul(PreviousViewProjectionMatrix, float4(worldPos, 1.0f));
    float2 prevNDC  = prevClip.xy / max(prevClip.w, 1e-7f);
    float2 currNDC  = clipPos.xy;

    // Subtract jitter - ensures TAA gets clean subpixel velocity.
    float2 velocity = (currNDC - CurrentJitter) - (prevNDC - PreviousJitter);

    PS_Out o;
    o.Velocity = velocity;
    return o;
}
