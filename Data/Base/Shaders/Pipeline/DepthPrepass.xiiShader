// XII Engine - DepthPrepass.xiiShader
// Full-resolution reversed-Z depth prepass via GPU-driven indirect draw.

[PLATFORMS]
ALL

[PERMUTATIONS]

[RENDERSTATE]

DepthEnable = true
ComparisonDepthFunction = ComparisonFunction_GreaterEqual
DepthWriteEnable = true
CullMode = CullMode_Back

[SHADER]

#include <Shaders/Pipeline/PipelineCommon.xiiShader>

struct VS_In
{
    float3 Position  : POSITION;
    uint   InstanceID: SV_InstanceID;
};

struct VS_Out
{
    float4 ClipPos : SV_Position;
};

[VERTEX_SHADER]

StructuredBuffer<float4x3> g_WorldMatrices;

VS_Out main(VS_In In)
{
    float4x3 world = g_WorldMatrices[In.InstanceID];
    float3 worldPos = mul(float4(In.Position, 1.0f), world).xyz;
    VS_Out o;
    o.ClipPos = mul(g_ViewProjectionMatrix, float4(worldPos, 1.0f));
    return o;
}

[PIXEL_SHADER]

// A pixel stage is retained so masked-material coverage can be added without
// changing the pipeline layout. Opaque depth needs no color output.
void main(VS_Out In) {}
