// Deterministic fallback for devices or frames without a valid scene TLAS.

[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTE_SHADER]

RWTexture2D<float4> g_RTReflRaw;

[numthreads(8, 8, 1)]
void main(uint3 tid : SV_DispatchThreadID)
{
    uint2 dimensions;
    g_RTReflRaw.GetDimensions(dimensions.x, dimensions.y);
    if (any(tid.xy >= dimensions))
        return;

    g_RTReflRaw[tid.xy] = 0.0f;
}
