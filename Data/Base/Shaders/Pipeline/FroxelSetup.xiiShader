// XII Engine - FroxelSetup.xiiShader
// Builds view-aligned froxel density and extinction metadata.

[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTE_SHADER]

#include <Shaders/Pipeline/PipelineCommon.xiiShader>
#include <Shaders/Pipeline/Passes/Volumetrics/VolumetricMediumConstants.h>
#include <Shaders/Pipeline/Passes/Volumetrics/VolumetricMediumData.h>

StructuredBuffer<xiiGpuVolumetricMedium> g_VolumetricMedia;
RWStructuredBuffer<xiiFroxelMediumData>  g_FroxelMetadata;

static const uint3 XII_FROXEL_COUNT = uint3(128u, 72u, 64u);

[numthreads(8, 8, 1)]
void main(uint3 tid : SV_DispatchThreadID)
{
    if (any(tid >= XII_FROXEL_COUNT))
        return;

    const float2 uv = (float2(tid.xy) + 0.5f) / float2(XII_FROXEL_COUNT.xy);
    const float zFrac = (float(tid.z) + 0.5f) / (float)XII_FROXEL_COUNT.z;
    const float linearDepth = g_CameraPositionAndNearPlane.w * exp(zFrac * log(max(g_CameraForwardAndFarPlane.w, g_CameraPositionAndNearPlane.w + 0.001f) / max(g_CameraPositionAndNearPlane.w, 0.001f)));
    const float ndcDepth = saturate(g_CameraPositionAndNearPlane.w / max(linearDepth, 1e-4f));
    const float3 worldPos = ReconstructWorldPos(uv, ndcDepth);

    const float heightDelta = worldPos.y - g_VolumetricBaseHeight;
    const float heightTerm = exp(-max(heightDelta, 0.0f) * g_VolumetricHeightFalloff);
    const float density = max(g_VolumetricFogDensity * heightTerm, 0.0f);
    float3 scattering = density.xxx;
    float extinction = density;
    float3 emission = 0.0f;
    float weightedAnisotropy = density * g_VolumetricAnisotropy;
    float scatteringWeight = density;

    [loop]
    for (uint mediumIndex = 0u; mediumIndex < ActiveMediumCount; ++mediumIndex)
    {
        const xiiGpuVolumetricMedium medium = g_VolumetricMedia[mediumIndex];
        const float3 normalizedPosition = (worldPos - medium.CenterAndShape.xyz) / max(medium.HalfExtentsAndAnisotropy.xyz, 1e-4f.xxx);
        const float3 absolutePosition = abs(normalizedPosition);
        const float shapeDistance = medium.CenterAndShape.w < 0.5f ? length(normalizedPosition) : max(absolutePosition.x, max(absolutePosition.y, absolutePosition.z));
        const float influence = 1.0f - smoothstep(0.9f, 1.0f, shapeDistance);
        if (influence <= 0.0f)
            continue;

        const float3 localScattering = max(medium.ScatteringAndPriority.xyz, 0.0f) * influence;
        const float3 localAbsorption = max(medium.AbsorptionAndPadding.xyz, 0.0f) * influence;
        const float localScatteringWeight = dot(localScattering, float3(0.2126f, 0.7152f, 0.0722f));
        const float localExtinction = dot(localScattering + localAbsorption, float3(0.2126f, 0.7152f, 0.0722f));

        scattering += localScattering;
        extinction += localExtinction;
        emission += max(medium.EmissionAndPadding.xyz, 0.0f) * influence;
        weightedAnisotropy += localScatteringWeight * clamp(medium.HalfExtentsAndAnisotropy.w, -0.95f, 0.95f);
        scatteringWeight += localScatteringWeight;
    }

    const float anisotropy = scatteringWeight > 1e-5f ? weightedAnisotropy / scatteringWeight : 0.0f;

    const uint linearIndex = (tid.z * XII_FROXEL_COUNT.y + tid.y) * XII_FROXEL_COUNT.x + tid.x;
    xiiFroxelMediumData froxel;
    froxel.ScatteringAndExtinction = float4(scattering, extinction);
    froxel.EmissionAndAnisotropy = float4(emission, anisotropy);
    g_FroxelMetadata[linearIndex] = froxel;
}
