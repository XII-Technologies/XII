[PLATFORMS]
ALL

[COMPUTE_SHADER]

// Transparent near-field contribution for devices or frames without a valid scene TLAS.

RWTexture2D<float4> g_RTGIRaw : register(u0);

[numthreads(8, 8, 1)]
void main(uint3 tid : SV_DispatchThreadID)
{
  uint2 dimensions;
  g_RTGIRaw.GetDimensions(dimensions.x, dimensions.y);
  if (any(tid.xy >= dimensions))
    return;

  g_RTGIRaw[tid.xy] = 0.0f;
}
