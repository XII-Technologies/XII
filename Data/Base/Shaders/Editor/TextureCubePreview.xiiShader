[PLATFORMS]
ALL

[PERMUTATIONS]

[RENDERSTATE]
DepthEnable = true
DepthWriteEnable = true
ComparisonDepthFunction = ComparisonFunction_GreaterEqual
CullMode = CullMode_None

[VERTEX_SHADER]
#include <Shaders/Editor/TexturePreviewVertexShader.h>

[PIXEL_SHADER]
#define PREVIEW_CUBE 1
#include <Shaders/Editor/TexturePreviewPixelShader.h>
