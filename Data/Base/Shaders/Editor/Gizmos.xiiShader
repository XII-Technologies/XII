[PLATFORMS]
ALL

[PERMUTATIONS]

[RENDERSTATE]
BlendEnable0 = true
SourceBlend0 = BlendFactor_One
DestinationBlend0 = BlendFactor_InverseSourceAlpha
SourceBlendAlpha0 = BlendFactor_One
DestinationBlendAlpha0 = BlendFactor_InverseSourceAlpha
DepthEnable = true
ComparisonDepthFunction = ComparisonFunction_GreaterEqual
DepthWriteEnable = true
CullMode = CullMode_None

[SHADER]
#include <Shaders/Editor/EditorGizmoData.h>
struct VS_OUT
{
  float4 Position : SV_Position;
  float3 Normal : TEXCOORD0;
  noperspective float2 Stroke : TEXCOORD1;
  nointerpolation float StrokeLength : TEXCOORD2;
  nointerpolation float Kind : TEXCOORD3;
  nointerpolation uint Instance : TEXCOORD4;
  float Angle : TEXCOORD5;
};

[VERTEX_SHADER]
StructuredBuffer<xiiEditorGizmoVertex> GizmoVertices;
StructuredBuffer<xiiEditorGizmoInstance> GizmoInstances;

VS_OUT main(uint vertex : SV_VertexID, uint instance : SV_InstanceID)
{
  xiiEditorGizmoInstance handle = GizmoInstances[instance];
  float3 a, b;
  float kind, angle = 0;
  uint corner;
  bool worldSpace = false;
  static const uint corners[6] = {0, 1, 2, 2, 1, 3};
  if (handle.Identity.x == XII_EDITOR_GIZMO_RING)
  {
    uint segment = vertex / 6;
    corner = corners[vertex % 6];
    float first = 6.28318530718 * (segment % 128) / 128;
    float second = first + 6.28318530718 / 128;
    float r0 = 1, r1 = 1;
    kind = 1;
    if (segment >= 128 && segment < 152)
    {
      first = second = 6.28318530718 * (segment - 128) / 24;
      r0 = 0.94; r1 = 1.04;
      kind = 2;
    }
    else if (segment >= 152)
    {
      first = second = handle.Parameters.y + (segment - 152) * handle.Parameters.z;
      r0 = 0.0; r1 = 1.0;
      kind = 2;
    }
    a = float3(cos(first), sin(first), 0) * r0;
    b = float3(cos(second), sin(second), 0) * r1;
    angle = (corner & 2) != 0 ? second : first;
  }
  else
  {
    xiiEditorGizmoVertex shape = GizmoVertices[vertex];
    a = shape.Position.xyz;
    b = shape.Auxiliary.xyz;
    kind = shape.Position.w;
    corner = uint(shape.Auxiliary.w);
    if (kind == 3)
    {
      a = handle.GuideStart.xyz;
      b = mul(handle.Transform, float4(0, 0, 0, 1)).xyz;
      worldSpace = true;
      kind = (handle.Identity.y & XII_EDITOR_GIZMO_ACTIVE) != 0 ? 1 : 4;
    }
  }
  VS_OUT result;
  result.Instance = instance;
  result.Kind = kind;
  result.Angle = angle;
  result.Stroke = 0;
  result.StrokeLength = 0;
  float4 world = worldSpace ? float4(a, 1) : mul(handle.Transform, float4(a, 1));
  result.Position = mul(RelativeViewProjection, world);
  result.Normal = normalize(mul((float3x3)handle.Transform, kind == 0 ? b : float3(0, 0, 1)));
  if (kind == 4) { result.Position = float4(0, 0, -1, 1); return result; }
  if (kind != 0)
  {
    float4 end = mul(RelativeViewProjection, worldSpace ? float4(b, 1) : mul(handle.Transform, float4(b, 1)));
    float firstNear = result.Position.w - result.Position.z;
    float lastNear = end.w - end.z;
    if (firstNear < 0 && lastNear < 0) { result.Position = float4(0, 0, -1, 1); return result; }
    if (firstNear < 0) result.Position = lerp(result.Position, end, firstNear / (firstNear - lastNear));
    else if (lastNear < 0) end = lerp(end, result.Position, lastNear / (lastNear - firstNear));
    float2 delta = (end.xy / end.w - result.Position.xy / result.Position.w) * Viewport.xy * 0.5;
    float length = max(0.001, sqrt(dot(delta, delta)));
    float2 direction = delta / length;
    float halfWidth = handle.Parameters.x * handle.Parameters.w * 0.5 + 1;
    float side = (corner & 1) ? 1 : -1;
    bool last = (corner & 2) != 0;
    float4 clip = last ? end : result.Position;
    float2 offset = float2(-direction.y, direction.x) * side * halfWidth + direction * (last ? 1 : -1);
    clip.xy += offset * Viewport.zw * 2 * clip.w;
    result.Position = clip;
    result.Stroke = float2(last ? length + 1 : -1, side * halfWidth);
    result.StrokeLength = length;
  }
  return result;
}

[PIXEL_SHADER]
StructuredBuffer<xiiEditorGizmoInstance> GizmoInstances;
Texture2D<float> SceneDepth;

float4 main(VS_OUT input) : SV_Target0
{
  xiiEditorGizmoInstance handle = GizmoInstances[input.Instance];
  uint flags = handle.Identity.y;
  float alpha = handle.Color.a;
  float3 color = handle.Color.rgb;
  if ((flags & XII_EDITOR_GIZMO_DISABLED) != 0) { color = dot(color, float3(0.2126, 0.7152, 0.0722)); alpha *= 0.35; }
  else if ((flags & XII_EDITOR_GIZMO_ACTIVE) != 0) color = lerp(color, 1, 0.55);
  else if ((flags & XII_EDITOR_GIZMO_HOVER) != 0) color = lerp(color, 1, 0.35);
  else if ((flags & XII_EDITOR_GIZMO_SELECTED) != 0) color = lerp(color, 1, 0.2);
  if (input.Kind != 0)
  {
    if (handle.Identity.x == 14) alpha = max(alpha, 0.7);
    float2 distance = float2(input.Stroke.x - clamp(input.Stroke.x, 0, input.StrokeLength), input.Stroke.y);
    float width = handle.Parameters.x * handle.Parameters.w * 0.5;
    alpha *= 1 - smoothstep(width - 0.75, width + 0.75, length(distance));
    if (input.Kind == 2 && (flags & XII_EDITOR_GIZMO_ACTIVE) == 0) alpha = 0;
    if (handle.Identity.x == XII_EDITOR_GIZMO_RING && (flags & XII_EDITOR_GIZMO_ACTIVE) != 0 && input.Kind == 1)
    {
      float delta = handle.Parameters.z;
      float relative = frac((input.Angle - handle.Parameters.y) / 6.28318530718 + 1) * 6.28318530718;
      bool inside = delta >= 0 ? relative <= min(delta, 6.28318530718) : relative >= 6.28318530718 + max(delta, -6.28318530718);
      alpha *= inside ? 1.0 : 0.25;
    }
  }
  else
    color *= 0.75 + 0.25 * abs(dot(normalize(input.Normal), normalize(float3(0.4, -0.5, 0.8))));
  uint width, height;
  SceneDepth.GetDimensions(width, height);
  float2 uv = input.Position.xy * Viewport.zw;
  uint2 pixel = min(uint2(saturate(uv) * float2(width, height)), uint2(width - 1, height - 1));
  bool occluded = input.Position.z + 1e-5 < SceneDepth.Load(int3(pixel, 0));
  if (occluded)
  {
    if ((flags & XII_EDITOR_GIZMO_ON_TOP) == 0) discard;
    alpha *= input.Kind == 0 ? 0.22 : (frac((input.Position.x + input.Position.y) / (8 * handle.Parameters.w)) > 0.5 ? 0.32 : 0.08);
  }
  if (alpha < 0.001) discard;
  return float4(color * alpha, alpha);
}
