[PLATFORMS]
ALL

[PERMUTATIONS]

RENDER_PASS

[RENDERSTATE]

DepthEnable = true
DepthWriteEnable = true
FillMode = FillMode_Wireframe
CullMode = CullMode_None
ComparisonDepthFunction = ComparisonFunction_Less

[VERTEX_SHADER]

#define USE_COLOR0

#include <Shaders/Common/GlobalConstants.h>
#include <Shaders/Editor/GizmoConstants.h>
struct DebugVertexInput { float3 Position : POSITION; float4 Color0 : COLOR0; uint InstanceID : SV_InstanceID; uint VertexID : SV_VertexID; };
struct DebugVertex { float4 Position : SV_Position; float4 Color0 : COLOR0; nointerpolation uint InstanceID : TEXCOORD7;
#if CAMERA_MODE == CAMERA_MODE_STEREO
 uint RenderTargetArrayIndex : SV_RenderTargetArrayIndex;
#endif
};

DebugVertex main(DebugVertexInput Input)
{
  float4 worldSpacePos = mul(ObjectToWorldMatrix, float4(Input.Position, 1.0f));

  DebugVertex RetVal;
  RetVal.Position = mul(GetWorldToScreenMatrix(), worldSpacePos);
  RetVal.Color0 = GizmoColor;

  return RetVal;
}

[PIXEL_SHADER]

#define USE_COLOR0

#include <Shaders/Common/GlobalConstants.h>
struct DebugVertex { float4 Position : SV_Position; float4 Color0 : COLOR0; nointerpolation uint InstanceID : TEXCOORD7;
#if CAMERA_MODE == CAMERA_MODE_STEREO
 uint RenderTargetArrayIndex : SV_RenderTargetArrayIndex;
#endif
};

float4 main(DebugVertex Input) : SV_Target
{
#if (RENDER_PASS == RENDER_PASS_PICKING) || (RENDER_PASS == RENDER_PASS_PICKING_WIREFRAME)
  discard;
#endif

  return Input.Color0;
}
