[PLATFORMS]
ALL

[PERMUTATIONS]

MONOCHROME
PRE_TRANSFORMED_VERTICES
CAMERA_MODE
TOPOLOGY

[RENDERSTATE]

BlendEnable0 = false
DestinationBlend0 = BlendFactor_InverseSourceAlpha
SourceBlend0 = BlendFactor_SourceAlpha
DestinationBlendAlpha0 = BlendFactor_InverseSourceAlpha

DepthEnable = true
ComparisonDepthFunction = ComparisonFunction_GreaterEqual
#if PRE_TRANSFORMED_VERTICES
  DepthWriteEnable = false
#else
  DepthWriteEnable = true
#endif

[VERTEX_SHADER]


#include <Shaders/Common/GlobalConstants.h>
struct DebugVertexInput { float3 Position : POSITION; float4 Color0 : COLOR0; float2 TexCoord0 : TEXCOORD0; uint InstanceID : SV_InstanceID; uint VertexID : SV_VertexID; };
struct DebugVertex { float4 Position : SV_Position; float4 Color0 : COLOR0; float2 TexCoord0 : TEXCOORD0; nointerpolation uint InstanceID : TEXCOORD7;
#if CAMERA_MODE == CAMERA_MODE_STEREO
 uint RenderTargetArrayIndex : SV_RenderTargetArrayIndex;
#endif
};

DebugVertex main(DebugVertexInput Input)
{
  DebugVertex RetVal;

  #if defined(CAMERA_MODE) && CAMERA_MODE == CAMERA_MODE_STEREO
    s_ActiveCameraEyeIndex = Input.InstanceID % 2;
    RetVal.RenderTargetArrayIndex = Input.InstanceID % 2;
  #endif

  #if PRE_TRANSFORMED_VERTICES
    float2 screenPosition = (Input.Position.xy * ViewportSize.zw) * float2(2.0, -2.0) + float2(-1.0, 1.0);
    RetVal.Position = float4(screenPosition, Input.Position.z, 1.0f);
  #else
    RetVal.Position = mul(GetWorldToScreenMatrix(), float4(Input.Position, 1.0f));
  #endif

  RetVal.Color0 = Input.Color0;
  RetVal.InstanceID = Input.InstanceID;
  RetVal.TexCoord0 = Input.TexCoord0;

  return RetVal;
}

[PIXEL_SHADER]


struct DebugVertex { float4 Position : SV_Position; float4 Color0 : COLOR0; float2 TexCoord0 : TEXCOORD0; nointerpolation uint InstanceID : TEXCOORD7;
#if CAMERA_MODE == CAMERA_MODE_STEREO
 uint RenderTargetArrayIndex : SV_RenderTargetArrayIndex;
#endif
};

#include <Shaders/Common/Common.h>

Texture2D BaseTexture;

float4 main(DebugVertex Input) : SV_Target
{
#if MONOCHROME
  return float4(BaseTexture.Sample(LinearClampSampler, Input.TexCoord0.xy).rrr, 1) * Input.Color0;
#else
  return BaseTexture.Sample(LinearClampSampler, Input.TexCoord0.xy) * Input.Color0;
#endif
}
