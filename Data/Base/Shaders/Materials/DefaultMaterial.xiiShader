[PLATFORMS]
ALL

[PERMUTATIONS]
FORWARD_DIRECTIONAL_SHADOWS
FORWARD_ATMOSPHERE
FORWARD_REFRACTION
FORWARD_SPOT_SHADOWS
BLEND_MODE
RENDER_PASS
SHADING_MODE
TWO_SIDED

[MATERIAL_PARAMETER]

Permutation BLEND_MODE;
Permutation SHADING_MODE;
Permutation TWO_SIDED;

Color BaseColor @Default(Color(1.0, 1.0, 1.0));
bool UseBaseTexture;
Texture2D BaseTexture;

float MaskThreshold @Default(0.25);

bool UseNormalTexture;
Texture2D NormalTexture;

bool UseOcclusionTexture;
Texture2D OcclusionTexture;

float RoughnessValue @Default(0.7) @Clamp(0.0, 1.0);
bool UseRoughnessTexture;
Texture2D RoughnessTexture;

float MetallicValue @Default(0.0) @Clamp(0.0, 1.0);
bool UseMetallicTexture;
Texture2D MetallicTexture;

bool UseOrmTexture;
Texture2D OrmTexture;

Color EmissiveColor @Default(Color(0.0, 0.0, 0.0));
bool UseEmissiveTexture;
Texture2D EmissiveTexture;

[MATERIAL_CONSTANTS]
#include <Shaders/Materials/DefaultMaterialConstants.h>

[RENDERSTATE]
#include <Shaders/Materials/NativeMaterialState.h>

[VERTEX_SHADER]
#define XII_SCENE_WORLD_ATTRIBUTES
#define XII_SCENE_MATERIAL_ATTRIBUTES
#define XII_SCENE_SURFACE_FLAGS
#include <Shaders/Pipeline/GpuSceneSurfaceVertex.h>
#include <Shaders/Pipeline/GpuSceneSurfaceIndexed.h>

[PIXEL_SHADER]
#include <Shaders/Materials/NativeMaterialSurface.h>
static GBufferVertex MaterialInput;

Texture2D BaseTexture;
SamplerState BaseTexture_AutoSampler;

Texture2D NormalTexture;
SamplerState NormalTexture_AutoSampler;

Texture2D MetallicTexture;
SamplerState MetallicTexture_AutoSampler;

Texture2D RoughnessTexture;
SamplerState RoughnessTexture_AutoSampler;

Texture2D EmissiveTexture;
SamplerState EmissiveTexture_AutoSampler;

Texture2D OcclusionTexture;
SamplerState OcclusionTexture_AutoSampler;

Texture2D OrmTexture;
SamplerState OrmTexture_AutoSampler;

float3 GetNormal()
{
  [branch]
  if (UseNormalTexture)
  {
    float3 normalTS = xiiMaterialDecodeNormalTexture(NormalTexture.Sample(NormalTexture_AutoSampler, MaterialInput.TexCoord));
    return xiiMaterialTangentToWorld(MaterialInput, normalTS);
  }
  else
  {
    return MaterialInput.WorldNormal;
  }
}

float3 GetBaseColor()
{
  float3 baseColor = BaseColor.rgb;

  // note that the default material actually doesn't support per-vertex colors
#if defined(USE_COLOR0)
  baseColor *= MaterialInput.Color.rgb;
#endif

  [branch]
  if (UseBaseTexture)
  {
    baseColor *= BaseTexture.Sample(BaseTexture_AutoSampler, MaterialInput.TexCoord).rgb;
  }

  return baseColor;
}

float GetMetallic()
{
  [branch]
  if (UseOrmTexture)
  {
    return OrmTexture.Sample(OrmTexture_AutoSampler, MaterialInput.TexCoord).b;
  }
  else if (UseMetallicTexture)
  {
    return MetallicTexture.Sample(MetallicTexture_AutoSampler, MaterialInput.TexCoord).r;
  }
  else
  {
    return MetallicValue;
  }
}

float GetReflectance()
{
  return 0.5f;
}

float GetRoughness()
{
  [branch]
  if (UseOrmTexture)
  {
    return RoughnessValue * OrmTexture.Sample(OrmTexture_AutoSampler, MaterialInput.TexCoord).g;
  }
  else if (UseRoughnessTexture)
  {
    return RoughnessValue * RoughnessTexture.Sample(RoughnessTexture_AutoSampler, MaterialInput.TexCoord).r;
  }
  else
  {
    return RoughnessValue;
  }
}

float GetOpacity()
{
  float opacity = BaseColor.a * MaterialInput.Color.a;

  [branch]
  if (UseBaseTexture)
  {
    opacity *= BaseTexture.Sample(BaseTexture_AutoSampler, MaterialInput.TexCoord).a;
  }

  #if BLEND_MODE == BLEND_MODE_MASKED
    return opacity - MaskThreshold;
  #else
    return opacity;
  #endif
}

float3 GetEmissiveColor()
{
  [branch]
  if (UseEmissiveTexture)
  {
    return EmissiveTexture.Sample(EmissiveTexture_AutoSampler, MaterialInput.TexCoord).rgb * EmissiveColor.rgb;
  }
  else
  {
    return EmissiveColor.rgb;
  }
}

float GetOcclusion()
{
  [branch]
  if (UseOrmTexture)
  {
    return OrmTexture.Sample(OrmTexture_AutoSampler, MaterialInput.TexCoord).r;
  }
  else if (UseOcclusionTexture)
  {
    return OcclusionTexture.Sample(OcclusionTexture_AutoSampler, MaterialInput.TexCoord).r;
  }
  else
  {
    return 1.0f;
  }
}

xiiMaterialSurfaceOutput main(GBufferVertex input, bool frontFace : SV_IsFrontFace)
{
  MaterialInput = input;
#if TWO_SIDED != TRUE
  if (!frontFace) discard;
#endif
#if BLEND_MODE == BLEND_MODE_MASKED
  clip(GetOpacity());
#endif
  xiiMaterialSurface surface;
  surface.BaseColor = float4(GetBaseColor(), GetOpacity());
  surface.AlphaCutoff = 0;
  surface.Normal = GetNormal() * (frontFace ? 1 : -1);
  surface.Roughness = GetRoughness();
  surface.Metallic = GetMetallic();
  surface.Reflectance = GetReflectance();
  surface.Occlusion = GetOcclusion();
  surface.Emissive = GetEmissiveColor();
  surface.Transmission = 0;
  surface.Unlit = SHADING_MODE == SHADING_MODE_FULLBRIGHT;
  return xiiWriteMaterialSurface(input, surface);
}
