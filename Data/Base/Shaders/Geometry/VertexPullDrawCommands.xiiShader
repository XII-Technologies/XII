/// Copyright (c) Theophilus Eriata. All Rights Reserved.
[PLATFORMS]
ALL
[COMPUTE_SHADER]
#include <Shaders/Visibility/GpuSceneCommon.h>
StructuredBuffer<GpuSceneInstance> g_SceneInstances;
StructuredBuffer<GpuVisibilityView> g_VisibilityView;
StructuredBuffer<GpuGeometryRecord> g_Geometry;
StructuredBuffer<GpuMeshlet> g_Meshlets;
StructuredBuffer<uint2> g_VisibleMeshlets;
StructuredBuffer<uint> g_VisibleMeshletCount;
RWStructuredBuffer<uint4> g_DrawCommands;
RWStructuredBuffer<uint> g_DrawCommandCount;

[numthreads(64, 1, 1)]
void main(uint3 tid : SV_DispatchThreadID)
{
  uint capacity, stride, visibleCapacity;
  g_DrawCommands.GetDimensions(capacity, stride);
  g_VisibleMeshlets.GetDimensions(visibleCapacity, stride);
  uint count = min(g_VisibleMeshletCount[0], min(capacity, visibleCapacity));
  if (tid.x == 0u) g_DrawCommandCount[0] = count;
  if (tid.x >= capacity) return;
  // All slots are deterministic, including unused tails and invalid candidates.
  g_DrawCommands[tid.x] = 0u;
  if (tid.x >= count) return;
  uint sceneCount, geometryCount, meshletCount;
  g_SceneInstances.GetDimensions(sceneCount, stride);
  g_Geometry.GetDimensions(geometryCount, stride);
  g_Meshlets.GetDimensions(meshletCount, stride);
  uint2 visible = g_VisibleMeshlets[tid.x];
  if (visible.x >= sceneCount || visible.y >= meshletCount) return;
  GpuSceneInstance instance = g_SceneInstances[visible.x];
  uint base = g_VisibilityView[0].GeometryBaseIndex;
  if (base >= geometryCount || instance.GeometryIndex >= geometryCount - base) return;
  GpuGeometryRecord geometry = g_Geometry[base + instance.GeometryIndex];
  GpuMeshlet meshlet = g_Meshlets[visible.y];
  uint lodIndex = meshlet.PackedLodSection & 0xFFFFu;
  if (lodIndex >= min(geometry.LodCount, 8u) || (geometry.ResidentLodMask & (1u << lodIndex)) == 0u ||
      (instance.DrawLod != 0xFFFFFFFFu && instance.DrawLod != lodIndex)) return;
  GpuGeometryLod lod = geometry.Lods[lodIndex];
  if (lod.VertexBufferIndex == 0xFFFFFFFFu || lod.MeshletRemapBufferIndex == 0xFFFFFFFFu || lod.MeshletPrimitiveBufferIndex == 0xFFFFFFFFu ||
      visible.y < lod.MeshletMetadataOffset || visible.y - lod.MeshletMetadataOffset >= lod.MeshletCount) return;
  uint primitives = meshlet.PackedPrimitiveVertexCount & 0xFFFFu;
  uint total = lod.IndexCount / 3u;
  if (meshlet.Header.x > total || primitives > total - meshlet.Header.x || (meshlet.PackedPrimitiveVertexCount >> 16u) == 0u) return;
  uint begin = meshlet.Header.x, end = begin + primitives;
  if (instance.PrimitiveCount != 0u)
  {
    if (instance.FirstPrimitive > total || instance.PrimitiveCount > total - instance.FirstPrimitive) return;
    begin = max(begin, instance.FirstPrimitive);
    end = min(end, instance.FirstPrimitive + instance.PrimitiveCount);
  }
  if (begin < end)
    g_DrawCommands[tid.x] = uint4((end - begin) * 3u, 1u, (begin - meshlet.Header.x) * 3u, tid.x);
}
