[PLATFORMS]
ALL

[RENDERSTATE]
DepthEnable = true
DepthWriteEnable = false
ComparisonDepthFunction = ComparisonFunction_GreaterEqual
CullMode = CullMode_None

[SHADER]
#include <Shaders/Pipeline/GpuSceneSurfaceVertex.h>

[MESH_SHADER]
#include <Shaders/Pipeline/GpuSceneSurfaceMesh.h>

[PIXEL_SHADER]
#include <Shaders/Geometry/GBufferPixel.h>
