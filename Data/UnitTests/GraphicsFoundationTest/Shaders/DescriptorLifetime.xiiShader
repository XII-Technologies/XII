[PLATFORMS]
ALL

[COMPUTE_SHADER]
Texture2D<float4> Inputs[2] : register(t0);
RWTexture2D<float4> Outputs[2] : register(u0);

[numthreads(1, 1, 1)]
void main(uint3 id : SV_DispatchThreadID)
{
  Outputs[0][id.xy] = Inputs[0].Load(int3(id.xy, 0));
  Outputs[1][id.xy] = Inputs[1].Load(int3(id.xy, 0));
}
