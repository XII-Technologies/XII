[TEMPLATE_VARIABLES]
enum TEMPLATE_BLEND_MODE { TEMPLATE_BLEND_MODE_OPAQUE, TEMPLATE_BLEND_MODE_SELECTABLE };
enum TEMPLATE_TWO_SIDED { TEMPLATE_TWO_SIDED_OFF, TEMPLATE_TWO_SIDED_ON, TEMPLATE_TWO_SIDED_SELECTABLE };
enum TEMPLATE_VERTEX_COLORS { TEMPLATE_VERTEX_COLORS_NONE, TEMPLATE_VERTEX_COLORS_0 };

[PLATFORMS]
ALL
[PERMUTATIONS]
%if TEMPLATE_BLEND_MODE == TEMPLATE_BLEND_MODE_OPAQUE
BLEND_MODE = BLEND_MODE_OPAQUE
%else
BLEND_MODE
%endif
%if TEMPLATE_TWO_SIDED == TEMPLATE_TWO_SIDED_OFF
TWO_SIDED = FALSE
%elif TEMPLATE_TWO_SIDED == TEMPLATE_TWO_SIDED_ON
TWO_SIDED = TRUE
%else
TWO_SIDED
%endif
SHADING_MODE = SHADING_MODE_FULLBRIGHT
// The renderer selects these existing pass and lighting permutations.
RENDER_PASS
FORWARD_DIRECTIONAL_SHADOWS
FORWARD_ATMOSPHERE
FORWARD_REFRACTION
FORWARD_SPOT_SHADOWS
[MATERIAL_PARAMETER]
%if TEMPLATE_BLEND_MODE == TEMPLATE_BLEND_MODE_SELECTABLE
Permutation BLEND_MODE;
%endif
%if TEMPLATE_TWO_SIDED == TEMPLATE_TWO_SIDED_SELECTABLE
Permutation TWO_SIDED;
%endif
Color BaseColor @Default(Color(1, 1, 1));
Color EmissiveColor @Default(Color(0, 0, 0));
float MaskThreshold @Default(0.25) @Clamp(0.0, 1.0);
bool UseBaseTexture;
Texture2D BaseTexture;
[MATERIAL_CONSTANTS]
// The standard compiler declares and reflects xiiMaterialConstants.
COLOR4F(BaseColor);
COLOR4F(EmissiveColor);
FLOAT1(MaskThreshold);
BOOL1(UseBaseTexture);
[RENDERSTATE]
#include <Shaders/Materials/NativeMaterialState.h>
[VERTEX_SHADER]
#define XII_SCENE_WORLD_ATTRIBUTES
#define XII_SCENE_MATERIAL_ATTRIBUTES
#define XII_SCENE_SURFACE_FLAGS
#include <Shaders/Pipeline/GpuSceneSurfaceVertex.h>
#define XII_SCENE_CUSTOM_VERTEX_ENTRY
#include <Shaders/Pipeline/GpuSceneSurfaceIndexed.h>
GBufferVertex main(uint vertexIndex : SV_VertexID, uint visibleIndex : SV_InstanceID)
{
  GBufferVertex vertex = xiiLoadIndexedSceneSurfaceVertex(vertexIndex, visibleIndex);
  // Animate native positions here. Update previous clip position consistently
  // and provide conservative mesh bounds for any displacement.
  return vertex;
}
[PIXEL_SHADER]
#include <Shaders/Materials/NativeMaterialSurface.h>
Texture2D BaseTexture;
SamplerState BaseTexture_AutoSampler;
xiiMaterialSurfaceOutput main(GBufferVertex input, bool frontFace : SV_IsFrontFace)
{
  xiiMaterialSurface surface = xiiDefaultMaterialSurface(input, frontFace);
  surface.BaseColor = BaseColor;
%if TEMPLATE_VERTEX_COLORS == TEMPLATE_VERTEX_COLORS_0
  surface.BaseColor *= input.Color;
%endif
  if (UseBaseTexture) surface.BaseColor *= BaseTexture.Sample(BaseTexture_AutoSampler, input.TexCoord);
  surface.AlphaCutoff = MaskThreshold;
  surface.Emissive = EmissiveColor.rgb;
  surface.Unlit = true;
  return xiiWriteMaterialSurface(input, surface);
}
