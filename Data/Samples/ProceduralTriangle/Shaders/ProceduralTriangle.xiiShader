[PLATFORMS]
ALL

[RENDERSTATE]

DepthEnable = false
CullMode    = CullMode_None

[VERTEX_SHADER]

#include "ProceduralTriangleConstants.h"

struct VSOut
{
  float4 Position : SV_POSITION;
  float3 Color    : COLOR0;
  float3 Bary     : TEXCOORD0;
  float3 Normal   : TEXCOORD1;
  float2 ScreenUV : TEXCOORD2;
};

// triangle defined in normalized screen-space extents (-0.5..0.5)
static const float3 gPositions[3] =
{
  float3(-0.5, -0.5, 0.0),
  float3( 0.0,  0.5, 0.0),
  float3( 0.5, -0.5, 0.0)
};

static const float3 gColors[3] =
{
  float3(1.0, 0.2, 0.15),
  float3(0.15, 1.0, 0.2),
  float3(0.2, 0.3, 1.0)
};

static const float3 gBary[3] =
{
  float3(1,0,0),
  float3(0,1,0),
  float3(0,0,1)
};

void main(in uint uiVertexID : SV_VertexID, out VSOut OUT)
{
  // Positions are provided in a -0.5..0.5 local screen-space range.
  // Expand to clip space (-1..1) while preserving aspect ratio so the triangle
  // covers the same relative area regardless of window size.
  float2 pos = gPositions[uiVertexID].xy;

  // preserve aspect: scale X by aspect so triangle doesn't squash on non-square windows
  float aspect = vResolution.x > 0.0 ? (vResolution.x / vResolution.y) : 1.0;
  float2 clipPos = float2(pos.x * aspect * 2.0, pos.y * 2.0); // *2 to map -0.5..0.5 -> -1..1

  OUT.Position = float4(clipPos, 0.0, 1.0);
  OUT.Color    = gColors[uiVertexID];
  OUT.Bary     = gBary[uiVertexID];

  // flat normal (not used for world lighting in screen-space mode, but kept for compatibility)
  float3 p0 = gPositions[0];
  float3 p1 = gPositions[1];
  float3 p2 = gPositions[2];
  OUT.Normal = normalize(cross(p1 - p0, p2 - p0));

  // ScreenUV in 0..1 for screen-space effects
  float2 ndc = OUT.Position.xy / OUT.Position.w;
  OUT.ScreenUV = ndc * 0.5 + 0.5;
}

[PIXEL_SHADER]

#include "ProceduralTriangleConstants.h"

struct PSIn
{
  float4 Position : SV_POSITION;
  float3 Color    : COLOR0;
  float3 Bary     : TEXCOORD0;
  float3 Normal   : TEXCOORD1;
  float2 ScreenUV : TEXCOORD2;
};

// cheap hash / value noise for subtle grain
float hash21(float2 p)
{
  p  = frac(p * float2(123.34, 456.21));
  p += dot(p, p + 45.32);
  return frac(p.x * p.y);
}

float noise(float2 uv)
{
  float2 i = floor(uv);
  float2 f = frac(uv);
  float a  = hash21(i);
  float b  = hash21(i + float2(1,0));
  float c  = hash21(i + float2(0,1));
  float d  = hash21(i + float2(1,1));
  float2 u = f * f * (3.0 - 2.0 * f);
  return lerp(lerp(a,b,u.x), lerp(c,d,u.x), u.y);
}

float4 main(PSIn IN) : SV_TARGET
{
  // base color from barycentric interpolation of vertex palette
  float3 c0 = float3(1.0, 0.25, 0.15);
  float3 c1 = float3(0.15, 1.0, 0.25);
  float3 c2 = float3(0.25, 0.35, 1.0);
  float3 baseColor = IN.Bary.x * c0 + IN.Bary.y * c1 + IN.Bary.z * c2;

  // animated pulse (screen-space)
  float pulse = 0.6 + 0.4 * sin(fTime * 2.0 + dot(IN.ScreenUV, float2(12.0, 7.0)));
  baseColor *= pulse;

  // screen-space rim / vignette (gives a soft highlight toward center)
  float2 center = float2(0.5, 0.5);
  float2 d = IN.ScreenUV - center;
  float rim = pow(1.0 - saturate(length(d) * 1.6), 2.0);
  float3 rimCol = float3(1.0, 0.9, 0.7) * rim * 0.35;

  // soft silhouette via barycentric distance to nearest edge
  float minB = min(min(IN.Bary.x, IN.Bary.y), IN.Bary.z);

  // approximate pixel scale for edge width using derivatives
  float px = length(ddx(IN.Position.xy)) + length(ddy(IN.Position.xy));
  float edgePx = max(1.0, fWireWidth) * 0.5 * px;
  float edgeFade = smoothstep(0.0, edgePx * 0.9, minB);

  // wire overlay: thin dark lines near edges
  float wire = smoothstep(0.0, edgePx * 0.6, minB);
  float wireLine = 1.0 - wire;
  float3 wireColor = float3(0.06, 0.06, 0.06);

  // subtle procedural grain (screen-space, resolution-aware)
  float n = noise(IN.ScreenUV * vResolution * 0.25 + fTime * 0.7);
  float grain = (n - 0.5) * 0.02;

  // combine components
  float3 col = baseColor + rimCol;
  col = lerp(wireColor, col, saturate(edgeFade));
  col += grain;

  // simple tonemap and gamma
  col = col / (col + 1.0);
  col = pow(col, 1.0 / 2.2);

  return float4(col, 1.0);
}
