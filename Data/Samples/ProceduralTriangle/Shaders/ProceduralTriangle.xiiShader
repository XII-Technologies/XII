[PLATFORMS]
ALL

[RENDERSTATE]

DepthEnable = false
CullMode    = CullMode_None

[VERTEX_SHADER]

#include "ProceduralTriangleConstants.h"

struct VSOut
{
  float4 Position : SV_POSITION;
  float3 Color    : COLOR0;
  float3 Bary     : TEXCOORD0;
  float3 Normal   : TEXCOORD1;
  float2 ScreenUV : TEXCOORD2;
};

// triangle defined in normalized screen-space extents (-0.5..0.5)
static const float3 gPositions[3] =
{
  float3(-0.5, -0.5, 0.0),
  float3( 0.0,  0.5, 0.0),
  float3( 0.5, -0.5, 0.0)
};

static const float3 gColors[3] =
{
  float3(1.0, 0.2, 0.15),
  float3(0.15, 1.0, 0.2),
  float3(0.2, 0.3, 1.0)
};

static const float3 gBary[3] =
{
  float3(1,0,0),
  float3(0,1,0),
  float3(0,0,1)
};

void main(in uint uiVertexID : SV_VertexID, out VSOut OUT)
{
  // Local positions in -0.5..0.5 range
  float2 pos = gPositions[uiVertexID].xy;

  // Inverse-aspect correction so the triangle preserves shape across window sizes.
  // Use height/width to scale X down on wide windows (prevents the triangle from overflowing).
  float aspectInv = (vResolution.x > 0.0) ? (vResolution.y / vResolution.x) : 1.0;
  float2 clipPos = float2(pos.x * 2.0 * aspectInv, pos.y * 2.0); // map -0.5..0.5 -> -1..1

  OUT.Position = float4(clipPos, 0.0, 1.0);
  OUT.Color    = gColors[uiVertexID];
  OUT.Bary     = gBary[uiVertexID];

  // flat normal (kept for compatibility with existing PS)
  float3 p0 = gPositions[0];
  float3 p1 = gPositions[1];
  float3 p2 = gPositions[2];
  OUT.Normal = normalize(cross(p1 - p0, p2 - p0));

  // ScreenUV in 0..1 for screen-space effects
  float2 ndc = OUT.Position.xy / OUT.Position.w;
  OUT.ScreenUV = ndc * 0.5 + 0.5;
}

[PIXEL_SHADER]

#include "ProceduralTriangleConstants.h"

struct PSIn
{
  float4 Position : SV_POSITION;
  float3 Color    : COLOR0;
  float3 Bary     : TEXCOORD0;
  float3 Normal   : TEXCOORD1;
  float2 ScreenUV : TEXCOORD2;
};

// cheap hash / value noise for subtle grain
float hash21(float2 p)
{
  p  = frac(p * float2(123.34, 456.21));
  p += dot(p, p + 45.32);
  return frac(p.x * p.y);
}

float noise(float2 uv)
{
  float2 i = floor(uv);
  float2 f = frac(uv);
  float a  = hash21(i);
  float b  = hash21(i + float2(1,0));
  float c  = hash21(i + float2(0,1));
  float d  = hash21(i + float2(1,1));
  float2 u = f * f * (3.0 - 2.0 * f);
  return lerp(lerp(a,b,u.x), lerp(c,d,u.x), u.y);
}

// Neon: high saturation, additive highlights, punchy rim
float4 main(PSIn IN) : SV_TARGET
{
  float3 c0 = float3(1.0, 0.15, 0.05);
  float3 c1 = float3(0.05, 1.0, 0.15);
  float3 c2 = float3(0.15, 0.25, 1.0);
  float3 baseColor = IN.Bary.x * c0 + IN.Bary.y * c1 + IN.Bary.z * c2;

  float pulse = 0.5 + 0.5 * sin(fTime * 3.0 + IN.ScreenUV.x * 8.0);
  baseColor *= pulse * 1.5;

  float2 d = IN.ScreenUV - 0.5;
  float rim = pow(1.0 - saturate(length(d) * 1.2), 2.0);
  float3 rimCol = float3(1.0, 0.8, 0.6) * rim * 1.0;

  float minB = min(min(IN.Bary.x, IN.Bary.y), IN.Bary.z);
  float px = length(ddx(IN.Position.xy)) + length(ddy(IN.Position.xy));
  float edgePx = max(1.0, fWireWidth) * 0.5 * px;
  float edgeFade = smoothstep(0.0, edgePx * 0.9, minB);

  float n = noise(IN.ScreenUV * vResolution * 0.5 + fTime * 1.2);
  float grain = (n - 0.5) * 0.04;

  float3 col = baseColor + rimCol;
  col = lerp(float3(0.02,0.02,0.02), col, saturate(edgeFade));
  col += grain;

  // additive highlight boost to simulate bloom
  col += pow(max(col - 0.6, 0.0), float3(1.6,1.6,1.6)) * 0.9;

  // clamp then gamma
  col = saturate(col);
  col = pow(col, 1.0 / 2.2);

  return float4(col, 1.0);
}
