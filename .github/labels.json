  {
    "name": "Review: Perf Assessment",
    "color": "f44336",
    "description": "Requires profiling or benchmarks."
  },
  {
    "name": "Review: API Compatibility",
    "color": "00acc1",
    "description": "Public-facing API must maintain stability."
  },
  {
    "name": "Review: Design Input",
