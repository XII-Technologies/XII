  "configurations": [
    {
      "name": "Android-arm-Debug",
      "generator": "Ninja",
      "configurationType": "Debug",
      "inheritEnvironments": [ "vsdev" ],
      "buildRoot": "${workspaceRoot}\\build\\${name}",
      "installRoot": "${workspaceRoot}\\install\\${name}",
      "variables": [
        {
          "name": "CMAKE_TOOLCHAIN_FILE",
          "value": "${env.ANDROID_NDK_HOME}\\build\\cmake\\android.toolchain.cmake",
          "type": "FILEPATH"
        },
        {
          "name": "ANDROID_PLATFORM",
          "value": "${env.ANDROID_API_VERSION}",
          "type": "STRING"
        },
        {
          "name": "XII_ENABLE_QT_SUPPORT",
          "value": "0",
          "type": "STRING"
        },
        {
          "name": "XII_BUILD_SAMPLES",
          "value": "1",
          "type": "STRING"
        }
      ],
      "buildCommandArgs": "-v",
      "ctestCommandArgs": "",
      "intelliSenseMode": "android-clang-arm"
