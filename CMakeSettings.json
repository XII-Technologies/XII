{
  "environments": [
    {
      "ANDROID_NDK_HOME": "PATH_TO_ANDROID_NDK_HOME_HERE",
      "ANDROID_HOME": "PATH_TO_ANDROID_HOME_HERE",
      "JAVA_HOME": "PATH_TO_JAVA_HOME_HERE"
      "ANDROID_API_VERSION": "33"
    }
